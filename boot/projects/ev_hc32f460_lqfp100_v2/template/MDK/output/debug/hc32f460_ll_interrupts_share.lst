N/* RAM functions are defined using the toolchain options.
NFunctions that are executed in RAM should reside in a separate source module.
NUsing the 'Options for File' dialog you can simply change the 'Code / Const'
Narea of a module to a memory space in physical RAM. */
N#ifndef __RAM_FUNC
N#define __RAM_FUNC                  __attribute__((section("RAMCODE")))
N#endif /* __RAM_FUNC */
N/* Suppress warning message: extended constant initializer used */
N#pragma diag_suppress 1296
N#else
S#error  "unsupported compiler!!"
N#endif
N/**
N * @}
N */
N
N/**
N * @defgroup Extend_Macros Extend Macros
N * @{
N */
N/* Decimal to BCD */
N#define DEC2BCD(x)                      ((((x) / 10U) << 4U) + ((x) % 10U))
N
N/* BCD to decimal */
N#define BCD2DEC(x)                      ((((x) >> 4U) * 10U) + ((x) & 0x0FU))
N
N/* Returns the dimension of an array */
N#define ARRAY_SZ(x)                     ((sizeof(x)) / (sizeof((x)[0])))
N
N/* Returns the minimum value out of two values */
N#define LL_MIN(x, y)                    ((x) < (y) ? (x) : (y))
N
N/* Returns the maximum value out of two values */
N#define LL_MAX(x, y)                    ((x) > (y) ? (x) : (y))
N/**
N * @}
N */
N
N/**
N * @defgroup Check_Parameters_Validity Check Parameters Validity
N * @{
N */
N
N/* Check Functional State */
N#define IS_FUNCTIONAL_STATE(state)      (((state) == DISABLE) || ((state) == ENABLE))
N
N/**
N * @defgroup Check_Address_Align_Validity Check Address Align Validity
N * @{
N */
N#define IS_ADDR_ALIGN(addr, align)      (0UL == (((uint32_t)(addr)) & (((uint32_t)(align)) - 1UL)))
N#define IS_ADDR_ALIGN_HALFWORD(addr)    (0UL == (((uint32_t)(addr)) & 0x1UL))
N#define IS_ADDR_ALIGN_WORD(addr)        (0UL == (((uint32_t)(addr)) & 0x3UL))
N/**
N * @}
N */
N
N/**
N * @}
N */
N
N/**
N * @defgroup Peripheral_Bit_Band Peripheral Bit Band
N * @{
N */
N#define __PERIPH_BIT_BAND_BASE          (0x42000000UL)
N#define __PERIPH_BASE                   (0x40000000UL)
N#define __REG_OFS(regAddr)              ((regAddr) - __PERIPH_BASE)
N#define __BIT_BAND_ADDR(regAddr, pos)   ((__REG_OFS(regAddr) << 5U) + ((uint32_t)(pos) << 2U) + __PERIPH_BIT_BAND_BASE)
N#define PERIPH_BIT_BAND(regAddr, pos)   (*(__IO uint32_t *)__BIT_BAND_ADDR((regAddr), (pos)))
N/**
N * @}
N */
N
N/**
N * @defgroup Generic_Error_Codes Generic Error Codes
N * @{
N */
N#define LL_OK                           (0)   /*!< No error */
N#define LL_ERR                          (-1)  /*!< Non-specific error code */
N#define LL_ERR_UNINIT                   (-2)  /*!< Module (or part of it) was not initialized properly */
N#define LL_ERR_INVD_PARAM               (-3)  /*!< Provided parameter is not valid */
N#define LL_ERR_INVD_MD                  (-4)  /*!< Operation not allowed in current mode */
N#define LL_ERR_NOT_RDY                  (-5)  /*!< A requested final state is not reached */
N#define LL_ERR_BUSY                     (-6)  /*!< A conflicting or requested operation is still in progress */
N#define LL_ERR_ADDR_ALIGN               (-7)  /*!< Address alignment does not match */
N#define LL_ERR_TIMEOUT                  (-8)  /*!< Time Out error occurred (e.g. I2C arbitration lost, Flash time-out, etc.) */
N#define LL_ERR_BUF_EMPTY                (-9)  /*!< Circular buffer can not be read because the buffer is empty */
N#define LL_ERR_BUF_FULL                 (-10) /*!< Circular buffer can not be written because the buffer is full */
N/**
N * @}
N */
N
N/**
N * @defgroup Chip_Module_Switch Chip Module Switch
N * @{
N */
N#define DDL_ON                          (1U)
N#define DDL_OFF                         (0U)
N/**
N * @}
N */
N
N/**
N * @defgroup Bit_Mask_Macros Bit Mask Macros
N * @{
N */
N#define BIT_MASK_00                     (1UL << 0U)
N#define BIT_MASK_01                     (1UL << 1U)
N#define BIT_MASK_02                     (1UL << 2U)
N#define BIT_MASK_03                     (1UL << 3U)
N#define BIT_MASK_04                     (1UL << 4U)
N#define BIT_MASK_05                     (1UL << 5U)
N#define BIT_MASK_06                     (1UL << 6U)
N#define BIT_MASK_07                     (1UL << 7U)
N#define BIT_MASK_08                     (1UL << 8U)
N#define BIT_MASK_09                     (1UL << 9U)
N#define BIT_MASK_10                     (1UL << 10U)
N#define BIT_MASK_11                     (1UL << 11U)
N#define BIT_MASK_12                     (1UL << 12U)
N#define BIT_MASK_13                     (1UL << 13U)
N#define BIT_MASK_14                     (1UL << 14U)
N#define BIT_MASK_15                     (1UL << 15U)
N#define BIT_MASK_16                     (1UL << 16U)
N#define BIT_MASK_17                     (1UL << 17U)
N#define BIT_MASK_18                     (1UL << 18U)
N#define BIT_MASK_19                     (1UL << 19U)
N#define BIT_MASK_20                     (1UL << 20U)
N#define BIT_MASK_21                     (1UL << 21U)
N#define BIT_MASK_22                     (1UL << 22U)
N#define BIT_MASK_23                     (1UL << 23U)
N#define BIT_MASK_24                     (1UL << 24U)
N#define BIT_MASK_25                     (1UL << 25U)
N#define BIT_MASK_26                     (1UL << 26U)
N#define BIT_MASK_27                     (1UL << 27U)
N#define BIT_MASK_28                     (1UL << 28U)
N#define BIT_MASK_29                     (1UL << 29U)
N#define BIT_MASK_30                     (1UL << 30U)
N#define BIT_MASK_31                     (1UL << 31U)
N/**
N * @}
N */
N
N/**
N * @defgroup Register_Macros Register Macros
N * @{
N */
N#define RW_MEM8(addr)                   (*(volatile uint8_t *)(addr))
N#define RW_MEM16(addr)                  (*(volatile uint16_t *)(addr))
N#define RW_MEM32(addr)                  (*(volatile uint32_t *)(addr))
N
N#define SET_REG_BIT(REG, BIT)           ((REG) |= (BIT))
N#define SET_REG8_BIT(REG, BIT)          ((REG) |= ((uint8_t)(BIT)))
N#define SET_REG16_BIT(REG, BIT)         ((REG) |= ((uint16_t)(BIT)))
N#define SET_REG32_BIT(REG, BIT)         ((REG) |= ((uint32_t)(BIT)))
N
N#define CLR_REG_BIT(REG, BIT)           ((REG) &= (~(BIT)))
N#define CLR_REG8_BIT(REG, BIT)          ((REG) &= ((uint8_t)(~((uint8_t)(BIT)))))
N#define CLR_REG16_BIT(REG, BIT)         ((REG) &= ((uint16_t)(~((uint16_t)(BIT)))))
N#define CLR_REG32_BIT(REG, BIT)         ((REG) &= ((uint32_t)(~((uint32_t)(BIT)))))
N
N#define READ_REG_BIT(REG, BIT)          ((REG) & (BIT))
N#define READ_REG8_BIT(REG, BIT)         ((REG) & ((uint8_t)(BIT)))
N#define READ_REG16_BIT(REG, BIT)        ((REG) & ((uint16_t)(BIT)))
N#define READ_REG32_BIT(REG, BIT)        ((REG) & ((uint32_t)(BIT)))
N
N#define CLR_REG(REG)                    ((REG) = (0U))
N#define CLR_REG8(REG)                   ((REG) = ((uint8_t)(0U)))
N#define CLR_REG16(REG)                  ((REG) = ((uint16_t)(0U)))
N#define CLR_REG32(REG)                  ((REG) = ((uint32_t)(0UL)))
N
N#define WRITE_REG(REG, VAL)             ((REG) = (VAL))
N#define WRITE_REG8(REG, VAL)            ((REG) = ((uint8_t)(VAL)))
N#define WRITE_REG16(REG, VAL)           ((REG) = ((uint16_t)(VAL)))
N#define WRITE_REG32(REG, VAL)           ((REG) = ((uint32_t)(VAL)))
N
N#define READ_REG(REG)                   (REG)
N#define READ_REG8(REG)                  (REG)
N#define READ_REG16(REG)                 (REG)
N#define READ_REG32(REG)                 (REG)
N
N#define MODIFY_REG(REGS, CLRMASK, SETMASK)    (WRITE_REG((REGS), (((READ_REG(REGS)) & (~(CLRMASK))) | ((SETMASK) & (CLRMASK)))))
N#define MODIFY_REG8(REGS, CLRMASK, SETMASK)   (WRITE_REG8((REGS), (((READ_REG8((REGS))) & ((uint8_t)(~((uint8_t)(CLRMASK))))) | ((uint8_t)(SETMASK) & (uint8_t)(CLRMASK)))))
N#define MODIFY_REG16(REGS, CLRMASK, SETMASK)  (WRITE_REG16((REGS), (((READ_REG16((REGS))) & ((uint16_t)(~((uint16_t)(CLRMASK))))) | ((uint16_t)(SETMASK) & (uint16_t)(CLRMASK)))))
N#define MODIFY_REG32(REGS, CLRMASK, SETMASK)  (WRITE_REG32((REGS), (((READ_REG32((REGS))) & ((uint32_t)(~((uint32_t)(CLRMASK))))) | ((uint32_t)(SETMASK) & (uint32_t)(CLRMASK)))))
N/**
N * @}
N */
N
N/**
N * @}
N */
N
