N/**
N * @defgroup Share_Interrupts_Global_Functions Share Interrupts Global Functions
N * @{
N */
N/**
N * @brief  Share IRQ configure
N * @param  [in] enIntSrc: Peripheral interrupt source @ref en_int_src_t
N * @param  [in] enNewState: An @ref en_functional_state_t enumeration value.
N * @retval int32_t:
N *           - LL_OK: Share IRQ configure successfully
N */
Nint32_t INTC_ShareIrqCmd(en_int_src_t enIntSrc, en_functional_state_t enNewState)
N{
N    __IO uint32_t *INTC_VSSELx;
X    volatile uint32_t *INTC_VSSELx;
N
N    DDL_ASSERT(IS_FUNCTIONAL_STATE(enNewState));
X    do { (((((enNewState) == DISABLE) || ((enNewState) == ENABLE))) ? (void)0 : DDL_AssertHandler("..\\..\\..\\..\\drivers\\hc32_ll_driver\\src\\hc32f460_ll_interrupts_share.c", 84)); } while (0);
N
N    INTC_VSSELx = (__IO uint32_t *)(((uint32_t)&CM_INTC->VSSEL128) + (4U * ((uint32_t)enIntSrc / 0x20U)));
X    INTC_VSSELx = (volatile uint32_t *)(((uint32_t)&((CM_INTC_TypeDef *)(0x40051000UL))->VSSEL128) + (4U * ((uint32_t)enIntSrc / 0x20U)));
N    if (ENABLE == enNewState) {
N        SET_REG32_BIT(*INTC_VSSELx, (1UL << ((uint32_t)enIntSrc & 0x1FUL)));
X        ((*INTC_VSSELx) |= ((uint32_t)((1UL << ((uint32_t)enIntSrc & 0x1FUL)))));
N    } else {
N        CLR_REG32_BIT(*INTC_VSSELx, (1UL << ((uint32_t)enIntSrc & 0x1FUL)));
X        ((*INTC_VSSELx) &= ((uint32_t)(~((uint32_t)((1UL << ((uint32_t)enIntSrc & 0x1FUL)))))));
N    }
N    return LL_OK;
X    return (0);
N}
N
N/**
N * @brief  Interrupt No.128 share IRQ handler
N * @param  None
N * @retval None
N */
Nvoid IRQ128_Handler(void)
N{
N    const uint32_t VSSEL128 = CM_INTC->VSSEL128;
X    const uint32_t VSSEL128 = ((CM_INTC_TypeDef *)(0x40051000UL))->VSSEL128;
