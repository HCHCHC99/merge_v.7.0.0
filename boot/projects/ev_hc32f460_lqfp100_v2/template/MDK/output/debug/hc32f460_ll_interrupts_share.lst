N#define LL_FCG_ENABLE                               (DDL_ON)
N#define LL_FCM_ENABLE                               (DDL_ON)
N#define LL_GPIO_ENABLE                              (DDL_ON)
N#define LL_HASH_ENABLE                              (DDL_ON)
N#define LL_I2C_ENABLE                               (DDL_ON)
N#define LL_I2S_ENABLE                               (DDL_ON)
