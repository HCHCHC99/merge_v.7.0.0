N/**
N * @brief This is the list of modules to be used in the Device Driver Library.
N * Select the modules you need to use to DDL_ON.
N * @note LL_ICG_ENABLE must be turned on(DDL_ON) to ensure that the chip works
N * properly.
N * @note LL_UTILITY_ENABLE must be turned on(DDL_ON) if using Device Driver
N * Library.
N * @note LL_PRINT_ENABLE must be turned on(DDL_ON) if using printf function.
N */
N#define LL_ICG_ENABLE                               (DDL_ON)
N
N/* SWDT ?????SWDTAUTS=0 ???????SWDT ?????????
N * SWDTCKS=DIV1 x 65536 ???SWDTLRC 10kHz => ??? 6.5s?
N * ???? AUTS=1(???) + CLK/2048 x 65536??? SWDT ?????
X
N * ??????????? ICG_REG_CFG0_CONST ????? */
N#define ICG_REG_CFG0_CONST    (0xFFDFFF0EUL)
N#define LL_UTILITY_ENABLE                           (DDL_ON)
N#define LL_PRINT_ENABLE                             (DDL_OFF)
N
N#define LL_ADC_ENABLE                               (DDL_ON)
N#define LL_AES_ENABLE                               (DDL_ON)
