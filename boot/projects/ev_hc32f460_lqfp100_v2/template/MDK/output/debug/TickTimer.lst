N// 获取距离上次调用经过的滴答数
Nuint64_t tickTimer_GetElapsedSinceLastCall(void)
N{
N    uint64_t currentTick;
N    uint64_t elapsed;
N    
N    //__disable_irq();
N    currentTick = s_tickCount;  // 直接访问，避免函数调用
N    elapsed = currentTick - s_lastCallTick;
N    s_lastCallTick = currentTick;
N    //__enable_irq();
N    
N    return elapsed;
N}
