N// #include "stdlib.h"
N
N// 非阻塞延时器结构体
Ntypedef struct {
N    uint64_t startTick;   // 延时启动时的滴答计数（调用nbDelay_Start时记录）
N    uint64_t delayMs;     // 目标延时时间（单位：ms，通过nbDelay_Init/nbDelay_SetTime设置）
N    bool isRunning;       // 延时器运行状态：true=正在延时，false=未启动/已完成
X    _Bool isRunning;       
N} NonBlockingDelay_t;
N
N// 初始化滴答定时器
Nvoid tickTimer_Init(void);
N
N// 获取当前滴答数（毫秒）
Nuint64_t tickTimer_GetCount(void);
N
N// 阻塞式延时（单位：毫秒）
Nvoid tickTimer_DelayMs(uint64_t ms);
N
N// 中断服务函数中调用的滴答更新函数
N// 1ms 调用一次
Nvoid tickTimer_Update(void);
N
N// 非阻塞延时函数组
N
N// 初始化非阻塞延时器
Nvoid nbDelay_Init(NonBlockingDelay_t* delayObj, uint64_t delayMs);
N
N// 启动非阻塞延时
Nvoid nbDelay_Start(NonBlockingDelay_t* delayObj);
N
N
N// 检查非阻塞延时是否完成（完成后会结束延时）
Nbool nbDelay_IsComplete(NonBlockingDelay_t* delayObj);
X_Bool nbDelay_IsComplete(NonBlockingDelay_t* delayObj);
N
N// 检查非阻塞延时是否完成（完成后不会结束延时）
Nbool nbDelay_IsComplete_noclose(NonBlockingDelay_t* delayObj);
X_Bool nbDelay_IsComplete_noclose(NonBlockingDelay_t* delayObj);
N
N// 停止非阻塞延时
Nvoid nbDelay_Stop(NonBlockingDelay_t* delayObj);
N
N// 设置新的延时时间（不启动）
Nvoid nbDelay_SetTime(NonBlockingDelay_t* delayObj, uint64_t delayMs);
N
N// 获取距离上次调用经过的滴答数
Nuint64_t tickTimer_GetElapsedSinceLastCall(void);
N
Nuint64_t tickTimer_GetRawTick(void);
N
N#endif // TICKTIMER_H
