L 3 "..\..\Utils\TickTimer.c" 2
N
Nstatic volatile uint64_t s_tickCount = 0;
Nstatic uint64_t s_lastCallTick = 0;
N
N// 初始化滴答定时器
Nvoid tickTimer_Init(void)
N{
N    s_tickCount = 0;
N    s_lastCallTick = tickTimer_GetCount(); 
N}
N
N// Systick.c 中添加函数实现
Nuint64_t tickTimer_GetRawTick(void) {
N    uint64_t tick;
N    //__disable_irq();  // 关中断，避免读取时被中断修改（保证数据完整性）
N    tick = s_tickCount;
N    //__enable_irq();
N    return tick;
N}
N
N// 获取当前滴答数
Nuint64_t tickTimer_GetCount(void)
N{
N    uint64_t tick;
N    //__disable_irq();
N    tick = s_tickCount;
N    //__enable_irq();
N    return tick;
N}
N
N// 阻塞式延时
Nvoid tickTimer_DelayMs(uint64_t ms)
N{
N    uint64_t startTick = tickTimer_GetCount();
N    while ((tickTimer_GetCount() - startTick) < ms);
N}
N
N// 定时器中断中调用
N__attribute__((section(".ramfunc"))) void tickTimer_Update(void)
N{
N    s_tickCount++;
N}
N
N// 非阻塞延时函数实现
N
Nvoid nbDelay_Init(NonBlockingDelay_t* delayObj, uint64_t delayMs) {
N    // 新增：参数合法性检查（避免空指针和无效延时）
N    if (delayObj == NULL) {
X    if (delayObj == 0) {
N        return;  // 或断言：assert(delayObj != NULL);（需包含assert.h）
N    }
N
N    
N    delayObj->startTick = 0;
N    delayObj->delayMs = delayMs;
N    delayObj->isRunning = false;
X    delayObj->isRunning = 0;
N}
N
Nvoid nbDelay_Start(NonBlockingDelay_t* delayObj)
N{
N    delayObj->startTick = tickTimer_GetCount();
N    delayObj->isRunning = true;
X    delayObj->isRunning = 1;
N}
N
Nbool nbDelay_IsComplete(NonBlockingDelay_t* delayObj)
X_Bool nbDelay_IsComplete(NonBlockingDelay_t* delayObj)
N{
N    if (!delayObj->isRunning) {
N        return false;
X        return 0;
N    }
N    
N    uint64_t currentTick = tickTimer_GetCount();
N    uint64_t elapsed = currentTick - delayObj->startTick;
N    
N    if (elapsed >= delayObj->delayMs) {
N        delayObj->isRunning = false;
X        delayObj->isRunning = 0;
N        return true;
X        return 1;
N    }
N    
N    return false;
X    return 0;
N}
N
N// 新增函数：检查延时是否完成但不结束延时
Nbool nbDelay_IsComplete_noclose(NonBlockingDelay_t* delayObj)
X_Bool nbDelay_IsComplete_noclose(NonBlockingDelay_t* delayObj)
N{
N    if (!delayObj->isRunning) {
N        return false;
X        return 0;
N    }
N    
N    uint64_t currentTick = tickTimer_GetCount();
N    uint64_t elapsed = currentTick - delayObj->startTick;
N    
N    // 只检查是否完成，不修改isRunning状态
N    return (elapsed >= delayObj->delayMs);
N}
N
Nvoid nbDelay_Stop(NonBlockingDelay_t* delayObj)
N{
N    delayObj->isRunning = false;
X    delayObj->isRunning = 0;
N}
N
Nvoid nbDelay_SetTime(NonBlockingDelay_t* delayObj, uint64_t delayMs) {
N    if (delayObj == NULL) {
X    if (delayObj == 0) {
N        return;
