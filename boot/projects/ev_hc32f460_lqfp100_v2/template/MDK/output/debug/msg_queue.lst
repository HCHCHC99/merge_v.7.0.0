N    LOG_CH_MAX            // ÈÄöÈÅìÊÄªÊï∞
N} LogChannel_t;
N
N//====================================================================
N// 3. È¢úËâ≤ÂÆö‰πâÔºàANSI ËΩ¨‰πâÁ†ÅÔºåRTT Viewer ÂÆåÁæéÊîØÊåÅÔºâ
N//====================================================================
N#define COLOR_CLEAR     "\033[0m"      // Ê∏ÖÈô§È¢úËâ≤
N#define COLOR_RED       "\033[31m"
N#define COLOR_GREEN     "\033[32m"
N#define COLOR_YELLOW    "\033[33m"
N#define COLOR_BLUE      "\033[34m"
N#define COLOR_PURPLE    "\033[35m"
N#define COLOR_CYAN      "\033[36m"
N
N//====================================================================
N// 4. „ÄêÊ†∏ÂøÉÂÆè„ÄëÂ§öÈÄöÈÅì + ÂàÜÁ∫ß + È¢úËâ≤ÊâìÂç∞
N//====================================================================
N#define LOG_CH(channel, level, color, tag, fmt, ...) \
N    SEGGER_RTT_printf(channel, color "[%s] " fmt COLOR_CLEAR "\r\n", tag, ##__VA_ARGS__)
X#define LOG_CH(channel, level, color, tag, fmt, ...)     SEGGER_RTT_printf(channel, color "[%s] " fmt COLOR_CLEAR "\r\n", tag, ##__VA_ARGS__)
N
N//====================================================================
N// 5. ÁªôÊØè‰∏™ÈÄöÈÅìÂÆö‰πâÁÆÄÂåñÊó•ÂøóÂÆè
N//====================================================================
N
N// ---------------------- ÈÄöÈÅì 0Ôºö‰∏ªÁ®ãÂ∫è MAIN ----------------------
N#define MAIN_D(fmt, ...)  LOG_CH(LOG_CH_MAIN, LOG_LEVEL_DEBUG, COLOR_CYAN,   "MAIN", fmt, ##__VA_ARGS__)
N#define MAIN_I(fmt, ...)  LOG_CH(LOG_CH_MAIN, LOG_LEVEL_INFO,  COLOR_GREEN, "MAIN", fmt, ##__VA_ARGS__)
N#define MAIN_W(fmt, ...)  LOG_CH(LOG_CH_MAIN, LOG_LEVEL_WARN,  COLOR_YELLOW,"MAIN", fmt, ##__VA_ARGS__)
N#define MAIN_E(fmt, ...)  LOG_CH(LOG_CH_MAIN, LOG_LEVEL_ERROR, COLOR_RED,   "MAIN", fmt, ##__VA_ARGS__)
N
N// ---------------------- ÈÄöÈÅì 1ÔºöUSB ----------------------
N#define USB_D(fmt, ...)   LOG_CH(LOG_CH_USB, LOG_LEVEL_DEBUG, COLOR_CYAN,   "USB",  fmt, ##__VA_ARGS__)
N#define USB_I(fmt, ...)   LOG_CH(LOG_CH_USB, LOG_LEVEL_INFO,  COLOR_GREEN, "USB",  fmt, ##__VA_ARGS__)
N#define USB_W(fmt, ...)   LOG_CH(LOG_CH_USB, LOG_LEVEL_WARN,  COLOR_YELLOW,"USB",  fmt, ##__VA_ARGS__)
N#define USB_E(fmt, ...)   LOG_CH(LOG_CH_USB, LOG_LEVEL_ERROR, COLOR_RED,   "USB",  fmt, ##__VA_ARGS__)
N
N// ---------------------- ÈÄöÈÅì 2Ôºö‰º†ÊÑüÂô® SENSOR ----------------------
N#define SENSOR_D(fmt, ...) LOG_CH(LOG_CH_SENSOR, LOG_LEVEL_DEBUG,COLOR_CYAN,  "SENSOR",fmt,##__VA_ARGS__)
N#define SENSOR_I(fmt, ...) LOG_CH(LOG_CH_SENSOR, LOG_LEVEL_INFO, COLOR_GREEN,"SENSOR",fmt,##__VA_ARGS__)
N#define SENSOR_W(fmt, ...) LOG_CH(LOG_CH_SENSOR, LOG_LEVEL_WARN, COLOR_YELLOW,"SENSOR",fmt,##__VA_ARGS__)
N#define SENSOR_E(fmt, ...) LOG_CH(LOG_CH_SENSOR, LOG_LEVEL_ERROR,COLOR_RED,  "SENSOR",fmt,##__VA_ARGS__)
N
N// ---------------------- ÈÄöÈÅì 3ÔºöÁîµÊú∫ MOTOR ----------------------
N#define MOTOR_D(fmt, ...) LOG_CH(LOG_CH_MOTOR, LOG_LEVEL_DEBUG,COLOR_CYAN,  "MOTOR",fmt,##__VA_ARGS__)
N#define MOTOR_I(fmt, ...) LOG_CH(LOG_CH_MOTOR, LOG_LEVEL_INFO, COLOR_GREEN,"MOTOR",fmt,##__VA_ARGS__)
N#define MOTOR_W(fmt, ...) LOG_CH(LOG_CH_MOTOR, LOG_LEVEL_WARN, COLOR_YELLOW,"MOTOR",fmt,##__VA_ARGS__)
N#define MOTOR_E(fmt, ...) LOG_CH(LOG_CH_MOTOR, LOG_LEVEL_ERROR,COLOR_RED,  "MOTOR",fmt,##__VA_ARGS__)
N
N// ---------------------- ÈÄöÈÅì 4ÔºöÈÄö‰ø° COMM ----------------------
N#define COMM_D(fmt, ...) LOG_CH(LOG_CH_COMM, LOG_LEVEL_DEBUG,COLOR_CYAN,  "COMM",fmt,##__VA_ARGS__)
N#define COMM_I(fmt, ...) LOG_CH(LOG_CH_COMM, LOG_LEVEL_INFO, COLOR_GREEN,"COMM",fmt,##__VA_ARGS__)
N#define COMM_W(fmt, ...) LOG_CH(LOG_CH_COMM, LOG_LEVEL_WARN, COLOR_YELLOW,"COMM",fmt,##__VA_ARGS__)
N#define COMM_E(fmt, ...) LOG_CH(LOG_CH_COMM, LOG_LEVEL_ERROR,COLOR_RED,  "COMM",fmt,##__VA_ARGS__)
N
N// ---------------------- ÈÄöÈÅì 5ÔºöUI ----------------------
N#define UI_D(fmt, ...) LOG_CH(LOG_CH_UI, LOG_LEVEL_DEBUG,COLOR_CYAN,  "UI",fmt,##__VA_ARGS__)
