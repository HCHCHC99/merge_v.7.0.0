Nuint16_t MsgQueue_DeleteByType(msg_queue_t *queue, uint16_t type)
N{
N    uint16_t deleted = 0;
N    uint16_t i, new_tail;
N    msg_t temp_buffer[256];
N    
N    if (queue == NULL) return 0;
X    if (queue == 0) return 0;
N    
N    QUEUE_SEND_PRINT("Delete by type - queue='%s', type=%d", queue->name, type);
X    ((void)0);
N    
N    Lock_Lock(&queue->lock, 100, "MsgQueue_DeleteByType");
N    
N    new_tail = 0;
N    for (i = 0; i < queue->count; i++) {
N        uint16_t idx = (queue->head + i) % queue->size;
N        if (queue->buffer[idx].type != type) {
N            memcpy(&temp_buffer[new_tail++], &queue->buffer[idx], sizeof(msg_t));
N        } else {
N            deleted++;
N        }
N    }
N    
N    for (i = 0; i < new_tail; i++) {
N        memcpy(&queue->buffer[i], &temp_buffer[i], sizeof(msg_t));
N    }
N    
N    queue->head = 0;
N    queue->tail = new_tail;
N    queue->count = new_tail;
N    
N    Lock_Unlock(&queue->lock, "MsgQueue_DeleteByType");
N    
N    QUEUE_SEND_PRINT("Deleted %d messages of type %d from queue '%s', remaining=%d",
N                deleted, type, queue->name, queue->count);
X    ((void)0);
N    return deleted;
N}
N
Nbool MsgQueue_WaitNotEmpty(msg_queue_t *queue, uint32_t timeoutMs)
X_Bool MsgQueue_WaitNotEmpty(msg_queue_t *queue, uint32_t timeoutMs)
N{
N    uint64_t startTick;
N    
N    if (queue == NULL) return false;
X    if (queue == 0) return 0;
N    
N    QUEUE_RECV_PRINT("Wait not empty - queue='%s', timeout=%dms", queue->name, timeoutMs);
X    ((void)0);
N    
N    startTick = tickTimer_GetCount();
N    
N    while (MsgQueue_GetCount(queue) == 0) {
N        if (timeoutMs > 0 && (tickTimer_GetCount() - startTick) >= timeoutMs) {
