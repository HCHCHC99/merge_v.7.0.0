N/* Ëé∑Âèñ‰ºòÂÖàÁ∫ßÂ≠óÁ¨¶‰∏≤ */
Nstatic const char* GetPriorityStr(msg_prio_t priority)
N{
N    switch(priority) {
N        case MSG_PRIO_URGENT: return "URGENT";
N        case MSG_PRIO_HIGH:   return "HIGH";
N        case MSG_PRIO_NORMAL: return "NORMAL";
N        case MSG_PRIO_LOW:    return "LOW";
N        default:              return "UNKNOWN";
N    }
N}
N
Nvoid MsgQueue_Init(msg_queue_t *queue, msg_t *buffer, uint16_t size, queue_config_t *config, const char *name)
N{
N    if (queue == NULL || buffer == NULL) return;
X    if (queue == 0 || buffer == 0) return;
N    
N    queue->buffer = buffer;
N    queue->size = size;
N    queue->head = 0;
N    queue->tail = 0;
N    queue->count = 0;
N    
N    if (name != NULL && strlen(name) < sizeof(queue->name)) {
X    if (name != 0 && strlen(name) < sizeof(queue->name)) {
N        strcpy((char*)queue->name, name);
N    } else {
N        strcpy((char*)queue->name, "unknown");
N    }
N    
N    if (config != NULL) {
X    if (config != 0) {
N        queue->config = *config;
N    } else {
N        queue->config.max_size = size;
N        queue->config.overwrite = false;
X        queue->config.overwrite = 0;
N        queue->config.priority_enabled = false;
X        queue->config.priority_enabled = 0;
N        queue->config.timeout_ms = 0;
N    }
N    
N    memset(&queue->stats, 0, sizeof(queue_stats_t));
N    Lock_Init(&queue->lock, LOCK_TYPE_MUTEX, queue->name);
N    
N    QUEUE_INIT_PRINT("Queue '%s' initialized, size=%d, overwrite=%d, priority=%d",
N                queue->name, size, queue->config.overwrite, queue->config.priority_enabled);
X    ((void)0);
N}
N
N/* ÂÜÖÈÉ®ÂÖ•ÈòüÂáΩÊï∞ */
Nstatic bool EnqueueInternal(msg_queue_t *queue, msg_t *msg)
Xstatic _Bool EnqueueInternal(msg_queue_t *queue, msg_t *msg)
N{
N    uint16_t pos;
N    
N    if (queue->count >= queue->size) {
N        queue->stats.overflow_count++;
N        
N        QUEUE_SEND_PRINT("Queue '%s' FULL! count=%d/%d, overflow_count=%d",
N                    queue->name, queue->count, queue->size, queue->stats.overflow_count);
X        ((void)0);
N        
N        if (!queue->config.overwrite) {
N            QUEUE_SEND_PRINT("Queue '%s' DROPPED message (overwrite disabled)", queue->name);
X            ((void)0);
N            return false;
X            return 0;
N        }
N        
N        QUEUE_SEND_PRINT("Queue '%s' OVERWRITE oldest message", queue->name);
X        ((void)0);
N        queue->head = (queue->head + 1) % queue->size;
N        queue->count--;
N    }
N    
N    /* ÊâæÂà∞ÊèíÂÖ•‰ΩçÁΩÆÔºà‰ºòÂÖàÁ∫ßÊ®°ÂºèÔºâ */
N    if (queue->config.priority_enabled && queue->count > 0) {
N        uint16_t i;
N        bool inserted = false;
X        _Bool inserted = 0;
N        
N        for (i = 0; i < queue->count; i++) {
N            pos = (queue->tail - 1 - i + queue->size) % queue->size;
N            if (queue->buffer[pos].priority <= msg->priority) {
N                memmove(&queue->buffer[(pos + 2) % queue->size], 
N                       &queue->buffer[(pos + 1) % queue->size],
N                       (queue->count - i) * sizeof(msg_t));
N                queue->tail = (queue->tail + 1) % queue->size;
N                pos = (pos + 1) % queue->size;
N                inserted = true;
X                inserted = 1;
N                QUEUE_SEND_PRINT("Queue '%s' priority insert at pos=%d", queue->name, pos);
X                ((void)0);
N                break;
N            }
N        }
N        
N        if (!inserted) {
N            pos = queue->tail;
N            queue->tail = (queue->tail + 1) % queue->size;
N        }
N    } else {
N        pos = queue->tail;
N        queue->tail = (queue->tail + 1) % queue->size;
N    }
N    
N    memcpy(&queue->buffer[pos], msg, sizeof(msg_t));
N    queue->buffer[pos].timestamp = tickTimer_GetCount();
N    queue->count++;
N    
N    QUEUE_SEND_PRINT("Queue '%s' ENQUEUE - pos=%d, type=%d, len=%d, prio=%s, count=%d/%d",
N                queue->name, pos, msg->type, msg->len, 
N                GetPriorityStr(msg->priority), queue->count, queue->size);
X    ((void)0);
N    
N    return true;
X    return 1;
N}
N
Nbool MsgQueue_Send(msg_queue_t *queue, msg_t *msg, bool blocking, const char *caller)
X_Bool MsgQueue_Send(msg_queue_t *queue, msg_t *msg, _Bool blocking, const char *caller)
N{
N    uint64_t startTick = 0;
N    bool result = false;
X    _Bool result = 0;
N    
N    if (queue == NULL || msg == NULL) {
X    if (queue == 0 || msg == 0) {
N        QUEUE_SEND_PRINT("Send failed - queue or msg is NULL (caller='%s')", caller ? caller : "unknown");
X        ((void)0);
N        return false;
X        return 0;
N    }
N    
N    QUEUE_SEND_PRINT("Send request - queue='%s', caller='%s', type=%d, len=%d, prio=%s, blocking=%d",
N                queue->name, caller ? caller : "unknown", msg->type, msg->len, 
N                GetPriorityStr(msg->priority), blocking);
X    ((void)0);
N    
N    if (blocking) {
N        startTick = tickTimer_GetCount();
N    }
N    
N    while (1) {
N        Lock_Lock(&queue->lock, 100, "MsgQueue_Send");
N        
N        result = EnqueueInternal(queue, msg);
N        
N        Lock_Unlock(&queue->lock, "MsgQueue_Send");
N        
N        if (result) {
N            queue->stats.total_enqueued++;
N            if (queue->count > queue->stats.max_usage) {
N                queue->stats.max_usage = queue->count;
N                QUEUE_SEND_PRINT("Queue '%s' new max usage=%d", queue->name, queue->stats.max_usage);
X                ((void)0);
N            }
N            QUEUE_SEND_PRINT("Send SUCCESS - queue='%s', caller='%s', total_enqueued=%d",
N                        queue->name, caller ? caller : "unknown", queue->stats.total_enqueued);
X            ((void)0);
N            return true;
X            return 1;
N        }
N        
N        if (!blocking) {
N            queue->stats.total_dropped++;
N            QUEUE_SEND_PRINT("Send FAILED (non-blocking) - queue='%s', caller='%s', total_dropped=%d",
N                        queue->name, caller ? caller : "unknown", queue->stats.total_dropped);
X            ((void)0);
N            return false;
X            return 0;
N        }
N        
N        if (queue->config.timeout_ms > 0) {
N            if ((tickTimer_GetCount() - startTick) >= queue->config.timeout_ms) {
N                QUEUE_SEND_PRINT("Send TIMEOUT - queue='%s', caller='%s', timeout=%dms",
N                            queue->name, caller ? caller : "unknown", queue->config.timeout_ms);
X                ((void)0);
N                return false;
X                return 0;
N            }
N        }
N        
N        for (volatile int i = 0; i < 100; i++);
N    }
N}
N
Nbool MsgQueue_SendUrgent(msg_queue_t *queue, msg_t *msg, const char *caller)
X_Bool MsgQueue_SendUrgent(msg_queue_t *queue, msg_t *msg, const char *caller)
N{
N    bool result;
X    _Bool result;
N    bool prio_enabled;
X    _Bool prio_enabled;
N    
N    if (queue == NULL || msg == NULL) return false;
X    if (queue == 0 || msg == 0) return 0;
N    
N    QUEUE_SEND_PRINT("Urgent send request - queue='%s', caller='%s', type=%d, len=%d",
N                queue->name, caller ? caller : "unknown", msg->type, msg->len);
X    ((void)0);
N    
N    Lock_Lock(&queue->lock, 100, "MsgQueue_SendUrgent");
N    
N    prio_enabled = queue->config.priority_enabled;
N    queue->config.priority_enabled = true;
X    queue->config.priority_enabled = 1;
N    msg->priority = MSG_PRIO_URGENT;
N    
N    result = EnqueueInternal(queue, msg);
N    
N    queue->config.priority_enabled = prio_enabled;
N    
N    Lock_Unlock(&queue->lock, "MsgQueue_SendUrgent");
N    
N    if (result) {
N        queue->stats.total_enqueued++;
N        QUEUE_SEND_PRINT("Urgent send SUCCESS - queue='%s', caller='%s'", queue->name, caller ? caller : "unknown");
X        ((void)0);
N    } else {
N        queue->stats.total_dropped++;
N        QUEUE_SEND_PRINT("Urgent send FAILED (queue full) - queue='%s', caller='%s'", 
N                    queue->name, caller ? caller : "unknown");
X        ((void)0);
N    }
N    
N    return result;
N}
