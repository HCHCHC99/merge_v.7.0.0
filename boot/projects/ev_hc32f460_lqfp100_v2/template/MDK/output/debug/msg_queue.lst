Nbool MsgQueue_Receive(msg_queue_t *queue, msg_t *msg, uint32_t timeoutMs, const char *caller)
X_Bool MsgQueue_Receive(msg_queue_t *queue, msg_t *msg, uint32_t timeoutMs, const char *caller)
N{
N    uint64_t startTick;
N    
N    if (queue == NULL || msg == NULL) return false;
X    if (queue == 0 || msg == 0) return 0;
N    
N    QUEUE_RECV_PRINT("Receive request - queue='%s', caller='%s', timeout=%dms, current_count=%d",
N                queue->name, caller ? caller : "unknown", timeoutMs, queue->count);
X    ((void)0);
N    
N    startTick = tickTimer_GetCount();
N    
N    while (1) {
N        Lock_Lock(&queue->lock, 100, "MsgQueue_Receive");
N        
N        if (queue->count > 0) {
N            memcpy(msg, &queue->buffer[queue->head], sizeof(msg_t));
N            uint16_t old_head = queue->head;
N            queue->head = (queue->head + 1) % queue->size;
N            queue->count--;
N            Lock_Unlock(&queue->lock, "MsgQueue_Receive");
N            
N            queue->stats.total_dequeued++;
N            
N            QUEUE_RECV_PRINT("Receive SUCCESS - queue='%s', caller='%s', pos=%d, type=%d, len=%d, prio=%s, remaining=%d, total_dequeued=%d",
N                        queue->name, caller ? caller : "unknown", old_head, msg->type, msg->len,
N                        GetPriorityStr(msg->priority), queue->count, queue->stats.total_dequeued);
X            ((void)0);
N            return true;
X            return 1;
N        }
N        
N        Lock_Unlock(&queue->lock, "MsgQueue_Receive");
N        
N        if (timeoutMs == 0) {
N            QUEUE_RECV_PRINT("Receive FAILED (empty, non-blocking) - queue='%s', caller='%s'",
N                        queue->name, caller ? caller : "unknown");
X            ((void)0);
N            return false;
X            return 0;
N        }
N        
N        if ((tickTimer_GetCount() - startTick) >= timeoutMs) {
N            QUEUE_RECV_PRINT("Receive TIMEOUT - queue='%s', caller='%s', timeout=%dms",
N                        queue->name, caller ? caller : "unknown", timeoutMs);
X            ((void)0);
N            return false;
X            return 0;
N        }
N        
N        for (volatile int i = 0; i < 100; i++);
N    }
N}
N
Nbool MsgQueue_Peek(msg_queue_t *queue, msg_t *msg)
X_Bool MsgQueue_Peek(msg_queue_t *queue, msg_t *msg)
N{
N    if (queue == NULL || msg == NULL) return false;
X    if (queue == 0 || msg == 0) return 0;
N    
N    Lock_Lock(&queue->lock, 100, "MsgQueue_Peek");
N    
N    if (queue->count == 0) {
N        Lock_Unlock(&queue->lock, "MsgQueue_Peek");
N        QUEUE_RECV_PRINT("Peek FAILED (empty) - queue='%s'", queue->name);
X        ((void)0);
N        return false;
X        return 0;
N    }
N    
N    memcpy(msg, &queue->buffer[queue->head], sizeof(msg_t));
N    
N    Lock_Unlock(&queue->lock, "MsgQueue_Peek");
N    
N    QUEUE_RECV_PRINT("Peek SUCCESS - queue='%s', type=%d, len=%d", queue->name, msg->type, msg->len);
X    ((void)0);
N    return true;
X    return 1;
N}
