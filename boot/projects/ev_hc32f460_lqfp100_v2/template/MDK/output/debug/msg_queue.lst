Nvoid MsgQueue_Clear(msg_queue_t *queue)
N{
N    if (queue == NULL) return;
X    if (queue == 0) return;
N    
N    QUEUE_SEND_PRINT("Queue '%s' CLEAR - clearing %d messages", queue->name, queue->count);
X    ((void)0);
N    
N    Lock_Lock(&queue->lock, 100, "MsgQueue_Clear");
N    queue->head = 0;
N    queue->tail = 0;
N    queue->count = 0;
N    Lock_Unlock(&queue->lock, "MsgQueue_Clear");
N}
