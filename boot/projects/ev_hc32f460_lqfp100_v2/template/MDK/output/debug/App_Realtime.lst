N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup CMP_Global_Types CMP Global Types
N * @{
N */
N
N/**
N * @brief CMP normal mode configuration structure
N */
Ntypedef struct {
N    uint16_t u16PositiveInput;      /*!< Positive(compare voltage) input @ref CMP_Positive_Input_Select */
N    uint16_t u16NegativeInput;      /*!< Negative(Reference voltage) input @ref CMP_Negative_Input_Select */
N    uint16_t u16OutPolarity;        /*!< Output polarity select, @ref CMP_Out_Polarity_Select */
N    uint16_t u16OutDetectEdge;      /*!< Output detect edge, @ref CMP_Out_Detect_Edge_Select */
N    uint16_t u16OutFilter;          /*!< Output Filter, @ref CMP_Out_Filter */
N} stc_cmp_init_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N
N/**
N * @defgroup CMP_Global_Macros CMP Global Macros
N * @{
N */
N
N#define VISR_OFFSET                 (8U)
N
N/**
N * @defgroup CMP_Positive_Input_Select CMP Positive(Compare) Voltage Input
N * @{
N */
N#define CMP_POSITIVE_NONE           (0x0U)
N/* Note:
N   Normal mode:
N        1) Select one positive input from the following values.
N   Scan mode:
N        2) Select any combination of the following values, but the XXX_PGAO/ XXX_PGAO_BP/ XXX_CMP1_INP4/ XXX_CMP3_INP4
N           should not be valid at the same time.
N*/
N/* CMP1 */
N#define CMP1_POSITIVE_CMP1_INP1     (CMP_VLTSEL_CVSL_0)       /*!< Pin CMP1_INP1 */
N#define CMP1_POSITIVE_CMP1_INP2     (CMP_VLTSEL_CVSL_1)       /*!< Pin CMP1_INP2 */
N#define CMP1_POSITIVE_CMP1_INP3     (CMP_VLTSEL_CVSL_2)       /*!< Pin CMP1_INP3 */
N#define CMP1_POSITIVE_PGAO          (CMP_VLTSEL_CVSL_3 | CMP_VLTSEL_C4SL_0) /*!< Internal voltage PGAO */
N#define CMP1_POSITIVE_PGAO_BP       (CMP_VLTSEL_CVSL_3 | CMP_VLTSEL_C4SL_1) /*!< Internal voltage PGAO_BP */
N#define CMP1_POSITIVE_CMP1_INP4     (CMP_VLTSEL_CVSL_3 | CMP_VLTSEL_C4SL_2) /*!< Pin CMP1_INP4 */
N/* CMP2 */
N#define CMP2_POSITIVE_CMP2_INP1     (CMP_VLTSEL_CVSL_0)       /*!< Pin CMP2_INP1 */
N#define CMP2_POSITIVE_CMP2_INP2     (CMP_VLTSEL_CVSL_1)       /*!< Pin CMP2_INP2 */
N#define CMP2_POSITIVE_CMP2_INP3     (CMP_VLTSEL_CVSL_2)       /*!< Pin CMP2_INP3 */
N#define CMP2_POSITIVE_PGAO          (CMP_VLTSEL_CVSL_3 | CMP_VLTSEL_C4SL_0) /*!< Internal voltage PGAO */
N#define CMP2_POSITIVE_PGAO_BP       (CMP_VLTSEL_CVSL_3 | CMP_VLTSEL_C4SL_1) /*!< Internal voltage PGAO_BP */
N/* CMP3 */
N#define CMP3_POSITIVE_CMP3_INP1     (CMP_VLTSEL_CVSL_0)       /*!< Pin CMP3_INP1 */
N#define CMP3_POSITIVE_CMP3_INP2     (CMP_VLTSEL_CVSL_1)       /*!< Pin CMP3_INP2 */
N#define CMP3_POSITIVE_CMP3_INP3     (CMP_VLTSEL_CVSL_2)       /*!< Pin CMP3_INP3 */
N#define CMP3_POSITIVE_CMP3_INP4     (CMP_VLTSEL_CVSL_3)       /*!< Pin CMP3_INP4 */
N/**
N * @}
N */
N
N/**
N * @defgroup CMP_Scan_Inp_Status CMP Scan Function Positive In INP Source
N * @{
N */
N#define CMP_SCAN_STAT_INP_NONE      (0U)
N#define CMP_SCAN_STAT_INP1          (1U << CMP_OUTMON_CVST_POS)
N#define CMP_SCAN_STAT_INP2          (2U << CMP_OUTMON_CVST_POS)
N#define CMP_SCAN_STAT_INP3          (4U << CMP_OUTMON_CVST_POS)
N#define CMP_SCAN_STAT_INP4          (8U << CMP_OUTMON_CVST_POS)
N/**
N * @}
N */
N
N/**
N * @defgroup CMP_Negative_Input_Select CMP Negative(Reference) Voltage Input
N * @{
N */
N#define CMP_NEGATIVE_NONE           (0x0U)
N/* Negative input select table
N        CMP1            CMP2            CMP3
N----------------------------------------------------
NINM1    CMP1_INM1       CMP2_INM1       CMP3_INM1
NINM2    CMP1_INM2       CMP2_INM2       CMP3_INM2
NINM3    DAC1            DAC2            DAC1
NINM4    VREF            VREF            DAC2
N*/
N#define CMP_NEGATIVE_INM1           (1U << CMP_VLTSEL_RVSL_POS)
N#define CMP_NEGATIVE_INM2           (2U << CMP_VLTSEL_RVSL_POS)
N#define CMP_NEGATIVE_INM3           (4U << CMP_VLTSEL_RVSL_POS)
N#define CMP_NEGATIVE_INM4           (8U << CMP_VLTSEL_RVSL_POS)
N/**
N * @}
N */
N
N/**
N * @defgroup CMP_Out_Polarity_Select CMP Output Polarity
N * @{
N */
N#define CMP_OUT_INVT_OFF            (0x0U)                    /*!< CMP output don't reverse */
N#define CMP_OUT_INVT_ON             (CMP_CTRL_INV)            /*!< CMP output level reverse */
N/**
N * @}
N */
N
N/**
N * @defgroup CMP_Out_Detect_Edge_Select CMP Output Detect Edge
N * @{
N */
N#define CMP_DETECT_EDGS_NONE        (0U)                       /*!< Do not detect edge */
N#define CMP_DETECT_EDGS_RISING      (1U << CMP_CTRL_EDGSL_POS) /*!< Detect rising edge */
N#define CMP_DETECT_EDGS_FALLING     (2U << CMP_CTRL_EDGSL_POS) /*!< Detect falling edge */
N#define CMP_DETECT_EDGS_BOTH        (3U << CMP_CTRL_EDGSL_POS) /*!< Detect rising and falling edges */
N/**
N * @}
N */
N
N/**
N * @defgroup CMP_Out_Filter CMP Output Filter Configuration
N * @{
N */
N#define CMP_OUT_FILTER_NONE         (0U)                       /*!< Do not filter */
N#define CMP_OUT_FILTER_CLK          (1U << CMP_CTRL_FLTSL_POS)
N#define CMP_OUT_FILTER_CLK_DIV2     (2U << CMP_CTRL_FLTSL_POS)
N#define CMP_OUT_FILTER_CLK_DIV4     (3U << CMP_CTRL_FLTSL_POS)
N#define CMP_OUT_FILTER_CLK_DIV8     (4U << CMP_CTRL_FLTSL_POS)
N#define CMP_OUT_FILTER_CLK_DIV16    (5U << CMP_CTRL_FLTSL_POS)
N#define CMP_OUT_FILTER_CLK_DIV32    (6U << CMP_CTRL_FLTSL_POS)
N#define CMP_OUT_FILTER_CLK_DIV64    (7U << CMP_CTRL_FLTSL_POS)
N/**
N * @}
N */
N
N/**
N * @defgroup CMP_8BitDAC_Adc_Ref_Switch CMP 8 bit DAC ADC Reference Voltage Switch
N * @{
N */
N#define CMP_ADC_REF_VREF            (CMP_COMMON_RVADC_VREFSW)
N#define CMP_ADC_REF_DA2             (CMP_COMMON_RVADC_DA2SW)
N#define CMP_ADC_REF_DA1             (CMP_COMMON_RVADC_DA1SW)
N/**
N * @}
N */
N
N/**
N * @defgroup CMP_8Bit_Dac_Ch CMP 8 bit DAC Channel
N * @{
N */
N#define CMP_8BITDAC_CH1             (CMP_COMMON_DACR_DA1EN)
N#define CMP_8BITDAC_CH2             (CMP_COMMON_DACR_DA2EN)
N/**
N * @}
N */
N
N/**
N * @}
N */
N
