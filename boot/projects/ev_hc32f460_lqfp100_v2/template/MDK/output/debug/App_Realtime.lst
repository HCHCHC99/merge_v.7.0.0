N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup MPU_Global_Types MPU Global Types
N * @{
N */
N
N/**
N * @brief MPU Unit configure structure definition
N */
Ntypedef struct {
N    uint32_t u32ExceptionType;          /*!< Specifies the type of exception that occurs when the unit accesses a protected region.
N                                             This parameter can be a value of @ref MPU_Exception_Type           */
N    uint32_t u32BackgroundWrite;        /*!< Specifies the unit's write permission for the background space.
N                                             This parameter can be a value of @ref MPU_Background_Write_Permission */
N    uint32_t u32BackgroundRead;         /*!< Specifies the unit's read permission for the background space
N                                             This parameter can be a value of @ref MPU_Background_Read_Permission  */
N} stc_mpu_unit_config_t;
N
N/**
N * @brief MPU Unit initialize structure definition
N */
Ntypedef struct {
N    uint32_t u32MpuState;               /*!< Specifies the unit's state of mpu
N                                             This parameter can be a value of @ref MPU_Unit_State             */
N    uint32_t u32ExceptionType;          /*!< Specifies the type of exception that occurs when the unit accesses a protected region.
N                                             This parameter can be a value of @ref MPU_Exception_Type          */
N    uint32_t u32BackgroundWrite;        /*!< Specifies the unit's write permission for the background space.
N                                             This parameter can be a value of @ref MPU_Background_Write_Permission */
N    uint32_t u32BackgroundRead;         /*!< Specifies the unit's read permission for the background space
N                                             This parameter can be a value of @ref MPU_Background_Read_Permission  */
N} stc_mpu_unit_init_t;
N
N/**
N * @brief MPU Init structure definition
N */
Ntypedef struct {
N    stc_mpu_unit_config_t stcDma1;      /*!< Configure storage protection unit of DMA1      */
N    stc_mpu_unit_config_t stcDma2;      /*!< Configure storage protection unit of DMA2      */
N    stc_mpu_unit_config_t stcUsbFSDma;  /*!< Configure storage protection unit of USBFS_DMA */
N} stc_mpu_init_t;
N
N/**
N * @brief MPU Region Permission structure definition
N */
Ntypedef struct {
N    uint32_t u32RegionWrite;            /*!< Specifies the unit's write permission for the region.
N                                             This parameter can be a value of @ref MPU_Region_Write_Permission */
N    uint32_t u32RegionRead;             /*!< Specifies the unit's read permission  for the region.
N                                             This parameter can be a value of @ref MPU_Region_Read_Permission */
N} stc_mpu_region_permission_t;
N
N/**
N * @brief MPU region initialization structure definition
N * @note  The effective bits of the 'u32BaseAddr' are related to the 'u32Size' of the region,
N *        and the low 'u32Size+1' bits are fixed at 0.
N */
Ntypedef struct {
N    uint32_t u32BaseAddr;                       /*!< Specifies the base address of the region.
N                                                     This parameter can be a number between 0UL and 0xFFFFFFE0UL */
N    uint32_t u32Size;                           /*!< Specifies the size of the region.
N                                                     This parameter can be a value of @ref MPU_Region_Size       */
N    stc_mpu_region_permission_t stcDma1;        /*!< Specifies the DMA1 access permission for the region         */
N    stc_mpu_region_permission_t stcDma2;        /*!< Specifies the DMA2 access permission for the region         */
N    stc_mpu_region_permission_t stcUsbFSDma;    /*!< Specifies the USBFS_DMA access permission for the region    */
N} stc_mpu_region_init_t;
N
N/**
N * @}
N */
N
