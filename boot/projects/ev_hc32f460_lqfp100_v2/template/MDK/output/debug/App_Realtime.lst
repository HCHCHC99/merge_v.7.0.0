N#ifndef __HC32_LL_I2S_H__
N#define __HC32_LL_I2S_H__
N
N/* C binding of definitions if building with C++ compiler */
N#ifdef __cplusplus
Sextern "C"
S{
N#endif
N
N/*******************************************************************************
N * Include files
N ******************************************************************************/
N#include "hc32_ll_def.h"
N
N#include "hc32f4xx.h"
N#include "hc32f4xx_conf.h"
N
N/**
N * @addtogroup LL_Driver
N * @{
N */
N
N/**
N * @addtogroup LL_I2S
N * @{
N */
N
N#if (LL_I2S_ENABLE == DDL_ON)
X#if (((1U)) == (1U))
N
N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup I2S_Global_Types I2S Global Types
N * @{
N */
N
N/**
N * @brief I2S Init structure definition
N */
Ntypedef struct {
N    uint32_t u32ClockSrc;               /*!< Specifies the clock source of I2S.
N                                             This parameter can be a value of @ref I2S_Clock_Source */
N    uint32_t u32Mode;                   /*!< Specifies the master/slave mode of I2S.
N                                             This parameter can be a value of @ref I2S_Mode */
N    uint32_t u32Protocol;               /*!< Specifies the communication protocol of I2S.
N                                             This parameter can be a value of @ref I2S_Protocol */
N    uint32_t u32TransMode;              /*!< Specifies the transmission mode for the I2S communication.
N                                             This parameter can be a value of @ref I2S_Trans_Mode */
N    uint32_t u32AudioFreq;              /*!< Specifies the frequency selected for the I2S communication.
N                                             This parameter can be a value of @ref I2S_Audio_Frequency */
N    uint32_t u32ChWidth;                /*!< Specifies the channel length for the I2S communication.
N                                             This parameter can be a value of @ref I2S_Channel_Length */
N    uint32_t u32DataWidth;              /*!< Specifies the data length for the I2S communication.
N                                             This parameter can be a value of @ref I2S_Data_Length */
N    uint32_t u32MCKOutput;              /*!< Specifies the validity of the MCK output for I2S.
N                                             This parameter can be a value of @ref I2S_MCK_Output */
N    uint32_t u32TransFIFOLevel;         /*!< Specifies the level of transfer FIFO.
N                                             This parameter can be a value of @ref I2S_Trans_Level */
N    uint32_t u32ReceiveFIFOLevel;       /*!< Specifies the level of receive FIFO.
N                                             This parameter can be a value of @ref I2S_Receive_Level */
N} stc_i2s_init_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup I2S_Global_Macros I2S Global Macros
N * @{
N */
N
N/**
N * @defgroup I2S_External_Clock_Frequency I2S External Clock Frequency
N * @{
N */
N#ifndef I2S_EXT_CLK_FREQ
N#define I2S_EXT_CLK_FREQ                        (12288000UL)    /*!< Value of the external oscillator */
N#endif /* I2S_EXT_CLK_FREQ */
N/**
N * @}
N */
N
N/**
N * @defgroup I2S_Clock_Source I2S Clock Source
N * @{
N */
N#define I2S_CLK_SRC_PLL                         (I2S_CTRL_I2SPLLSEL)  /*!< Internal PLL Clock */
N#define I2S_CLK_SRC_EXT                         (I2S_CTRL_CLKSEL)     /*!< External Clock     */
N/**
N * @}
N */
N
N/**
N * @defgroup I2S_Mode I2S Mode
N * @{
N */
N#define I2S_MD_MASTER                           (0UL)           /*!< Master mode */
N#define I2S_MD_SLAVE                            (I2S_CTRL_WMS)  /*!< Slave mode  */
N/**
N * @}
N */
N
N/**
N * @defgroup I2S_Protocol I2S Communication Protocol
N * @{
N */
N#define I2S_PROTOCOL_PHILLIPS                   (0UL)                                 /*!< Phillips protocol        */
N#define I2S_PROTOCOL_MSB                        (I2S_CFGR_I2SSTD_0)                   /*!< MSB justified protocol   */
N#define I2S_PROTOCOL_LSB                        (I2S_CFGR_I2SSTD_1)                   /*!< LSB justified protocol   */
N#define I2S_PROTOCOL_PCM_SHORT                  (I2S_CFGR_I2SSTD)                     /*!< PCM short-frame protocol */
N#define I2S_PROTOCOL_PCM_LONG                   (I2S_CFGR_I2SSTD | I2S_CFGR_PCMSYNC)  /*!< PCM long-frame protocol  */
N/**
N * @}
N */
N
N/**
N * @defgroup I2S_Trans_Mode I2S Transfer Mode
N * @{
N */
N#define I2S_TRANS_MD_HALF_DUPLEX_RX             (0UL)                               /*!< Receive only and half duplex mode */
N#define I2S_TRANS_MD_HALF_DUPLEX_TX             (I2S_CTRL_SDOE)                     /*!< Send only and half duplex mode    */
N#define I2S_TRANS_MD_FULL_DUPLEX                (I2S_CTRL_DUPLEX | I2S_CTRL_SDOE)   /*!< Full duplex mode                  */
N/**
N * @}
N */
N
N/**
N * @defgroup I2S_Audio_Frequency I2S Audio Frequency
N * @{
N */
N#define I2S_AUDIO_FREQ_192K                     (192000UL)  /*!< FS = 192000Hz */
N#define I2S_AUDIO_FREQ_96K                      (96000UL)   /*!< FS = 96000Hz  */
N#define I2S_AUDIO_FREQ_48K                      (48000UL)   /*!< FS = 48000Hz  */
N#define I2S_AUDIO_FREQ_44K                      (44100UL)   /*!< FS = 44100Hz  */
N#define I2S_AUDIO_FREQ_32K                      (32000UL)   /*!< FS = 32000Hz  */
N#define I2S_AUDIO_FREQ_22K                      (22050UL)   /*!< FS = 22050Hz  */
N#define I2S_AUDIO_FREQ_16K                      (16000UL)   /*!< FS = 16000Hz  */
N#define I2S_AUDIO_FREQ_8K                       (8000UL)    /*!< FS = 8000Hz   */
N#define I2S_AUDIO_FREQ_DEFAULT                  (2UL)
N/**
N * @}
N */
N
N/**
N * @defgroup I2S_Channel_Length I2S Channel Length
N * @{
N */
N#define I2S_CH_LEN_16BIT                        (0UL)             /*!< Channel length is 16bits */
N#define I2S_CH_LEN_32BIT                        (I2S_CFGR_CHLEN)  /*!< Channel length is 32bits */
N/**
N * @}
N */
N
N/**
N * @defgroup I2S_Data_Length I2S Data Length
N * @{
N */
N#define I2S_DATA_LEN_16BIT                      (0UL)                 /*!< Transfer data length is 16bits */
N#define I2S_DATA_LEN_24BIT                      (I2S_CFGR_DATLEN_0)   /*!< Transfer data length is 24bits */
N#define I2S_DATA_LEN_32BIT                      (I2S_CFGR_DATLEN_1)   /*!< Transfer data length is 32bits */
N/**
N * @}
N */
N
N/**
N * @defgroup I2S_MCK_Output I2S MCK Output
N * @{
N */
N#define I2S_MCK_OUTPUT_DISABLE                  (0UL)             /*!< Disable the drive clock(MCK) output */
N#define I2S_MCK_OUTPUT_ENABLE                   (I2S_CTRL_MCKOE)  /*!< Enable the drive clock(MCK) output  */
N/**
N * @}
N */
N
N/**
N * @defgroup I2S_Trans_Level I2S Transfer Level
N * @{
N */
N#define I2S_TRANS_LVL0                          (0x00UL << I2S_CTRL_TXBIRQWL_POS)   /*!< Transfer FIFO level is 0 */
N#define I2S_TRANS_LVL1                          (0x01UL << I2S_CTRL_TXBIRQWL_POS)   /*!< Transfer FIFO level is 1 */
N#define I2S_TRANS_LVL2                          (0x02UL << I2S_CTRL_TXBIRQWL_POS)   /*!< Transfer FIFO level is 2 */
N
N/**
N * @}
N */
N
N/**
N * @defgroup I2S_Receive_Level I2S Receive Level
N * @{
N */
N#define I2S_RECEIVE_LVL0                        (0x00UL << I2S_CTRL_RXBIRQWL_POS)   /*!< Receive FIFO level is 0 */
N#define I2S_RECEIVE_LVL1                        (0x01UL << I2S_CTRL_RXBIRQWL_POS)   /*!< Receive FIFO level is 1 */
N#define I2S_RECEIVE_LVL2                        (0x02UL << I2S_CTRL_RXBIRQWL_POS)   /*!< Receive FIFO level is 2 */
N
N/**
N * @}
N */
N
N/**
N * @defgroup I2S_Com_Func I2S Communication Function
N * @{
N */
N#define I2S_FUNC_TX                             (I2S_CTRL_TXE)  /*!< Transfer function */
N#define I2S_FUNC_RX                             (I2S_CTRL_RXE)  /*!< Receive function  */
N#define I2S_FUNC_ALL                            (I2S_FUNC_TX | I2S_FUNC_RX)
N/**
N * @}
N */
N
N/**
N * @defgroup I2S_Reset_Type I2S Reset Type
N * @{
N */
N#define I2S_RST_TYPE_FIFO                       (I2S_CTRL_FIFOR)    /*!< Reset FIFO of I2S  */
N
N#define I2S_RST_TYPE_ALL                        (I2S_RST_TYPE_FIFO)
N/**
N * @}
N */
N
N/**
N * @defgroup I2S_Interrupt I2S Interrupt
N * @{
N */
N#define I2S_INT_TX                              (I2S_CTRL_TXIE)   /*!< Transfer interrupt            */
N#define I2S_INT_RX                              (I2S_CTRL_RXIE)   /*!< Receive interrupt             */
N#define I2S_INT_ERR                             (I2S_CTRL_EIE)    /*!< Communication error interrupt */
N#define I2S_INT_ALL                             (I2S_INT_TX | I2S_INT_RX | I2S_INT_ERR)
N/**
N * @}
N */
N
N/**
N * @defgroup I2S_Flag I2S Flag
N * @{
N */
N#define I2S_FLAG_TX_ALARM                       (I2S_SR_TXBA)           /*!< Transfer buffer alarm flag          */
N#define I2S_FLAG_RX_ALARM                       (I2S_SR_RXBA)           /*!< Receive buffer alarm flag           */
N#define I2S_FLAG_TX_EMPTY                       (I2S_SR_TXBE)           /*!< Transfer buffer empty flag          */
N#define I2S_FLAG_TX_FULL                        (I2S_SR_TXBF)           /*!< Transfer buffer full flag           */
N#define I2S_FLAG_RX_EMPTY                       (I2S_SR_RXBE)           /*!< Receive buffer empty flag           */
N#define I2S_FLAG_RX_FULL                        (I2S_SR_RXBF)           /*!< Receive buffer full flag            */
N#define I2S_FLAG_TX_ERR                         (I2S_ER_TXERR << 16U)   /*!< Transfer overflow or underflow flag */
N#define I2S_FLAG_RX_ERR                         (I2S_ER_RXERR << 16U)   /*!< Receive overflow flag               */
N#define I2S_FLAG_ALL                            (I2S_FLAG_TX_ALARM | I2S_FLAG_RX_ALARM | I2S_FLAG_TX_EMPTY | \
N                                                 I2S_FLAG_TX_FULL  | I2S_FLAG_RX_EMPTY | I2S_FLAG_RX_FULL  | \
N                                                 I2S_FLAG_TX_ERR   | I2S_FLAG_RX_ERR)
X#define I2S_FLAG_ALL                            (I2S_FLAG_TX_ALARM | I2S_FLAG_RX_ALARM | I2S_FLAG_TX_EMPTY |                                                  I2S_FLAG_TX_FULL  | I2S_FLAG_RX_EMPTY | I2S_FLAG_RX_FULL  |                                                  I2S_FLAG_TX_ERR   | I2S_FLAG_RX_ERR)
N#define I2S_FLAG_CLR_ALL                        (I2S_FLAG_TX_ERR   | I2S_FLAG_RX_ERR)
N/**
N * @}
N */
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global variable definitions ('extern')
