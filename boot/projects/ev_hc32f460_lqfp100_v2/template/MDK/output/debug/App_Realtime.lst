N/**
N * @defgroup PWC_REG_Write_Unlock_Code PWC register unlock code.
N * @brief Lock/unlock Code for each module
N@verbatim
N *        PWC_UNLOCK_CODE0:
N *          Below registers are locked in CLK module.
N *              XTALCFGR, XTALSTBCR, XTALCR, XTALSTDCR, XTALSTDSR, HRCTRM, HRCCR,
N *              MRCTRM, MRCCR, PLLCFGR, PLLCR, UPLLCFGR, UPLLCR, OSCSTBSR, CKSWR,
N *              SCFGR, USBCKCFGR, TPIUCKCFGR, MCO1CFGR, MCO2CFGR, XTAL32CR,
N *              XTALC32CFGR, XTAL32NFR, LRCCR, LRCTRM.
N *        PWC_UNLOCK_CODE1:
N *          Below registers are locked in PWC module.
N *              PWRC0, PWRC1, PWRC2, PWRC3, PDWKE0, PDWKE1, PDWKE2, PDWKES, PDWKF0,
N *              PDWKF1, PWCMR, PWR_STPMCR, RAMPC0, RAMOPM.
N *          Below registers are locked in CLK module.
N *              PERICKSEL, I2SCKSEL,
N *          Below register is locked in RMU module.
N *              RSTF0
N *        PWC_UNLOCK_CODE2:
N *          Below registers are locked in PWC module.
N *              PVDCR0, PVDCR1, PVDFCR, PVDLCR, PVDICR, PVDDSR
N@endverbatim
N * @{
N */
N#define PWC_WRITE_ENABLE                (0xA500U)
N#define PWC_UNLOCK_CODE0                (0xA501U)
N#define PWC_UNLOCK_CODE1                (0xA502U)
N#define PWC_UNLOCK_CODE2                (0xA508U)
N
N/**
N * @brief PWC FCG0 Unlock/Lock code
N */
N#define PWC_FCG0_REG_UNLOCK_KEY          (0xA5A50001UL)
N#define PWC_FCG0_REG_LOCK_KEY            (0xA5A50000UL)
N
N/**
N * @}
N */
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global variable definitions ('extern')
N ******************************************************************************/
N
N/*******************************************************************************
N  Global function prototypes (definition in C source)
N ******************************************************************************/
N/**
N * @addtogroup PWC_Global_Functions
N * @{
N */
N/**
N * @brief  Lock PWC, CLK, RMU register.
N * @param  [in] u16Module Lock code for each module.
N *   @arg  PWC_UNLOCK_CODE0
N *   @arg  PWC_UNLOCK_CODE1
N *   @arg  PWC_UNLOCK_CODE2
N * @retval None
N */
N__STATIC_INLINE void PWC_REG_Lock(uint16_t u16Module)
Xstatic __inline void PWC_REG_Lock(uint16_t u16Module)
N{
N    CM_PWC->FPRC = (PWC_WRITE_ENABLE | (uint16_t)((uint16_t)(~u16Module) & (CM_PWC->FPRC)));
X    ((CM_PWC_TypeDef *)(0x40048000UL))->FPRC = ((0xA500U) | (uint16_t)((uint16_t)(~u16Module) & (((CM_PWC_TypeDef *)(0x40048000UL))->FPRC)));
N}
N
N/**
N * @brief  Unlock PWC, CLK, RMU register.
N * @param  [in] u16Module Unlock code for each module.
N *   @arg  PWC_UNLOCK_CODE0
N *   @arg  PWC_UNLOCK_CODE1
N *   @arg  PWC_UNLOCK_CODE2
N * @retval None
N */
N__STATIC_INLINE void PWC_REG_Unlock(uint16_t u16Module)
Xstatic __inline void PWC_REG_Unlock(uint16_t u16Module)
N{
N    SET_REG16_BIT(CM_PWC->FPRC, u16Module);
X    ((((CM_PWC_TypeDef *)(0x40048000UL))->FPRC) |= ((uint16_t)(u16Module)));
N}
N
N/**
N * @brief  Lock PWC_FCG0 register .
N * @param  None
N * @retval None
N */
N__STATIC_INLINE void PWC_FCG0_REG_Lock(void)
Xstatic __inline void PWC_FCG0_REG_Lock(void)
N{
N    WRITE_REG32(CM_PWC->FCG0PC, PWC_FCG0_REG_LOCK_KEY);
X    ((((CM_PWC_TypeDef *)(0x40048000UL))->FCG0PC) = ((uint32_t)((0xA5A50000UL))));
N}
N
N/**
N * @brief  Unlock PWR_FCG0 register.
N * @param  None
N * @retval None
N * @note Call this function before FCG_Fcg0PeriphClockCmd()
N */
N__STATIC_INLINE void PWC_FCG0_REG_Unlock(void)
Xstatic __inline void PWC_FCG0_REG_Unlock(void)
N{
N    WRITE_REG32(CM_PWC->FCG0PC, PWC_FCG0_REG_UNLOCK_KEY);
X    ((((CM_PWC_TypeDef *)(0x40048000UL))->FCG0PC) = ((uint32_t)((0xA5A50001UL))));
N}
N
