N * @{
N */
N#define OTS_PARAM_TEMP_COND_TN40        (0U)                /*!< -40 degrees Celsius. */
N#define OTS_PARAM_TEMP_COND_T25         (1U)                /*!< 25 degrees Celsius. */
N#define OTS_PARAM_TEMP_COND_T125        (2U)                /*!< 125 degrees Celsius. */
N/**
N * @}
N */
N
N/**
N * @}
N */
N
