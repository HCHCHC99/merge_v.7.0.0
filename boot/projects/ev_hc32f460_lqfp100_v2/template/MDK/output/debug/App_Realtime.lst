N/**
N * @defgroup CLK_Global_Types CLK Global Types
N * @{
N */
N/**
N * @brief  CLK XTAL configuration structure definition
N */
Ntypedef struct {
N    uint8_t u8State;            /*!< The new state of the XTAL.
N                                     This parameter can be a value of @ref CLK_XTAL_State                   */
N    uint8_t u8Drv;              /*!< The XTAL drive ability.
N                                     This parameter can be a value of @ref CLK_XTAL_Driver                  */
N    uint8_t u8Mode;             /*!< The XTAL mode selection osc or exclk.
N                                     This parameter can be a value of @ref CLK_XTAL_Mode_Selection          */
N    uint8_t u8SuperDrv;         /*!< The XTAL super drive on or off.
N                                     This parameter can be a value of @ref CLK_XTAL_Super_Drive_State       */
N    uint8_t u8StableTime;       /*!< The XTAL stable time selection.
N                                     This parameter can be a value of @ref CLK_XTAL_Stable_Time_Selection   */
N} stc_clock_xtal_init_t;
N
N/**
N * @brief  CLK XTAL fault detect configuration structure definition
N */
Ntypedef struct {
N    uint8_t u8State;            /*!< Specifies the new state of XTALSTD.
N                                     This parameter can be a value of @ref CLK_XTALSTD_State                */
N    uint8_t u8ExceptionType;    /*!< Specifies the XTALSTD exception type.
N                                     This parameter can be a value of @ref CLK_XTALSTD_Exception_type       */
N} stc_clock_xtalstd_init_t;
N
N/**
N * @brief  CLK XTAL32 configuration structure definition
N */
Ntypedef struct {
N    uint8_t u8State;            /*!< The new state of the XTAL32 divide.
N                                     This parameter can be a value of @ref CLK_XTAL32_State                 */
N    uint8_t u8Drv;              /*!< The Xtal32 drive ability setting,
N                                     This parameter can be a value of @ref CLK_XTAL32_Drive                 */
N    uint8_t u8Filter;           /*!< Xtal32 noise filter setting,
N                                     This parameter can be a value of@ref CLK_XTAL32_Filter_Selection       */
N} stc_clock_xtal32_init_t;
N
N/**
N * @brief  CLK clock frequency configuration structure definition
N */
Ntypedef struct {
N    union {
N        uint32_t SCFGR;     /*!< clock frequency config register  */
N        struct {
N            uint32_t PCLK0S     : 3;    /*!< PCLK0      */
N            uint32_t resvd0     : 1;    /*!< reserved   */
N            uint32_t PCLK1S     : 3;    /*!< PCLK1      */
N            uint32_t resvd1     : 1;    /*!< reserved   */
N            uint32_t PCLK2S     : 3;    /*!< PCLK2      */
N            uint32_t resvd2     : 1;    /*!< reserved   */
N            uint32_t PCLK3S     : 3;    /*!< PCLK3      */
N            uint32_t resvd3     : 1;    /*!< reserved   */
N            uint32_t PCLK4S     : 3;    /*!< PCLK4      */
N            uint32_t resvd4     : 1;    /*!< reserved   */
N            uint32_t EXCKS      : 3;    /*!< EXCLK      */
N            uint32_t resvd5     : 1;    /*!< reserved   */
N            uint32_t HCLKS      : 3;    /*!< HCLK       */
N            uint32_t resvd6     : 5;    /*!< reserved   */
N        } SCFGR_f;
N    };
N} stc_clock_scale_t;
N
N/**
N * @brief  CLK PLL configuration structure definition
N * @note   PLL for MPLL
N */
Ntypedef struct {
N    uint8_t u8PLLState;         /*!< PLL new state, @ref CLK_PLL_State for details */
N    union {
N        uint32_t PLLCFGR;       /*!< PLL config register */
N        struct {
N            uint32_t PLLM   : 5; /*!< PLL M divide */
N            uint32_t resvd0 : 2; /*!< reserved */
N            uint32_t PLLSRC : 1; /*!< PLL/PLLA source clock select */
N            uint32_t PLLN   : 9; /*!< PLL N multi   */
N            uint32_t resvd1 : 3; /*!< reserved      */
N            uint32_t PLLR   : 4; /*!< PLL R divide  */
N            uint32_t PLLQ   : 4; /*!< PLL Q divide  */
N            uint32_t PLLP   : 4; /*!< PLL P divide  */
N        } PLLCFGR_f;
N    };
N} stc_clock_pll_init_t;
N
N/**
N * @brief  CLK PLLx configuration structure definition
N * @note   PLLx for UPLL
N */
Ntypedef struct {
N    uint8_t u8PLLState;          /*!< PLLx new state, @ref CLK_PLLx_State for details */
N    union {
N        uint32_t PLLCFGR;        /*!< PLLx config register */
N        struct {
N            uint32_t PLLM   : 5; /*!< PLLx M divide */
N            uint32_t resvd0 : 3; /*!< reserved */
N            uint32_t PLLN   : 9; /*!< PLLx N multi- */
N            uint32_t resvd1 : 3; /*!< reserved */
N            uint32_t PLLR   : 4; /*!< PLLx R divide */
N            uint32_t PLLQ   : 4; /*!< PLLx Q divide */
N            uint32_t PLLP   : 4; /*!< PLLx P divide */
N        } PLLCFGR_f;
N    };
N} stc_clock_pllx_init_t;
N
N/**
N * @brief  CLK bus frequency structure definition
N */
Ntypedef struct {
N    uint32_t u32SysclkFreq;        /*!< System clock frequency. */
N    uint32_t u32HclkFreq;          /*!< Hclk frequency.         */
N    uint32_t u32Pclk0Freq;         /*!< Pclk0 frequency.        */
N    uint32_t u32Pclk1Freq;         /*!< Pclk1 frequency.        */
N    uint32_t u32Pclk2Freq;         /*!< Pclk2 frequency.        */
N    uint32_t u32Pclk3Freq;         /*!< Pclk3 frequency.        */
N    uint32_t u32Pclk4Freq;         /*!< Pclk4 frequency.        */
N    uint32_t u32ExclkFreq;         /*!< Exclk frequency.        */
N} stc_clock_freq_t;
N
N/**
N * @brief  CLK PLL clock frequency structure definition
N */
Ntypedef struct {
N    uint32_t u32PllVcin;               /*!< PLL vcin clock frequency.      */
N    uint32_t u32PllVco;                /*!< PLL vco clock frequency.       */
N    uint32_t u32PllP;                  /*!< PLLp clock frequency.          */
N    uint32_t u32PllQ;                  /*!< PLLq clock frequency.          */
N    uint32_t u32PllR;                  /*!< PLLr clock frequency.          */
N    uint32_t u32PllxVcin;              /*!< pllx vcin clock frequency.     */
N    uint32_t u32PllxVco;               /*!< pllx vco clock frequency.      */
N    uint32_t u32PllxP;                 /*!< pllxp clock frequency.         */
N    uint32_t u32PllxQ;                 /*!< pllxq clock frequency.         */
N    uint32_t u32PllxR;                 /*!< pllxr clock frequency.         */
N} stc_pll_clock_freq_t;
