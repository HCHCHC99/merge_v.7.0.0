N#define CLK_MCO_SRC_LRC                 (0x02U)
N#define CLK_MCO_SRC_XTAL                (0x03U)
N#define CLK_MCO_SRC_XTAL32              (0x04U)
N#define CLK_MCO_SRC_PLLP                (0x06U)
N#define CLK_MCO_SRC_PLLXP               (0x07U)
N#define CLK_MCO_SRC_PLLQ                (0x08U)
N#define CLK_MCO_SRC_PLLXQ               (0x09U)
N#define CLK_MCO_SRC_HCLK                (0x0BU)
N/**
N * @}
N */
N
N/**
N * @defgroup CLK_MCO_Clock_Prescaler CLK MCO Clock Prescaler
N * @{
N */
N#define CLK_MCO_DIV1                    (0x00U << CMU_MCOCFGR_MCODIV_POS)
N#define CLK_MCO_DIV2                    (0x01U << CMU_MCOCFGR_MCODIV_POS)
N#define CLK_MCO_DIV4                    (0x02U << CMU_MCOCFGR_MCODIV_POS)
N#define CLK_MCO_DIV8                    (0x03U << CMU_MCOCFGR_MCODIV_POS)
N#define CLK_MCO_DIV16                   (0x04U << CMU_MCOCFGR_MCODIV_POS)
N#define CLK_MCO_DIV32                   (0x05U << CMU_MCOCFGR_MCODIV_POS)
N#define CLK_MCO_DIV64                   (0x06U << CMU_MCOCFGR_MCODIV_POS)
N#define CLK_MCO_DIV128                  (0x07U << CMU_MCOCFGR_MCODIV_POS)
N/**
N * @}
N */
N
