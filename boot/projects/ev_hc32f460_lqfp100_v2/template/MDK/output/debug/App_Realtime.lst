N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup QSPI_Global_Types QSPI Global Types
N * @{
N */
N
N/**
N * @brief QSPI initialization structure definition
N */
Ntypedef struct {
N    uint32_t u32ClockDiv;               /*!< Specifies the clock division.
N                                             This parameter can be a value of @ref QSPI_Clock_Division */
N    uint32_t u32SpiMode;                /*!< Specifies the SPI mode.
N                                             This parameter can be a value of @ref QSPI_SPI_Mode */
N    uint32_t u32PrefetchMode;           /*!< Specifies the prefetch mode.
N                                             This parameter can be a value of @ref QSPI_Prefetch_Mode */
N    uint32_t u32ReadMode;               /*!< Specifies the read mode.
N                                             This parameter can be a value of @ref QSPI_Read_Mode */
N    uint32_t u32DummyCycle;             /*!< Specifies the number of dummy cycles.
N                                             This parameter can be a value of @ref QSPI_Dummy_Cycle */
N    uint32_t u32AddrWidth;              /*!< Specifies the address width.
N                                             This parameter can be a value of @ref QSPI_Addr_Width */
N    uint32_t u32SetupTime;              /*!< Specifies the advance time of QSSN setup.
N                                             This parameter can be a value of @ref QSPI_QSSN_Setup_Time */
N    uint32_t u32ReleaseTime;            /*!< Specifies the delay time of QSSN release.
N                                             This parameter can be a value of @ref QSPI_QSSN_Release_Time */
N    uint32_t u32IntervalTime;           /*!< Specifies the minimum interval time of QSSN.
N                                             This parameter can be a value of @ref QSPI_QSSN_Interval_Time */
N} stc_qspi_init_t;
N
N/**
N * @brief QSPI Custom read mode structure definition
N */
Ntypedef struct {
N    uint32_t u32InstrProtocol;          /*!< Specifies the instruction stage protocol.
N                                             This parameter can be a value of @ref QSPI_Instruction_Protocol */
N    uint32_t u32AddrProtocol;           /*!< Specifies the address stage protocol.
N                                             This parameter can be a value of @ref QSPI_Addr_Protocol */
N    uint32_t u32DataProtocol;           /*!< Specifies the data stage protocol.
N                                             This parameter can be a value of @ref QSPI_Data_Protocol */
N    uint8_t  u8InstrCode;               /*!< Specifies the instruction code in custom read mode.
N                                             This parameter must be a number between Min_Data = 0x0 and Max_Data = 0xFF */
N} stc_qspi_custom_mode_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup QSPI_Global_Macros QSPI Global Macros
N * @{
N */
N
N/* QSPI memory mapping base and end address */
N#define QSPI_ROM_BASE                           (0x98000000UL)
N#define QSPI_ROM_END                            (0x9BFFFFFFUL)
N
N/**
N * @defgroup QSPI_Clock_Division QSPI Clock Division
N * @{
N */
N#define QSPI_CLK_DIV2                           (0x01UL << QSPI_CR_DIV_POS)     /*!< Clock division by 2    */
N#define QSPI_CLK_DIV3                           (0x02UL << QSPI_CR_DIV_POS)     /*!< Clock division by 3    */
N#define QSPI_CLK_DIV4                           (0x03UL << QSPI_CR_DIV_POS)     /*!< Clock division by 4    */
N#define QSPI_CLK_DIV5                           (0x04UL << QSPI_CR_DIV_POS)     /*!< Clock division by 5    */
N#define QSPI_CLK_DIV6                           (0x05UL << QSPI_CR_DIV_POS)     /*!< Clock division by 6    */
N#define QSPI_CLK_DIV7                           (0x06UL << QSPI_CR_DIV_POS)     /*!< Clock division by 7    */
N#define QSPI_CLK_DIV8                           (0x07UL << QSPI_CR_DIV_POS)     /*!< Clock division by 8    */
N#define QSPI_CLK_DIV9                           (0x08UL << QSPI_CR_DIV_POS)     /*!< Clock division by 9    */
N#define QSPI_CLK_DIV10                          (0x09UL << QSPI_CR_DIV_POS)     /*!< Clock division by 10   */
N#define QSPI_CLK_DIV11                          (0x0AUL << QSPI_CR_DIV_POS)     /*!< Clock division by 11   */
N#define QSPI_CLK_DIV12                          (0x0BUL << QSPI_CR_DIV_POS)     /*!< Clock division by 12   */
N#define QSPI_CLK_DIV13                          (0x0CUL << QSPI_CR_DIV_POS)     /*!< Clock division by 13   */
N#define QSPI_CLK_DIV14                          (0x0DUL << QSPI_CR_DIV_POS)     /*!< Clock division by 14   */
N#define QSPI_CLK_DIV15                          (0x0EUL << QSPI_CR_DIV_POS)     /*!< Clock division by 15   */
N#define QSPI_CLK_DIV16                          (0x0FUL << QSPI_CR_DIV_POS)     /*!< Clock division by 16   */
N#define QSPI_CLK_DIV17                          (0x10UL << QSPI_CR_DIV_POS)     /*!< Clock division by 17   */
