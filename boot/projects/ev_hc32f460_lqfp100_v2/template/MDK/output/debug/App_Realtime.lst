N/*=============================================================================
N * @brief  Ëé∑ÂèñÂÆûÊó∂ÁîµÂéã (0.1V)
N *============================================================================*/
Nuint16_t Realtime_GetVoltage(void)
N{
N    uint32_t u32BusVoltageMv = 0;
N    DeviceCommandData_t stcCmd;
N    memset(&stcCmd, 0, sizeof(DeviceCommandData_t));
N    stcCmd.cmd = CMD_VOLTAGE_GET_BUS_MV;
X    stcCmd.cmd = (0x3000 + 0x10);
N    stcCmd.params = NULL;
X    stcCmd.params = 0;
N    stcCmd.param_size = 0;
N    stcCmd.response = &u32BusVoltageMv;
N    stcCmd.response_size = sizeof(uint32_t);
N
N    DeviceResult_t res = Device_Control(ID_VOLTAGE_BUS, &stcCmd);
X    DeviceResult_t res = Device_Control(13, &stcCmd);
N    if (res == RESULT_OK)
N    {
N        /* mV -> 0.1V: 0.1V = mV / 100 */
N        return (uint16_t)(u32BusVoltageMv / 100UL);
N    }
N    
N    REALTIME_DBG("GetVoltage failed, res=%d", (int)res);
X    ((void)0);
N    return 0;
N}
N
N/*=============================================================================
N * @brief  Ëé∑ÂèñÂÆûÊó∂ÁîµÊµÅ (1mA)
N *============================================================================*/
Nuint16_t Realtime_GetCurrent(void)
N{
N    int32_t s32CurrentMa = 0;
N    DeviceCommandData_t stcCmd;
N    memset(&stcCmd, 0, sizeof(DeviceCommandData_t));
N    stcCmd.cmd = CMD_SENSOR_GET_CURRENT_MA;
X    stcCmd.cmd = (0x3000 + 0x20);
N    stcCmd.params = NULL;
X    stcCmd.params = 0;
N    stcCmd.param_size = 0;
N    stcCmd.response = &s32CurrentMa;
N    stcCmd.response_size = sizeof(int32_t);
N
N    DeviceResult_t res = Device_Control(ID_SENSOR_CURRENT, &stcCmd);
X    DeviceResult_t res = Device_Control(14, &stcCmd);
N    if (res == RESULT_OK)
N    {
N        /* ÂèñÁªùÂØπÂÄºÔºàModbus ‰∏∫ uint16_tÔºâ */
N        if (s32CurrentMa < 0)
N        {
N            return (uint16_t)(-s32CurrentMa);
N        }
N        return (uint16_t)s32CurrentMa;
N    }
N    
N    REALTIME_DBG("GetCurrent failed, res=%d", (int)res);
X    ((void)0);
N    return 0;
N}
