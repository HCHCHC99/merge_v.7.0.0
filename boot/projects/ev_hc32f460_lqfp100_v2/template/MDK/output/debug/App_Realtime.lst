S                                                : "r0", "r1", "cc"                                  \
S                                                );                                                  \
S                            }
X    #define SEGGER_RTT_UNLOCK() __asm volatile ("mov r0, %0 \n\t"                                                                                   "mrs r1, CPSR \n\t"                                                                                 "bic r1, r1, #0xC0 \n\t"                                                                            "and r0, r0, #0xC0 \n\t"                                                                            "orr r1, r1, r0 \n\t"                                                                               "msr CPSR_c, r1 \n\t"                                                                               :                                                                                                   : "r" (_SEGGER_RTT__LockState)                                                                                   : "r0", "r1", "cc"                                                                                  );                                                                              }
S  #endif
N#endif
