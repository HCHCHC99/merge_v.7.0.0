N */
N
N/* Initialization and configuration functions */
Nint32_t I2S_DeInit(CM_I2S_TypeDef *I2Sx);
Nint32_t I2S_Init(CM_I2S_TypeDef *I2Sx, const stc_i2s_init_t *pstcI2sInit);
Nint32_t I2S_StructInit(stc_i2s_init_t *pstcI2sInit);
Nvoid I2S_SWReset(CM_I2S_TypeDef *I2Sx, uint32_t u32Type);
Nvoid I2S_SetTransMode(CM_I2S_TypeDef *I2Sx, uint32_t u32Mode);
Nvoid I2S_SetTransFIFOLevel(CM_I2S_TypeDef *I2Sx, uint32_t u32Level);
Nvoid I2S_SetReceiveFIFOLevel(CM_I2S_TypeDef *I2Sx, uint32_t u32Level);
Nvoid I2S_SetProtocol(CM_I2S_TypeDef *I2Sx, uint32_t u32Protocol);
Nint32_t I2S_SetAudioFreq(CM_I2S_TypeDef *I2Sx, uint32_t u32Freq);
Nvoid I2S_MCKOutputCmd(CM_I2S_TypeDef *I2Sx, en_functional_state_t enNewState);
Nvoid I2S_FuncCmd(CM_I2S_TypeDef *I2Sx, uint32_t u32Func, en_functional_state_t enNewState);
N
N/* Transfer and receive data functions */
