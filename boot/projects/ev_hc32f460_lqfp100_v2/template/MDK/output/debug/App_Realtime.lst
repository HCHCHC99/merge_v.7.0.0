N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup CRC_Global_Types CRC Global Types
N * @{
N */
N
N/**
N * @brief CRC initialization structure definition
N */
Ntypedef struct {
N    uint32_t u32Protocol;   /*!< Specifies CRC Protocol.
N                                 This parameter can be a value of @ref CRC_Protocol_Control_Bit */
N    uint32_t u32InitValue;  /*!< Specifies initial CRC value.
N                                 This parameter can be CRC_INIT_VALUE_DEFAULT @ref CRC_Init_Value_Default */
N    uint32_t u32RefIn;      /*!< Specifies CRC Retroflexion Input.
N                                 This parameter can be a value of @ref CRC_Retroflexion_Input */
N    uint32_t u32RefOut;     /*!< Specifies CRC Retroflexion Output.
N                                 This parameter can be a value of @ref CRC_Retroflexion_Output */
N    uint32_t u32XorOut;     /*!< Specifies CRC XOR Output.
N                                 This parameter can be a value of @ref CRC_XOR_Output */
N} stc_crc_init_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup CRC_Global_Macros CRC Global Macros
N * @{
N */
N
N/**
N * @defgroup CRC_Protocol_Control_Bit CRC Protocol Control Bit
N * @{
N */
N#define CRC_CRC16                   (0x0UL)
N#define CRC_CRC32                   (CRC_CR_CR)
N/**
N * @}
N */
N
N/**
N * @defgroup CRC_DATA_Bit_Width CRC Data Bit Width
N * @{
N */
N#define CRC_DATA_WIDTH_8BIT         (1U)
N#define CRC_DATA_WIDTH_16BIT        (2U)
N#define CRC_DATA_WIDTH_32BIT        (4U)
N/**
N * @}
N */
N
N/**
N * @defgroup CRC_Init_Value_Default CRC Default Computation Initialization Value
N * @{
N */
N#define CRC_INIT_VALUE_DEFAULT      (0xFFFFFFFFUL)
N/**
N * @}
N */
N
N/**
N * @defgroup CRC_Retroflexion_Input CRC Retroflexion Input
N * @{
N */
N#define CRC_REFIN_DISABLE           (0x0UL)
N#define CRC_REFIN_ENABLE            (CRC_CR_REFIN)
N/**
N * @}
N */
N
N/**
N * @defgroup CRC_Retroflexion_Output CRC Retroflexion Output
N * @{
N */
N#define CRC_REFOUT_DISABLE          (0x0UL)
N#define CRC_REFOUT_ENABLE           (CRC_CR_REFOUT)
N/**
N * @}
N */
N
N/**
N * @defgroup CRC_XOR_Output CRC XOR Output
N * @{
N */
N#define CRC_XOROUT_DISABLE          (0x0UL)
N#define CRC_XOROUT_ENABLE           (CRC_CR_XOROUT)
N/**
N * @}
N */
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global variable definitions ('extern')
N ******************************************************************************/
N
N/*******************************************************************************
