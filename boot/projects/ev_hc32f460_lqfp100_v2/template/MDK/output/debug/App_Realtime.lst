N#define I2C_FLAG_CLR_ALL              (I2C_FLAG_CLR_START       | I2C_FLAG_CLR_ARBITRATE_FAIL      | \
N                                       I2C_FLAG_CLR_MATCH_ADDR0 | I2C_FLAG_CLR_NACK                | \
N                                       I2C_FLAG_CLR_MATCH_ADDR1 | I2C_FLAG_CLR_TMOUTF              | \
N                                       I2C_FLAG_CLR_TX_CPLT     | I2C_FLAG_CLR_GENERAL_CALL        | \
N                                       I2C_FLAG_CLR_STOP        | I2C_FLAG_CLR_SMBUS_DEFAULT_MATCH | \
N                                       I2C_FLAG_CLR_RX_FULL     | I2C_FLAG_CLR_SMBUS_HOST_MATCH    | \
N                                       I2C_FLAG_CLR_SMBUS_ALERT_MATCH)
X#define I2C_FLAG_CLR_ALL              (I2C_FLAG_CLR_START       | I2C_FLAG_CLR_ARBITRATE_FAIL      |                                        I2C_FLAG_CLR_MATCH_ADDR0 | I2C_FLAG_CLR_NACK                |                                        I2C_FLAG_CLR_MATCH_ADDR1 | I2C_FLAG_CLR_TMOUTF              |                                        I2C_FLAG_CLR_TX_CPLT     | I2C_FLAG_CLR_GENERAL_CALL        |                                        I2C_FLAG_CLR_STOP        | I2C_FLAG_CLR_SMBUS_DEFAULT_MATCH |                                        I2C_FLAG_CLR_RX_FULL     | I2C_FLAG_CLR_SMBUS_HOST_MATCH    |                                        I2C_FLAG_CLR_SMBUS_ALERT_MATCH)
N
N/**
N * @}
N */
N
N/**
N * @defgroup I2C_Int_Flag I2C Interrupt Flag Bits
N * @{
N */
N#define I2C_INT_START                 (I2C_CR2_STARTIE)
N#define I2C_INT_MATCH_ADDR0           (I2C_CR2_SLADDR0IE)
N#define I2C_INT_MATCH_ADDR1           (I2C_CR2_SLADDR1IE)
N#define I2C_INT_TX_CPLT               (I2C_CR2_TENDIE)
N#define I2C_INT_STOP                  (I2C_CR2_STOPIE)
N#define I2C_INT_RX_FULL               (I2C_CR2_RFULLIE)
N#define I2C_INT_TX_EMPTY              (I2C_CR2_TEMPTYIE)
N#define I2C_INT_ARBITRATE_FAIL        (I2C_CR2_ARLOIE)
N#define I2C_INT_NACK                  (I2C_CR2_NACKIE)
N#define I2C_INT_TMOUTIE               (I2C_CR2_TMOUTIE)
N#define I2C_INT_GENERAL_CALL          (I2C_CR2_GENCALLIE)
N#define I2C_INT_SMBUS_DEFAULT_MATCH   (I2C_CR2_SMBDEFAULTIE)
N#define I2C_INT_SMBUS_HOST_MATCH      (I2C_CR2_SMBHOSTIE)
N#define I2C_INT_SMBUS_ALERT_MATCH     (I2C_CR2_SMBALRTIE)
N#define I2C_INT_ALL                   (I2C_INT_START       | I2C_INT_ARBITRATE_FAIL      | \
N                                       I2C_INT_MATCH_ADDR0 | I2C_INT_NACK                | \
N                                       I2C_INT_MATCH_ADDR1 | I2C_INT_TMOUTIE             | \
N                                       I2C_INT_TX_CPLT     | I2C_INT_GENERAL_CALL        | \
N                                       I2C_INT_STOP        | I2C_INT_SMBUS_DEFAULT_MATCH | \
N                                       I2C_INT_RX_FULL     | I2C_INT_SMBUS_HOST_MATCH    | \
N                                       I2C_INT_TX_EMPTY    | I2C_INT_SMBUS_ALERT_MATCH)
