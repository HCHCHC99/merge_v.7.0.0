N * @{
N */
N#define I2C_ADDR_DISABLE              (0U)
N#define I2C_ADDR_7BIT                 (I2C_SLR0_SLADDR0EN)
N#define I2C_ADDR_10BIT                (I2C_SLR0_ADDRMOD0 | I2C_SLR0_SLADDR0EN)
N/**
N * @}
N */
N
N/**
N * @defgroup I2C_Clock_Division I2C Clock Division
N * @{
N */
N#define I2C_CLK_DIV1                  (0UL)         /*!< I2c source clock/1 */
N#define I2C_CLK_DIV2                  (1UL)         /*!< I2c source clock/2 */
N#define I2C_CLK_DIV4                  (2UL)         /*!< I2c source clock/4 */
N#define I2C_CLK_DIV8                  (3UL)         /*!< I2c source clock/8 */
N#define I2C_CLK_DIV16                 (4UL)         /*!< I2c source clock/16 */
N#define I2C_CLK_DIV32                 (5UL)         /*!< I2c source clock/32 */
N#define I2C_CLK_DIV64                 (6UL)         /*!< I2c source clock/64 */
N#define I2C_CLK_DIV128                (7UL)         /*!< I2c source clock/128 */
N/**
N * @}
N */
N
N/**
N * @defgroup I2C_Address_Num I2C Address Number
