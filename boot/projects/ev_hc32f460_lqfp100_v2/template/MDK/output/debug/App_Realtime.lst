N * @{
N */
N
N/**
N * @defgroup EP_Port_source EP Port Source
N * @{
N */
N#define EVT_PORT_1          (0U)        /*!< Event port 1 */
N#define EVT_PORT_2          (1U)        /*!< Event port 2 */
N#define EVT_PORT_3          (2U)        /*!< Event port 3 */
N#define EVT_PORT_4          (3U)        /*!< Event port 4 */
N/**
N * @}
N */
N
N/**
N * @defgroup EP_pins_define EP Pin Source
N * @{
N */
N#define EVT_PIN_00          (0x0001U)   /*!< Event port Pin 00 */
N#define EVT_PIN_01          (0x0002U)   /*!< Event port Pin 01 */
N#define EVT_PIN_02          (0x0004U)   /*!< Event port Pin 02 */
N#define EVT_PIN_03          (0x0008U)   /*!< Event port Pin 03 */
N#define EVT_PIN_04          (0x0010U)   /*!< Event port Pin 04 */
N#define EVT_PIN_05          (0x0020U)   /*!< Event port Pin 05 */
N#define EVT_PIN_06          (0x0040U)   /*!< Event port Pin 06 */
N#define EVT_PIN_07          (0x0080U)   /*!< Event port Pin 07 */
N#define EVT_PIN_08          (0x0100U)   /*!< Event port Pin 08 */
N#define EVT_PIN_09          (0x0200U)   /*!< Event port Pin 09 */
N#define EVT_PIN_10          (0x0400U)   /*!< Event port Pin 10 */
N#define EVT_PIN_11          (0x0800U)   /*!< Event port Pin 11 */
N#define EVT_PIN_12          (0x1000U)   /*!< Event port Pin 12 */
N#define EVT_PIN_13          (0x2000U)   /*!< Event port Pin 13 */
N#define EVT_PIN_14          (0x4000U)   /*!< Event port Pin 14 */
N#define EVT_PIN_15          (0x8000U)   /*!< Event port Pin 15 */
N#define EVT_PIN_All         (0xFFFFU)   /*!< All event pins are selected */
N#define EVT_PIN_MASK        (0xFFFFU)   /*!< Event pin mask for assert test */
N/**
N * @}
N */
N
N/**
N * @defgroup EP_PinDirection_Sel EP Pin Input/Output Direction Selection
N * @{
N */
N#define EP_DIR_IN           (0UL)       /*!< EP input */
N#define EP_DIR_OUT          (1UL)       /*!< EP output */
N/**
N * @}
N */
N
N/**
N * @defgroup EP_FilterClock_Sel Event Port Filter Function Selection
N * @{
N */
N#define EP_FILTER_OFF       (0UL)       /*!< EP filter function OFF */
N
N#define EP_FILTER_ON        (1UL)       /*!< EP filter function ON */
N
N/**
N * @}
N */
N
N/**
N * @defgroup EP_FilterClock_Div Event Port Filter Sampling Clock Division Selection
N * @{
N */
N#define EP_FCLK_DIV1        (0UL)                               /*!< PCLK as EP filter clock source */
N#define EP_FCLK_DIV8        (1UL << AOS_PEVNTNFCR_DIVS1_POS)    /*!< PCLK div8 as EP filter clock source */
N#define EP_FCLK_DIV32       (2UL << AOS_PEVNTNFCR_DIVS1_POS)    /*!< PCLK div32 as EP filter clock source */
N#define EP_FCLK_DIV64       (3UL << AOS_PEVNTNFCR_DIVS1_POS)    /*!< PCLK div64 as EP filter clock source */
N/**
N * @}
N */
N
N/**
N * @defgroup EP_Trigger_Sel Event Port Trigger Edge Selection
N * @{
N */
N#define EP_TRIG_NONE        (0UL)       /*!< No Trigger by edge */
N#define EP_TRIG_FALLING     (1UL)       /*!< Trigger by falling edge */
N#define EP_TRIG_RISING      (2UL)       /*!< Trigger by rising edge */
N#define EP_TRIG_BOTH        (3UL)       /*!< Trigger by falling and rising edge */
N/**
N * @}
N */
N
N/**
N * @defgroup EP_TriggerOps_Sel Event Port Operation
N * @{
N */
N#define EP_OPS_NONE         (0UL)       /*!< Pin no action after triggered */
N#define EP_OPS_LOW          (1UL)       /*!< Pin output low after triggered */
N#define EP_OPS_HIGH         (2UL)       /*!< Pin output high after triggered */
N#define EP_OPS_TOGGLE       (3UL)       /*!< Pin toggle after triggered */
N/**
N * @}
N */
N
N/**
N * @}
N */
