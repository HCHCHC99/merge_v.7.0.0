N/**
N * @brief  GPIO lock. PSPCR, PCCR, PINAER, PCRxy, PFSRxy write disable
N * @param  None
N * @retval None
N */
N__STATIC_INLINE void GPIO_REG_Lock(void)
Xstatic __inline void GPIO_REG_Lock(void)
N{
N    WRITE_REG16(CM_GPIO->PWPR, GPIO_REG_LOCK_KEY);
X    ((((CM_GPIO_TypeDef *)(0x40053800UL))->PWPR) = ((uint16_t)((0xA500U))));
N}
N
N/**
N * @brief  GPIO unlock. PSPCR, PCCR, PINAER, PCRxy, PFSRxy write enable
N * @param  None
N * @retval None
N */
N__STATIC_INLINE void GPIO_REG_Unlock(void)
Xstatic __inline void GPIO_REG_Unlock(void)
N{
N    WRITE_REG16(CM_GPIO->PWPR, GPIO_REG_UNLOCK_KEY);
X    ((((CM_GPIO_TypeDef *)(0x40053800UL))->PWPR) = ((uint16_t)((0xA501U))));
N}
