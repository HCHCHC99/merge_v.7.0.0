N */
N
Nint32_t CMP_StructInit(stc_cmp_init_t *pstcCmpInit);
Nint32_t CMP_NormalModeInit(CM_CMP_TypeDef *CMPx, const stc_cmp_init_t *pstcCmpInit);
Nvoid CMP_DeInit(CM_CMP_TypeDef *CMPx);
N
Nvoid CMP_FuncCmd(CM_CMP_TypeDef *CMPx, en_functional_state_t enNewState);
Nvoid CMP_IntCmd(CM_CMP_TypeDef *CMPx, en_functional_state_t enNewState);
Nvoid CMP_CompareOutCmd(CM_CMP_TypeDef *CMPx, en_functional_state_t enNewState);
Nvoid CMP_PinVcoutCmd(CM_CMP_TypeDef *CMPx, en_functional_state_t enNewState);
Nen_flag_status_t CMP_GetStatus(const CM_CMP_TypeDef *CMPx);
Nvoid CMP_SetOutDetectEdge(CM_CMP_TypeDef *CMPx, uint8_t u8CmpEdges);
