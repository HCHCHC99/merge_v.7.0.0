Nuint16_t FCM_GetCountValue(CM_FCM_TypeDef *FCMx);
Nvoid FCM_SetUpperLimit(CM_FCM_TypeDef *FCMx, uint16_t u16Limit);
Nvoid FCM_SetLowerLimit(CM_FCM_TypeDef *FCMx, uint16_t u16Limit);
Nvoid FCM_SetTargetClock(CM_FCM_TypeDef *FCMx, uint32_t u32ClockSrc, uint32_t u32Div);
Nvoid FCM_SetRefClock(CM_FCM_TypeDef *FCMx, uint32_t u32ClockSrc, uint32_t u32Div);
Nen_flag_status_t FCM_GetStatus(CM_FCM_TypeDef *FCMx, uint32_t u32Flag);
Nvoid FCM_ClearStatus(CM_FCM_TypeDef *FCMx, uint32_t u32Flag);
Nvoid FCM_ResetCmd(CM_FCM_TypeDef *FCMx, en_functional_state_t enNewState);
Nvoid FCM_IntCmd(CM_FCM_TypeDef *FCMx, uint32_t u32IntType, en_functional_state_t enNewState);
Nvoid FCM_Cmd(CM_FCM_TypeDef *FCMx, en_functional_state_t enNewState);
