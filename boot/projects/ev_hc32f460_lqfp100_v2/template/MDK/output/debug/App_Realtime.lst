N#define FCM_REF_CLK_XTAL            (0x10UL << FCM_RCCR_RCKS_POS)
N#define FCM_REF_CLK_XTAL32          (0x11UL << FCM_RCCR_RCKS_POS)
N#define FCM_REF_CLK_HRC             (0x12UL << FCM_RCCR_RCKS_POS)
N#define FCM_REF_CLK_LRC             (0x13UL << FCM_RCCR_RCKS_POS)
N#define FCM_REF_CLK_SWDTLRC         (0x14UL << FCM_RCCR_RCKS_POS)
N#define FCM_REF_CLK_PCLK1           (0x15UL << FCM_RCCR_RCKS_POS)
N#define FCM_REF_CLK_UPLLP           (0x16UL << FCM_RCCR_RCKS_POS)
