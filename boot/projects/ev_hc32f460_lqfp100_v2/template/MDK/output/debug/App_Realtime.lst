N * @{
N */
N#define OTS_CLK_XTAL                    (0x0U)              /*!< Select XTAL as OTS clock. */
N#define OTS_CLK_HRC                     (OTS_CTL_OTSCK)     /*!< Select HRC as OTS clock */
N/**
N * @}
N */
N
N/**
