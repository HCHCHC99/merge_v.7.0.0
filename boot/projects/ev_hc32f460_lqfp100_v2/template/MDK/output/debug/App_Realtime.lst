N#define HC32_DDL_REV_MAIN               0x03U  /*!< [31:24] main version  */
N#define HC32_DDL_REV_SUB1               0x03U  /*!< [23:16] sub1 version  */
N#define HC32_DDL_REV_SUB2               0x00U  /*!< [15:8]  sub2 version  */
N#define HC32_DDL_REV_PATCH              0x00U  /*!< [7:0]   patch version */
N#define HC32_DDL_REV                    ((HC32_DDL_REV_MAIN << 24) | (HC32_DDL_REV_SUB1 << 16) | \
N                                         (HC32_DDL_REV_SUB2 << 8 ) | (HC32_DDL_REV_PATCH))
X#define HC32_DDL_REV                    ((HC32_DDL_REV_MAIN << 24) | (HC32_DDL_REV_SUB1 << 16) |                                          (HC32_DDL_REV_SUB2 << 8 ) | (HC32_DDL_REV_PATCH))
