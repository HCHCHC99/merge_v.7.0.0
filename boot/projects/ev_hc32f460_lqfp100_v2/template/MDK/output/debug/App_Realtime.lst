N#define I2C_SRC_CLK                   (SystemCoreClock >> ((CM_CMU->SCFGR & CMU_SCFGR_PCLK3S) >> CMU_SCFGR_PCLK3S_POS))
N
N#define I2C_WIDTH_MAX_IMME            (68UL)
N
N/**
N * @defgroup I2C_Trans_Dir I2C Transfer Direction
N * @{
N */
N#define I2C_DIR_TX                    (0x0U)
N#define I2C_DIR_RX                    (0x1U)
N/**
N * @}
N */
N
