N * @{
N */
N#define I2C_ACK                       (0UL)         /*!< Send ACK after date receive */
N#define I2C_NACK                      (I2C_CR1_ACK) /*!< Send NACK after date received */
N/**
N * @}
N */
N
N/**
N * @defgroup I2C_Smbus_Match_Config I2C SMBUS Address Match Configure
N * @{
N */
N#define I2C_SMBUS_MATCH_ALERT         (I2C_CR1_SMBALRTEN)
N#define I2C_SMBUS_MATCH_DEFAULT       (I2C_CR1_SMBDEFAULTEN)
N#define I2C_SMBUS_MATCH_HOST          (I2C_CR1_SMBHOSTEN)
N#define I2C_SMBUS_MATCH_ALL           (I2C_CR1_SMBALRTEN | I2C_CR1_SMBDEFAULTEN | I2C_CR1_SMBHOSTEN)
N/**
N * @}
N */
N
N/**
