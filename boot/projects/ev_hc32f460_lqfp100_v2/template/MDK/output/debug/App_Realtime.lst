N__STATIC_INLINE uint32_t KEYSCAN_GetKeyoutIdx(void)
Xstatic __inline uint32_t KEYSCAN_GetKeyoutIdx(void)
N{
N    return READ_REG32_BIT(CM_KEYSCAN->SSR, KEYSCAN_SSR_INDEX);
X    return ((((CM_KEYSCAN_TypeDef *)(0x40050C00UL))->SSR) & ((uint32_t)((0x00000007UL))));
N}
