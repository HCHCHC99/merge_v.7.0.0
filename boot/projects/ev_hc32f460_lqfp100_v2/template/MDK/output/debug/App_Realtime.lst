Nvoid CMP_SetOutPolarity(CM_CMP_TypeDef *CMPx, uint16_t u16CmpPolarity);
Nvoid CMP_SetPositiveInput(CM_CMP_TypeDef *CMPx, uint16_t  u16PositiveInput);
Nvoid CMP_SetNegativeInput(CM_CMP_TypeDef *CMPx, uint16_t u16NegativeInput);
N
Nuint32_t CMP_GetScanInpSrc(CM_CMP_TypeDef *CMPx);
Nint32_t CMP_ScanTimeConfig(CM_CMP_TypeDef *CMPx, uint16_t u16Stable, uint16_t u16Period);
Nvoid CMP_ScanCmd(CM_CMP_TypeDef *CMPx, en_functional_state_t enNewState);
N
Nvoid CMP_8BitDAC_Cmd(uint8_t u8Ch, en_functional_state_t enNewState);
Nvoid CMP_8BitDAC_AdcRefCmd(uint16_t u16AdcRefSw, en_functional_state_t enNewState);
N
Nvoid CMP_8BitDAC_WriteData(uint8_t u8Ch, uint16_t u16DACData);
N
