N/**
N *******************************************************************************
N * @file  hc32_ll_can.h
N * @brief This file contains all the functions prototypes of the CAN driver
N *        library.
N @verbatim
N   Change Logs:
N   Date             Author          Notes
N   2022-03-31       CDT             First version
N   2022-10-31       CDT             Deleted redundant comments
N                                    Remove CAN_FLAG_RX_BUF_OVF from CAN_FLAG_CLR_ALL
N   2023-06-30       CDT             Added 3 APIs for local-reset
N                                    Modify typo
N   2024-06-30       CDT             API CAN_DeInit() added return value
N                                    Added macro group CAN_ID_Mask
N @endverbatim
N *******************************************************************************
N * Copyright (C) 2022-2025, Xiaohua Semiconductor Co., Ltd. All rights reserved.
N *
N * This software component is licensed by XHSC under BSD 3-Clause license
N * (the "License"); You may not use this file except in compliance with the
N * License. You may obtain a copy of the License at:
N *                    opensource.org/licenses/BSD-3-Clause
N *
N *******************************************************************************
N */
N#ifndef __HC32_LL_CAN_H__
N#define __HC32_LL_CAN_H__
N
N/* C binding of definitions if building with C++ compiler */
N#ifdef __cplusplus
Sextern "C"
S{
N#endif
N
N/*******************************************************************************
N * Include files
N ******************************************************************************/
N#include "hc32_ll_def.h"
N
N#include "hc32f4xx.h"
N#include "hc32f4xx_conf.h"
N/**
N * @addtogroup LL_Driver
N * @{
N */
N
N/**
N * @addtogroup LL_CAN
N * @{
N */
N#if (LL_CAN_ENABLE == DDL_ON)
X#if (((1U)) == (1U))
N
N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup CAN_Global_Types CAN Global Types
N * @{
N */
N/**
N * @brief CAN bit time configuration structure.
N * @note 1. TQ = u32Prescaler / CANClock.
N * @note 2. Bit time = (u32TimeSeg2 + u32TimeSeg2) x TQ.
N * @note 3. Baudrate = CANClock/(u32Prescaler*(u32TimeSeg1 + u32TimeSeg2))
N * @note 4. See user manual of the target MCU and ISO11898-1 for more details.
N */
Ntypedef struct {
N    uint32_t u32Prescaler;                  /*!< Specifies the prescaler of CAN clock, [1, 256]. */
N    uint32_t u32TimeSeg1;                   /*!< Specifies the number of time quanta in Bit Segment 1.
N                                                 u32TimeSeg1 Contains synchronization segment,
N                                                 propagation time segment and phase buffer segment 1. */
N    uint32_t u32TimeSeg2;                   /*!< Specifies the number of time quanta in Bit Segment 2.
N                                                 Phase buffer segment 2. */
N    uint32_t u32SJW;                        /*!< Synchronization Jump Width.
N                                                 Specifies the maximum number of time quanta the CAN hardware
N                                                 is allowed to lengthen or shorten a bit to perform resynchronization. */
N} stc_can_bit_time_config_t;
N
N/**
N * @brief CAN acceptance filter configuration structure.
N */
Ntypedef struct {
N    uint32_t u32ID;                         /*!< Specifies the identifier(ID). 11 bits standard ID or 29 bits extended ID, depending on IDE. */
N    uint32_t u32IDMask;                     /*!< Specifies the identifier(ID) mask. The mask bits of ID will be ignored by the acceptance filter. */
N    uint32_t u32IDType;                     /*!< Specifies the identifier(ID) type. This parameter can be a value of @ref CAN_ID_Type */
N} stc_can_filter_config_t;
N
N/**
N * @brief TTCAN configuration structure.
N */
Ntypedef struct {
N    uint32_t u32RefMsgID;                   /*!< Reference message identifier. */
N    uint32_t u32RefMsgIDE;                  /*!< Reference message identifier extension bit.
N                                                 '1' to set the ID which is specified by parameter 'u32RefMsgID' as an extended ID while
N                                                 '0' to set it as a standard ID. */
N    uint8_t u8NTUPrescaler;                 /*!< Prescaler of NTU(network time unit). The source is the bit time which is defined by SBT.
N                                                 This parameter can be a value of @ref TTCAN_NTU_Prescaler */
N    uint8_t u8TxBufMode;                    /*!< TTCAN Transmit Buffer Mode.
N                                                 This parameter can be a value of @ref TTCAN_Tx_Buf_Mode */
N    uint16_t u16TriggerType;                /*!< Trigger type of TTCAN.
N                                                 This parameter can be a value of @ref TTCAN_Trigger_Type */
N    uint16_t u16TxEnableWindow;             /*!< Tx_Enable window. Time period within which the transmission of a message may be started. Range is [1, 16] */
N    uint16_t u16TxTriggerTime;              /*!< Specifies for the referred message the time window of the matrix cycle at which it is to be transmitted. Range is [0, 65535] */
N    uint16_t u16WatchTriggerTime;           /*!< Time mark used to check whether the time since the last valid reference message has been too long. Range is [0, 65535] */
N} stc_can_ttc_config_t;
N
N/**
N * @brief CAN initialization structure.
N */
Ntypedef struct {
N    stc_can_bit_time_config_t stcBitCfg;    /*!< Bit time configuration of classical CAN bit. @ref stc_can_bit_time_config_t */
N    stc_can_filter_config_t *pstcFilter;    /*!< Pointer to a @ref stc_can_filter_config_t structure that
N                                                 contains the configuration informations for the acceptance filters. */
N    uint16_t u16FilterSelect;               /*!< Selects acceptance filters.
N                                                 This parameter can be values of @ref CAN_Acceptance_Filter */
N    uint8_t u8WorkMode;                     /*!< Specifies the work mode of CAN.
N                                                 This parameter can be a value of @ref CAN_Work_Mode */
N    uint8_t u8PTBSingleShotTx;              /*!< Enable or disable single shot transmission of PTB.
N                                                 This parameter can be a value of @ref PTB_SingleShot_Tx_En */
N    uint8_t u8STBSingleShotTx;              /*!< Enable or disable single shot transmission of STB.
N                                                 This parameter can be a value of @ref STB_SingleShot_Tx_En */
N    uint8_t u8STBPrioMode;                  /*!< Enable or disable the priority decision mode of STB.
N                                                 This parameter can be a value of @ref CAN_STB_Prio_Mode_En
N                                                 NOTE: A frame in the PTB has always the highest priority regardless of the ID. */
N    uint8_t u8RxWarnLimit;                  /*!< Specifies receive buffer almost full warning limit. Rang is [1, 8].
N                                                 Each CAN unit has 8 receive buffers. When the number of received frames reaches
N                                                 the value specified by u8RxWarnLimit, register bit RTIF.RAFIF is set and the interrupt occurred
N                                                 if it was enabled. */
N    uint8_t u8ErrorWarnLimit;               /*!< Specifies programmable error warning limit. Range is [0, 15].
N                                                 Error warning limit = (u8ErrorWarnLimit + 1) * 8. */
N    uint8_t u8RxAllFrame;                   /*!< Enable or disable receive all frames(includes frames with error).
N                                                 This parameter can be a value of @ref CAN_Rx_All_En */
N    uint8_t u8RxOvfMode;                    /*!< Receive buffer overflow mode. In case of a full receive buffer when a new frame is received.
N                                                 This parameter can be a value of @ref CAN_Rx_Ovf_Mode */
N    uint8_t u8SelfAck;                      /*!< Enable or disable self-acknowledge.
N                                                 This parameter can be a value of @ref CAN_Self_ACK_En */
N
N    stc_can_ttc_config_t *pstcCanTtc;       /*!< Pointer to a TTCAN configuration structure. @ref stc_can_ttc_config_t
N                                                 Set it to NULL if not needed TTCAN. */
N} stc_can_init_t;
N
N/**
N * @brief CAN error information structure.
N */
Ntypedef struct {
N    uint8_t u8ArbitrLostPos;                /*!< Bit position in the frame where the arbitration has been lost.  */
N    uint8_t u8ErrorType;                    /*!< CAN error type. This parameter can be a value of @ref CAN_Err_Type */
N    uint8_t u8RxErrorCount;                 /*!< Receive error count. */
N    uint8_t u8TxErrorCount;                 /*!< Transmit error count. */
N} stc_can_error_info_t;
N
N/**
N * @brief CAN TX frame data structure.
N */
Ntypedef struct {
N    uint32_t u32ID;                         /*!< 11 bits standard ID or 29 bits extended ID, depending on IDE. */
N    union {
N        uint32_t u32Ctrl;
N        struct {
N            uint32_t DLC: 4;                /*!< Data length code. Length of the data segment of data frame.
N                                                 It should be zero while the frame is remote frame.
N                                                 This parameter can be a value of @ref CAN_Data_Length_Code */
N            uint32_t BRS: 1;                /*!< Bit rate switch. */
N            uint32_t FDF: 1;                /*!< CAN FD frame. */
N            uint32_t RTR: 1;                /*!< Remote transmission request bit.
N                                                 It is used to distinguish between data frames and remote frames. */
N            uint32_t IDE: 1;                /*!< Identifier extension flag.
N                                                 It is used to distinguish between standard format and extended format.
N                                                 This parameter can be a 1 or 0. */
N            uint32_t RSVD: 24;              /*!< Reserved bits. */
N        };
N    };
N    uint8_t au8Data[8U];                    /*!< TX data payload. */
N} stc_can_tx_frame_t;
N
N/**
N * @brief CAN RX frame data structure.
N */
Ntypedef struct {
N    uint32_t u32ID;                         /*!< 11 bits standard ID or 29 bits extended ID, depending on IDE. */
N    union {
N        uint32_t u32Ctrl;
N        struct {
N            uint32_t DLC: 4;                /*!< Data length code. Length of the data segment of data frame.
N                                                 It should be zero while the frame is remote frame.
N                                                 This parameter can be a value of @ref CAN_Data_Length_Code */
N            uint32_t BRS: 1;                /*!< Bit rate switch. */
N            uint32_t FDF: 1;                /*!< CAN FD frame. */
N            uint32_t RTR: 1;                /*!< Remote transmission request bit.
N                                                 It is used to distinguish between data frames and remote frames. */
N            uint32_t IDE: 1;                /*!< Identifier extension flag.
N                                                 It is used to distinguish between standard format and extended format.
N                                                 This parameter can be 1 or 0. */
N            uint32_t RSVD: 4;               /*!< Reserved bits. */
N            uint32_t TX: 1;                 /*!< This bit is set to 1 when receiving self-transmitted data in loopback mode. */
N            uint32_t ERRT: 3;               /*!< Error type. */
N            uint32_t CYCLE_TIME: 16;        /*!< Cycle time of time-triggered communication(TTC). */
N        };
N    };
N    uint8_t au8Data[8U];                    /*!< RX data payload. */
N} stc_can_rx_frame_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup CAN_Global_Macros CAN Global Macros
N * @{
N */
N
N/**
N * @defgroup CAN_Work_Mode CAN Work Mode
N * @{
N */
N#define CAN_WORK_MD_NORMAL              (0U)                    /*!< Normal work mode. */
N#define CAN_WORK_MD_SILENT              (1U)                    /*!< Silent work mode. Prohibit data transmission. */
N#define CAN_WORK_MD_ILB                 (2U)                    /*!< Internal loop back mode, just for self-test while developing. */
N#define CAN_WORK_MD_ELB                 (3U)                    /*!< External loop back mode, just for self-test while developing. */
N#define CAN_WORK_MD_ELB_SILENT          (4U)                    /*!< External loop back silent mode, just for self-test while developing.
N                                                                     It is forbidden to respond to received frames and error frames,
N                                                                     but data can be transmitted. */
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_Tx_Buf_Type CAN Transmit Buffer Type
N * @{
N */
N#define CAN_TX_BUF_PTB                  (0U)                    /*!< Primary transmit buffer. */
N#define CAN_TX_BUF_STB                  (1U)                    /*!< Secondary transmit buffer. */
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_Data_Length_Code CAN Data Length Code
N * @{
N */
N#define CAN_DLC0                        (0x0U)                  /*!< CAN2.0 and CAN FD: the size of data field is 0 bytes. */
N#define CAN_DLC1                        (0x1U)                  /*!< CAN2.0 and CAN FD: the size of data field is 1 bytes. */
N#define CAN_DLC2                        (0x2U)                  /*!< CAN2.0 and CAN FD: the size of data field is 2 bytes. */
N#define CAN_DLC3                        (0x3U)                  /*!< CAN2.0 and CAN FD: the size of data field is 3 bytes. */
N#define CAN_DLC4                        (0x4U)                  /*!< CAN2.0 and CAN FD: the size of data field is 4 bytes. */
N#define CAN_DLC5                        (0x5U)                  /*!< CAN2.0 and CAN FD: the size of data field is 5 bytes. */
N#define CAN_DLC6                        (0x6U)                  /*!< CAN2.0 and CAN FD: the size of data field is 6 bytes. */
N#define CAN_DLC7                        (0x7U)                  /*!< CAN2.0 and CAN FD: the size of data field is 7 bytes. */
N#define CAN_DLC8                        (0x8U)                  /*!< CAN2.0 and CAN FD: the size of data field is 8 bytes. */
N/**
N * @}
N */
N
N/**
N * @defgroup PTB_SingleShot_Tx_En PTB Single Shot Transmission Function Control
N * @{
N */
N#define CAN_PTB_SINGLESHOT_TX_DISABLE   (0x0U)                  /*!< Primary transmit buffer auto retransmit. */
N#define CAN_PTB_SINGLESHOT_TX_ENABLE    (CAN_CFG_STAT_TPSS)     /*!< Primary transmit buffer single short transmit. */
N/**
N * @}
N */
N
N/**
N * @defgroup STB_SingleShot_Tx_En STB Single Shot Transmission Function Control
N * @{
N */
N#define CAN_STB_SINGLESHOT_TX_DISABLE   (0x0U)                  /*!< Secondary transmit buffer auto retransmit. */
N#define CAN_STB_SINGLESHOT_TX_ENABLE    (CAN_CFG_STAT_TSSS)     /*!< Secondary transmit buffer single short transmit. */
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_Tx_Request CAN Transmission Request
N * @{
N */
N#define CAN_TX_REQ_STB_ONE              (CAN_TCMD_TSONE)        /*!< Transmit one STB frame. */
N#define CAN_TX_REQ_STB_ALL              (CAN_TCMD_TSALL)        /*!< Transmit all STB frames. */
N#define CAN_TX_REQ_PTB                  (CAN_TCMD_TPE)          /*!< Transmit PTB frame. */
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_STB_Prio_Mode_En CAN STB Priority Mode Function Control
N * @note A frame in the PTB has always the highest priority regardless of the ID.
N * @{
N */
N#define CAN_STB_PRIO_MD_DISABLE         (0x0U)                  /*!< The frame first in will first be transmitted. */
N#define CAN_STB_PRIO_MD_ENABLE          (CAN_TCTRL_TSMODE)      /*!< The frame with lower ID will first be transmitted. */
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_Tx_Buf_Status CAN Transmit Buffer Status
N * @{
N */
N#define CAN_TX_BUF_EMPTY                (0x0U)                  /*!< TTCAN is disabled(TTEN == 0): STB is empty.
N                                                                     TTCAN is disabled(TTEN == 1) and transmit buffer is specified by TBPTR and TTPTR(TTTBM == 1):
N                                                                     PTB and STB are both empty. */
N#define CAN_TX_BUF_NOT_MORE_THAN_HALF   (0x1U)                  /*!< TTEN == 0: STB is less than or equal to half full;
N                                                                     TTEN == 1 && TTTBM == 1: PTB and STB are neither empty. */
N#define CAN_TX_BUF_MORE_THAN_HALF       (0x2U)                  /*!< TTEN == 0: STB is more than half full;
N                                                                     TTEN == 1 && TTTBM == 1: reserved value. */
N#define CAN_TX_BUF_FULL                 (0x3U)                  /*!< TTEN == 0: STB is full;
N                                                                     TTEN == 1 && TTTBM == 1: PTB and STB are both full. */
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_Rx_Buf_Status CAN Receive Buffer Status
N * @{
N */
N#define CAN_RX_BUF_EMPTY                (0x0U)                  /*!< Receive buffer is empty. */
N#define CAN_RX_BUF_NOT_WARN             (0x1U)                  /*!< Receive buffer is not empty, but is less than almost full warning limit. */
N#define CAN_RX_BUF_WARN                 (0x2U)                  /*!< Receive buffer is not full and not overflow, but is more than or equal to almost full warning limit. */
N#define CAN_RX_BUF_FULL                 (0x3U)                  /*!< Receive buffer is full. */
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_Rx_All_En CAN Receive All Frames
N * @{
N */
N#define CAN_RX_ALL_FRAME_DISABLE        (0x0U)                  /*!< Only receives correct frames. */
N#define CAN_RX_ALL_FRAME_ENABLE         (CAN_RCTRL_RBALL)       /*!< Receives all frames, including frames with error. */
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_Rx_Ovf_Mode CAN Receive Buffer Overflow Mode
N * @{
N */
N#define CAN_RX_OVF_SAVE_NEW             (0x0U)                  /*!< Saves the newly received data and the oldest frame will be overwritten. */
N#define CAN_RX_OVF_DISCARD_NEW          (CAN_RCTRL_ROM)         /*!< Discard the newly received data. */
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_Self_ACK_En CAN Self-ACK Function Control
N * @{
N */
N#define CAN_SELF_ACK_DISABLE            (0x0U)                  /*!< Disable self-acknowledge. */
N#define CAN_SELF_ACK_ENABLE             (CAN_RCTRL_SACK)        /*!< Enable self-acknowledge. */
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_Interrupt_Type CAN Interrupt Type
N * @{
N */
N#define CAN_INT_ERR_INT                 (1UL << 1U)             /*!< Register bit RTIE.EIE. The interrupt RTIF.EIF will be set if enabled by RTIE.EIE under the following conditions:
N                                                                     The border of the error warning limit has been crossed in either direction by RECNT or TECNT or
N                                                                     the BUSOFF bit has been changed in either direction. */
N#define CAN_INT_STB_TX                  (1UL << 2U)             /*!< Register bit RTIE.TSIE. STB was transmitted. */
N#define CAN_INT_PTB_TX                  (1UL << 3U)             /*!< Register bit RTIE.TPIE. PTB was transmitted. */
N#define CAN_INT_RX_BUF_WARN             (1UL << 4U)             /*!< Register bit RTIE.RAFIE. The number of filled RB slot is greater than or equal to the LIMIT.AFWL setting value. */
N#define CAN_INT_RX_BUF_FULL             (1UL << 5U)             /*!< Register bit RTIE.RFIE. The FIFO of receive buffer is full. */
N#define CAN_INT_RX_OVERRUN              (1UL << 6U)             /*!< Register bit RTIE.ROIE. Receive buffers are full and there is a further message to be stored. */
N#define CAN_INT_RX                      (1UL << 7U)             /*!< Register bit RTIE.RIE. Received a valid data frame or remote frame. */
N#define CAN_INT_BUS_ERR                 (1UL << 9U)             /*!< Register bit ERRINT.BEIE. Each of the error defined by EALCAP.KOER can cause bus-error interrupt. */
N#define CAN_INT_ARBITR_LOST             (1UL << 11U)            /*!< Register bit ERRINT.ALIE. Arbitration lost. */
N#define CAN_INT_ERR_PASSIVE             (1UL << 13U)            /*!< Register bit ERRINT.EPIE. A change from error-passive to error-active or error-active to error-passive has occurred. */
N
N#define CAN_INT_ALL                     (CAN_INT_ERR_INT     | \
N                                         CAN_INT_STB_TX      | \
N                                         CAN_INT_PTB_TX      | \
N                                         CAN_INT_RX_BUF_WARN | \
N                                         CAN_INT_RX_BUF_FULL | \
N                                         CAN_INT_RX_OVERRUN  | \
N                                         CAN_INT_RX          | \
N                                         CAN_INT_BUS_ERR     | \
N                                         CAN_INT_ARBITR_LOST | \
N                                         CAN_INT_ERR_PASSIVE)
X#define CAN_INT_ALL                     (CAN_INT_ERR_INT     |                                          CAN_INT_STB_TX      |                                          CAN_INT_PTB_TX      |                                          CAN_INT_RX_BUF_WARN |                                          CAN_INT_RX_BUF_FULL |                                          CAN_INT_RX_OVERRUN  |                                          CAN_INT_RX          |                                          CAN_INT_BUS_ERR     |                                          CAN_INT_ARBITR_LOST |                                          CAN_INT_ERR_PASSIVE)
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_Status_Flag CAN Status Flag
N * @{
N */
N#define CAN_FLAG_BUS_OFF                (1UL << 0U)             /*!< Register bit CFG_STAT.BUSOFF. CAN bus off. */
N#define CAN_FLAG_TX_GOING               (1UL << 1U)             /*!< Register bit CFG_STAT.TACTIVE. CAN bus is transmitting. */
N#define CAN_FLAG_RX_GOING               (1UL << 2U)             /*!< Register bit CFG_STAT.RACTIVE. CAN bus is receiving. */
N#define CAN_FLAG_RX_BUF_OVF             (1UL << 5U)             /*!< Register bit RCTRL.ROV. Receive buffer is full and there is a further bit to be stored. At least one frame will be lost. */
N#define CAN_FLAG_TX_BUF_FULL            (1UL << 8U)             /*!< Register bit RTIE.TSFF. Transmit buffers are all full.
N                                                                     TTCFG.TTEN == 0 or TCTRL.TTTEM == 0: ALL STB slots are filled.
N                                                                     TTCFG.TTEN == 1 and TCTRL.TTTEM == 1: Transmit buffer that pointed by TBSLOT.TBPTR is filled.*/
N#define CAN_FLAG_TX_ABORTED             (1UL << 16U)            /*!< Register bit RTIF.AIF. Transmit messages requested via TCMD.TPA and TCMD.TSA were successfully canceled. */
N#define CAN_FLAG_ERR_INT                (1UL << 17U)            /*!< Register bit RTIF.EIF. The interrupt RTIF.EIF will be set if enabled by RTIE.EIE under the following conditions:
N                                                                     The border of the error warning limit has been crossed in either direction by RECNT or TECNT or
N                                                                     the BUSOFF bit has been changed in either direction. */
N#define CAN_FLAG_STB_TX                 (1UL << 18U)            /*!< Register bit RTIF.TSIF. STB was transmitted. */
N#define CAN_FLAG_PTB_TX                 (1UL << 19U)            /*!< Register bit RTIF.TPIF. PTB was transmitted. */
N#define CAN_FLAG_RX_BUF_WARN            (1UL << 20U)            /*!< Register bit RTIF.RAFIF. The number of filled RB slot is greater than or equal to the LIMIT.AFWL setting value. */
N#define CAN_FLAG_RX_BUF_FULL            (1UL << 21U)            /*!< Register bit RTIF.RFIF. The FIFO of receive buffer is full. */
N#define CAN_FLAG_RX_OVERRUN             (1UL << 22U)            /*!< Register bit RTIF.ROIF. Receive buffers are all full and there is a further message to be stored. */
N#define CAN_FLAG_RX                     (1UL << 23U)            /*!< Register bit RTIF.RIF. Received a valid data frame or remote frame. */
N#define CAN_FLAG_BUS_ERR                (1UL << 24U)            /*!< Register bit ERRINT.BEIF. Each of the error defined by EALCAP.KOER can make this flag set. */
N#define CAN_FLAG_ARBITR_LOST            (1UL << 26U)            /*!< Register bit ERRINT.ALIF. Arbitration lost. */
N#define CAN_FLAG_ERR_PASSIVE            (1UL << 28U)            /*!< Register bit ERRINT.EPIF. A change from error-passive to error-active or error-active to error-passive has occurred. */
N#define CAN_FLAG_ERR_PASSIVE_NODE       (1UL << 30U)            /*!< Register bit ERRINT.EPASS. The node is an error-passive node. */
N#define CAN_FLAG_TEC_REC_WARN           (1UL << 31U)            /*!< Register bit ERRINT.EWARN. REC or TEC is greater than or equal to the LIMIT.EWL setting value. */
N
N#define CAN_FLAG_ALL                    (CAN_FLAG_BUS_OFF          | \
N                                         CAN_FLAG_TX_GOING         | \
N                                         CAN_FLAG_RX_GOING         | \
N                                         CAN_FLAG_RX_BUF_OVF       | \
N                                         CAN_FLAG_TX_BUF_FULL      | \
N                                         CAN_FLAG_TX_ABORTED       | \
N                                         CAN_FLAG_ERR_INT          | \
N                                         CAN_FLAG_STB_TX           | \
N                                         CAN_FLAG_PTB_TX           | \
N                                         CAN_FLAG_RX_BUF_WARN      | \
N                                         CAN_FLAG_RX_BUF_FULL      | \
N                                         CAN_FLAG_RX_OVERRUN       | \
N                                         CAN_FLAG_RX               | \
N                                         CAN_FLAG_BUS_ERR          | \
N                                         CAN_FLAG_ARBITR_LOST      | \
N                                         CAN_FLAG_ERR_PASSIVE      | \
N                                         CAN_FLAG_ERR_PASSIVE_NODE | \
N                                         CAN_FLAG_TEC_REC_WARN)
X#define CAN_FLAG_ALL                    (CAN_FLAG_BUS_OFF          |                                          CAN_FLAG_TX_GOING         |                                          CAN_FLAG_RX_GOING         |                                          CAN_FLAG_RX_BUF_OVF       |                                          CAN_FLAG_TX_BUF_FULL      |                                          CAN_FLAG_TX_ABORTED       |                                          CAN_FLAG_ERR_INT          |                                          CAN_FLAG_STB_TX           |                                          CAN_FLAG_PTB_TX           |                                          CAN_FLAG_RX_BUF_WARN      |                                          CAN_FLAG_RX_BUF_FULL      |                                          CAN_FLAG_RX_OVERRUN       |                                          CAN_FLAG_RX               |                                          CAN_FLAG_BUS_ERR          |                                          CAN_FLAG_ARBITR_LOST      |                                          CAN_FLAG_ERR_PASSIVE      |                                          CAN_FLAG_ERR_PASSIVE_NODE |                                          CAN_FLAG_TEC_REC_WARN)
N
N#define CAN_FLAG_CLR_ALL                (CAN_FLAG_TX_ABORTED       | \
N                                         CAN_FLAG_ERR_INT          | \
N                                         CAN_FLAG_STB_TX           | \
N                                         CAN_FLAG_PTB_TX           | \
N                                         CAN_FLAG_RX_BUF_WARN      | \
N                                         CAN_FLAG_RX_BUF_FULL      | \
N                                         CAN_FLAG_RX_OVERRUN       | \
N                                         CAN_FLAG_RX               | \
N                                         CAN_FLAG_BUS_ERR          | \
N                                         CAN_FLAG_ARBITR_LOST      | \
N                                         CAN_FLAG_ERR_PASSIVE)
X#define CAN_FLAG_CLR_ALL                (CAN_FLAG_TX_ABORTED       |                                          CAN_FLAG_ERR_INT          |                                          CAN_FLAG_STB_TX           |                                          CAN_FLAG_PTB_TX           |                                          CAN_FLAG_RX_BUF_WARN      |                                          CAN_FLAG_RX_BUF_FULL      |                                          CAN_FLAG_RX_OVERRUN       |                                          CAN_FLAG_RX               |                                          CAN_FLAG_BUS_ERR          |                                          CAN_FLAG_ARBITR_LOST      |                                          CAN_FLAG_ERR_PASSIVE)
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_ID_Type CAN Identifier Type
N * @{
N */
N#define CAN_ID_STD_EXT                  (0x0U)                  /*!< Acceptance filter accept frames with both standard ID and extended ID. */
N#define CAN_ID_STD                      (CAN_ACF_AIDEE)         /*!< Acceptance filter accept frames with only standard ID. */
N#define CAN_ID_EXT                      (CAN_ACF_AIDEE | \
N                                         CAN_ACF_AIDE)          /*!< Acceptance filter accept frames with only extended ID. */
X#define CAN_ID_EXT                      (CAN_ACF_AIDEE |                                          CAN_ACF_AIDE)           
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_ID_Mask CAN ID Mask
N * @{
N */
N#define CAN_STD_ID_MASK                (0x7FFUL)                /*!< Standard ID mask */
N#define CAN_EXT_ID_MASK                (0x1FFFFFFFUL)           /*!< Extended ID mask */
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_Err_Type CAN Error Type
N * @{
N */
N#define CAN_ERR_NONE                    (0U)                    /*!< No error. */
N#define CAN_ERR_BIT                     (0x1U)                  /*!< Error is bit error. */
N#define CAN_ERR_FORM                    (0x2U)                  /*!< Error is form error. */
N#define CAN_ERR_STUFF                   (0x3U)                  /*!< Error is stuff error. */
N#define CAN_ERR_ACK                     (0x4U)                  /*!< Error is ACK error. */
N#define CAN_ERR_CRC                     (0x5U)                  /*!< Error is CRC error. */
N#define CAN_ERR_OTHER                   (0x6U)                  /*!< Error is other error.
N                                                                     Dominant bits after own error flag, received active Error Flag too long,
N                                                                     dominant bit during Passive-Error-Flag after ACK error. */
N/**
N * @}
N */
N
N/**
N * @defgroup CAN_Acceptance_Filter CAN Acceptance Filter
N * @{
N */
N#define CAN_FILTER1                     (CAN_ACFEN_AE_1)        /*!< Acceptance filter 1 select bit. */
N#define CAN_FILTER2                     (CAN_ACFEN_AE_2)        /*!< Acceptance filter 2 select bit. */
N#define CAN_FILTER3                     (CAN_ACFEN_AE_3)        /*!< Acceptance filter 3 select bit. */
N#define CAN_FILTER4                     (CAN_ACFEN_AE_4)        /*!< Acceptance filter 4 select bit. */
N#define CAN_FILTER5                     (CAN_ACFEN_AE_5)        /*!< Acceptance filter 5 select bit. */
N#define CAN_FILTER6                     (CAN_ACFEN_AE_6)        /*!< Acceptance filter 6 select bit. */
N#define CAN_FILTER7                     (CAN_ACFEN_AE_7)        /*!< Acceptance filter 7 select bit. */
N#define CAN_FILTER8                     (CAN_ACFEN_AE_8)        /*!< Acceptance filter 8 select bit. */
N#define CAN_FILTER_ALL                  (0xFFU)
N/**
N * @}
N */
N
N/**
N * @defgroup TTCAN_Tx_Buf_Mode TTCAN Transmit Buffer Mode
N * @{
N */
N#define CAN_TTC_TX_BUF_MD_CAN           (0x0U)                  /*!< Normal CAN mode. TTCAN transmit buffer depends on the priority mode of STB which is defined by @ref CAN_STB_Prio_Mode_En */
N#define CAN_TTC_TX_BUF_MD_TTCAN         (CAN_TCTRL_TTTBM)       /*!< Full TTCAN mode. TTCAN transmit buffer is pointed by TBSLOT.TBPTR(for data filling) and
N                                                                     TRG_CFG.TTPTR(for data transmission). */
N/**
N * @}
N */
N
N/**
N * @defgroup TTCAN_Tx_Buf_Sel TTCAN Transmit Buffer Selection
N * @{
N */
N#define CAN_TTC_TX_BUF_PTB              (0x0U)                  /*!< Point to PTB. */
N#define CAN_TTC_TX_BUF_STB1             (0x1U)                  /*!< Point to STB slot 1. */
N#define CAN_TTC_TX_BUF_STB2             (0x2U)                  /*!< Point to STB slot 2. */
N#define CAN_TTC_TX_BUF_STB3             (0x3U)                  /*!< Point to STB slot 3. */
N#define CAN_TTC_TX_BUF_STB4             (0x4U)                  /*!< Point to STB slot 4. */
N/**
N * @}
N */
N
N/**
N * @defgroup TTCAN_Tx_Buf_Mark_State TTCAN Transmit Buffer Mark State
N * @{
N */
N#define CAN_TTC_TX_BUF_MARK_EMPTY       (CAN_TBSLOT_TBE)        /*!< Marks the transmit buffer selected by TBSLOT.TBPTR as "empty".
N                                                                     TBE is automatically reset to 0 as soon as the slot is marked as empty and TSFF=0.
N                                                                     If a transmission from this slot is active, then TBE stays set as long as either the
N                                                                     transmission completes or after a transmission error or arbitration loss the transmission
N                                                                     is not active any more. If both TBF and TBE are set, then TBE wins. */
N#define CAN_TTC_TX_BUF_MARK_FILLED      (CAN_TBSLOT_TBF)        /*!< Marks the transmit buffer selected by TBSLOT.TBPTR as "filled".
N                                                                     TBF is automatically reset to 0 as soon as the slot is marked as filled and RTIE.TSFF=1.
N                                                                     If both TBF and TBE are set, then TBE wins. */
N/**
N * @}
N */
N
N/**
N * @defgroup TTCAN_Interrupt_Type TTCAN Interrupt Type
N * @{
N */
N#define CAN_TTC_INT_TIME_TRIG           (CAN_TTCFG_TTIE)        /*!< Time trigger interrupt. */
N#define CAN_TTC_INT_WATCH_TRIG          (CAN_TTCFG_WTIE)        /*!< Watch trigger interrupt. */
N#define CAN_TTC_INT_ALL                 (CAN_TTC_INT_TIME_TRIG | \
N                                         CAN_TTC_INT_WATCH_TRIG)
X#define CAN_TTC_INT_ALL                 (CAN_TTC_INT_TIME_TRIG |                                          CAN_TTC_INT_WATCH_TRIG)
N/**
N * @}
N */
N
N/**
N * @defgroup TTCAN_Status_Flag TTCAN Status Flag
N * @{
N */
N#define CAN_TTC_FLAG_TIME_TRIG          (CAN_TTCFG_TTIF)        /*!< Time trigger interrupt flag. */
N#define CAN_TTC_FLAG_TRIG_ERR           (CAN_TTCFG_TEIF)        /*!< Trigger error interrupt flag. */
N#define CAN_TTC_FLAG_WATCH_TRIG         (CAN_TTCFG_WTIF)        /*!< Watch trigger interrupt flag. */
N
N#define CAN_TTC_FLAG_ALL                (CAN_TTC_FLAG_TIME_TRIG | \
N                                         CAN_TTC_FLAG_TRIG_ERR  | \
N                                         CAN_TTC_FLAG_WATCH_TRIG)
X#define CAN_TTC_FLAG_ALL                (CAN_TTC_FLAG_TIME_TRIG |                                          CAN_TTC_FLAG_TRIG_ERR  |                                          CAN_TTC_FLAG_WATCH_TRIG)
N/**
N * @}
N */
N
N/**
N * @defgroup TTCAN_NTU_Prescaler TTCAN Network Time Unit Prescaler
N * @{
N */
N#define CAN_TTC_NTU_PRESCALER1          (0x0U)                  /*!< NTU is SBT bit time * 1. */
N#define CAN_TTC_NTU_PRESCALER2          (CAN_TTCFG_T_PRESC_0)   /*!< NTU is SBT bit time * 2. */
N#define CAN_TTC_NTU_PRESCALER4          (CAN_TTCFG_T_PRESC_1)   /*!< NTU is SBT bit time * 4. */
N#define CAN_TTC_NTU_PRESCALER8          (CAN_TTCFG_T_PRESC)     /*!< NTU is SBT bit time * 8. */
N/**
N * @}
N */
N
N/**
N * @defgroup TTCAN_Trigger_Type TTCAN Trigger Type
N * @note Except for the immediate trigger, all triggers set TTIF if TTIE is enabled.
N * @{
N */
N#define CAN_TTC_TRIG_IMMED_TRIG         (0x0U)                  /*!< Immediate trigger for immediate transmission. */
N#define CAN_TTC_TRIG_TIME_TRIG          (CAN_TRG_CFG_TTYPE_0)   /*!< Time trigger for receive triggers. */
N#define CAN_TTC_TRIG_SINGLESHOT_TX_TRIG (CAN_TRG_CFG_TTYPE_1)   /*!< Single shot transmit trigger for exclusive time windows. */
N#define CAN_TTC_TRIG_TX_START_TRIG      (CAN_TRG_CFG_TTYPE_1 | \
N                                         CAN_TRG_CFG_TTYPE_0)   /*!< Transmit start trigger for merged arbitrating time windows. */
X#define CAN_TTC_TRIG_TX_START_TRIG      (CAN_TRG_CFG_TTYPE_1 |                                          CAN_TRG_CFG_TTYPE_0)    
N#define CAN_TTC_TRIG_TX_STOP_TRIG       (CAN_TRG_CFG_TTYPE_2)   /*!< Transmit stop trigger for merged arbitrating time windows. */
N/**
N * @}
N */
N
N/**
N * @}
N */
N
