N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup TMR6_Global_Types TMR6 Global Types
N * @{
N */
N
N/**
N * @brief Timer6 count function structure definition
N */
Ntypedef struct {
N    uint8_t u8CountSrc;             /*!< Specifies the count source @ref TMR6_Count_Src_Define */
N    struct {
N        uint32_t u32ClockDiv;   /*!< Count clock division select, @ref TMR6_Count_Clock_Define */
N        uint32_t u32CountMode;  /*!< Count mode, @ref TMR6_Count_Mode_Define */
N        uint32_t u32CountDir;   /*!< Count direction, @ref TMR6_Count_Dir_Define */
N    } sw_count;
N    struct {
N        uint32_t u32CountUpCond;   /*!< Hardware count up condition. @ref TMR6_HW_Count_Up_Cond_Define */
N        uint32_t u32CountDownCond; /*!< Hardware count down condition. @ref TMR6_HW_Count_Down_Cond_Define */
N    } hw_count;
N    uint32_t u32PeriodValue;        /*!< The period reference value. (0x00 ~ 0xFFFF) or (0x00 ~ 0xFFFFFFFF) */
N} stc_tmr6_init_t;
N
N/**
N * @brief Timer6 pwm output function structure definition
N */
Ntypedef struct {
N    uint32_t u32CompareValue;               /*!< Range (0 ~ 0xFFFF) or (0 ~ 0xFFFFFFFF) */
N    uint32_t u32StartPolarity;              /*!< Pin polarity when count start @ref TMR6_Pin_Polarity_Define */
N    uint32_t u32StopPolarity;               /*!< Pin polarity when count stop @ref TMR6_Pin_Polarity_Define */
N    uint32_t u32CompareMatchPolarity;       /*! Pin polarity when compare register @ref TMR6_Pin_Polarity_Define */
N    uint32_t u32PeriodMatchPolarity;        /*! Pin polarity when period register @ref TMR6_Pin_Polarity_Define */
N    uint32_t u32StartStopHold;              /*! Pin polarity hold when count re-start or re-stop \
N                                               @ref TMR6_Output_StaStp_Hold_Define */
X    uint32_t u32StartStopHold;               
N} stc_tmr6_pwm_init_t;
N
N/**
N * @brief Timer6 buffer function configuration structure definition
N */
Ntypedef struct {
N    uint32_t u32BufNum;             /*!< The buffer number, and this parameter can be a value of \
N                                         @ref TMR6_Buf_Num_Define */
X    uint32_t u32BufNum;              
N    uint32_t u32BufTransCond;       /*!< The buffer send time, and this parameter can be a value of \
N                                         @ref TMR6_Buf_Trans_Cond_Define */
X    uint32_t u32BufTransCond;        
N} stc_tmr6_buf_config_t;
N
N/**
N * @brief Timer6 Valid period function configuration structure definition
N */
Ntypedef struct {
N    uint32_t u32CountCond;          /*!< The count condition, and this parameter can be a value of \
N                                          @ref TMR6_Valid_Period_Count_Cond_Define */
X    uint32_t u32CountCond;           
N    uint32_t u32PeriodInterval;     /*!< The interval of the valid period @ref TMR6_Valid_Period_Count_Define */
N} stc_tmr6_valid_period_config_t;
N
N/**
N * @brief Timer6 EMB configuration structure definition
N */
Ntypedef struct {
N    uint32_t u32PinStatus;          /*!< Pin output status when EMB event valid @ref TMR6_Emb_Pin_Status_Define */
N} stc_tmr6_emb_config_t;
N
N/**
N * @brief Timer6 Dead time function configuration structure definition
N */
Ntypedef struct {
N    uint32_t u32EqualUpDown;        /*!< Enable down count dead time register equal to up count DT register \
N                                         @ref TMR6_DeadTime_Reg_Equal_Func_Define */
X    uint32_t u32EqualUpDown;         
N    uint32_t u32BufUp;              /*!< Enable buffer transfer for up count dead time register (DTUBR-->DTUAR) \
N                                         @ref TMR6_DeadTime_CountUp_Buf_Func_Define*/
X    uint32_t u32BufUp;               
N    uint32_t u32BufDown;            /*!< Enable buffer transfer for down count dead time register (DTDBR-->DTDAR) \
N                                         @ref TMR6_DeadTime_CountDown_Buf_Func_Define*/
X    uint32_t u32BufDown;             
N} stc_tmr6_deadtime_config_t;
N
N/**
N * @brief Timer6 Dead time function configuration structure definition
N */
Ntypedef struct {
N    uint32_t u32ZMaskCycle;         /*!< Z phase input mask periods selection @ref TMR6_Zmask_Cycle_Define */
N    uint32_t u32PosCountMaskFunc;   /*!< As position count timer, clear function enable(TRUE) or disable(FALSE) during \
N                                         the time of Z phase input mask @ref TMR6_Zmask_Pos_Unit_Clear_Func_Define */
X    uint32_t u32PosCountMaskFunc;    
N    uint32_t u32RevoCountMaskFunc;  /*!< As revolution count timer, the counter function enable(TRUE) or disable(FALSE) \
N                                         during the time of Z phase input mask \
N                                         @ref TMR6_Zmask_Revo_Unit_Count_Func_Define*/
X    uint32_t u32RevoCountMaskFunc;   
N} stc_tmr6_zmask_config_t;
N
