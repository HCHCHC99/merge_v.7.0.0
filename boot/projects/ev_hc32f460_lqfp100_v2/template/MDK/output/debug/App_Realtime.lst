N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup INTC_Global_Types INTC Global Types
N * @{
N */
N
N/**
N * @brief  Interrupt registration structure definition
N */
Ntypedef struct {
N    en_int_src_t enIntSrc;  /*!< Peripheral interrupt number, can be any value @ref en_int_src_t    */
N    IRQn_Type enIRQn;       /*!< Peripheral IRQ type, can be INT000_IRQn~INT127_IRQn @ref IRQn_Type */
N    func_ptr_t pfnCallback; /*!< Callback function for corresponding peripheral IRQ                 */
N} stc_irq_signin_config_t;
N
N/**
N * @brief  NMI initialize configuration structure definition
N */
Ntypedef struct {
N    uint32_t u32Src;            /*!< NMI trigger source, @ref NMI_TriggerSrc_Sel for details */
N    uint32_t u32Edge;           /*!< NMI pin trigger edge, @ref NMI_Trigger_level_Sel for details */
N    uint32_t u32Filter;         /*!< NMI filter function setting, @ref NMI_FilterClock_Sel for details */
N    uint32_t u32FilterClock;    /*!< NMI filter clock division, @ref NMI_FilterClock_Div for details */
N} stc_nmi_init_t;
N
N/**
N * @brief  EXTINT initialize configuration structure definition
N */
Ntypedef struct {
N    uint32_t u32Filter;         /*!< ExtInt filter (A) function setting, @ref EXTINT_FilterClock_Sel for details */
N    uint32_t u32FilterClock;    /*!< ExtInt filter (A) clock division, @ref EXTINT_FilterClock_Div for details */
N    uint32_t u32Edge;           /*!< ExtInt trigger edge, @ref EXTINT_Trigger_Sel for details */
N} stc_extint_init_t;
N
N/**
N * @}
N */
N
