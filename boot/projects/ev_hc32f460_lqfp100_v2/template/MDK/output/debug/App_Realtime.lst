Nvoid I2C_SmbusCmd(CM_I2C_TypeDef *I2Cx, en_functional_state_t enNewState);
N
Nvoid I2C_DigitalFilterConfig(CM_I2C_TypeDef *I2Cx, uint32_t u32FilterClock);
Nvoid I2C_DigitalFilterCmd(CM_I2C_TypeDef *I2Cx, en_functional_state_t enNewState);
N
Nvoid I2C_AnalogFilterCmd(CM_I2C_TypeDef *I2Cx, en_functional_state_t enNewState);
N
Nvoid I2C_GeneralCallCmd(CM_I2C_TypeDef *I2Cx, en_functional_state_t enNewState);
Nvoid I2C_SWResetCmd(CM_I2C_TypeDef *I2Cx, en_functional_state_t enNewState);
Nvoid I2C_IntCmd(CM_I2C_TypeDef *I2Cx, uint32_t u32IntType, en_functional_state_t enNewState);
N
N/* Start/Restart/Stop ************************************************/
Nvoid I2C_GenerateStart(CM_I2C_TypeDef *I2Cx);
Nvoid I2C_GenerateRestart(CM_I2C_TypeDef *I2Cx);
Nvoid I2C_GenerateStop(CM_I2C_TypeDef *I2Cx);
N
N/* Status management *************************************************/
Nen_flag_status_t I2C_GetStatus(const CM_I2C_TypeDef *I2Cx, uint32_t u32Flag);
Nvoid I2C_ClearStatus(CM_I2C_TypeDef *I2Cx, uint32_t u32Flag);
N
N/* Data transfer *****************************************************/
Nvoid I2C_WriteData(CM_I2C_TypeDef *I2Cx, uint8_t u8Data);
Nuint8_t I2C_ReadData(const CM_I2C_TypeDef *I2Cx);
Nvoid I2C_AckConfig(CM_I2C_TypeDef *I2Cx, uint32_t u32AckConfig);
N
N/* Time out function *************************************************/
Nvoid I2C_SCLHighTimeoutConfig(CM_I2C_TypeDef *I2Cx, uint16_t u16TimeoutH);
Nvoid I2C_SCLLowTimeoutConfig(CM_I2C_TypeDef *I2Cx, uint16_t u16TimeoutL);
Nvoid I2C_SCLHighTimeoutCmd(CM_I2C_TypeDef *I2Cx, en_functional_state_t enNewState);
Nvoid I2C_SCLLowTimeoutCmd(CM_I2C_TypeDef *I2Cx, en_functional_state_t enNewState);
Nvoid I2C_SCLTimeoutCmd(CM_I2C_TypeDef *I2Cx, en_functional_state_t enNewState);
N
N/* High level functions for reference ********************************/
Nint32_t I2C_Start(CM_I2C_TypeDef *I2Cx, uint32_t u32Timeout);
Nint32_t I2C_Restart(CM_I2C_TypeDef *I2Cx, uint32_t u32Timeout);
Nint32_t I2C_TransAddr(CM_I2C_TypeDef *I2Cx, uint16_t u16Addr, uint8_t u8Dir, uint32_t u32Timeout);
Nint32_t I2C_Trans10BitAddr(CM_I2C_TypeDef *I2Cx, uint16_t u16Addr, uint8_t u8Dir, uint32_t u32Timeout);
Nint32_t I2C_TransData(CM_I2C_TypeDef *I2Cx, const uint8_t au8TxData[], uint32_t u32Size, uint32_t u32Timeout);
Nint32_t I2C_ReceiveData(CM_I2C_TypeDef *I2Cx, uint8_t au8RxData[], uint32_t u32Size, uint32_t u32Timeout);
Nint32_t I2C_MasterReceiveDataAndStop(CM_I2C_TypeDef *I2Cx, uint8_t au8RxData[], uint32_t u32Size, uint32_t u32Timeout);
Nint32_t I2C_Stop(CM_I2C_TypeDef *I2Cx, uint32_t u32Timeout);
Nint32_t I2C_WaitStatus(const CM_I2C_TypeDef *I2Cx, uint32_t u32Flag, en_flag_status_t enStatus, uint32_t u32Timeout);
