N * License. You may obtain a copy of the License at:
N *                    opensource.org/licenses/BSD-3-Clause
N *
N *******************************************************************************
N */
N#ifndef __HC32_LL_RTC_H__
N#define __HC32_LL_RTC_H__
N
N/* C binding of definitions if building with C++ compiler */
N#ifdef __cplusplus
Sextern "C"
S{
N#endif
N
N/*******************************************************************************
N * Include files
N ******************************************************************************/
N#include "hc32_ll_def.h"
N
N#include "hc32f4xx.h"
N#include "hc32f4xx_conf.h"
N
N/**
N * @addtogroup LL_Driver
N * @{
N */
N
N/**
N * @addtogroup LL_RTC
N * @{
N */
N
N#if (LL_RTC_ENABLE == DDL_ON)
X#if (((1U)) == (1U))
N
N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup RTC_Global_Types RTC Global Types
N * @{
N */
N
N/**
N * @brief RTC Init structure definition
N */
Ntypedef struct {
N    uint8_t  u8ClockSrc;                /*!< Specifies the RTC clock source.
N                                             This parameter can be a value of @ref RTC_Clock_Source */
N    uint8_t  u8HourFormat;              /*!< Specifies the RTC hour format.
N                                             This parameter can be a value of @ref RTC_Hour_Format */
N    uint8_t  u8IntPeriod;               /*!< Specifies the RTC interrupt period.
N                                             This parameter can be a value of @ref RTC_Interrupt_Period */
N    uint8_t  u8ClockCompen;             /*!< Specifies the validity of RTC clock compensation.
N                                             This parameter can be a value of @ref RTC_Clock_Compensation */
N    uint8_t  u8CompenMode;              /*!< Specifies the mode of RTC clock compensation.
N                                             This parameter can be a value of @ref RTC_Clock_Compensation_Mode */
N    uint16_t u16CompenValue;            /*!< Specifies the value of RTC clock compensation.
N                                             This parameter can be a number between Min_Data = 0 and Max_Data = 0x1FF */
N} stc_rtc_init_t;
N
N/**
N * @brief RTC Date structure definition
N */
Ntypedef struct {
N    uint8_t u8Year;                     /*!< Specifies the RTC Year.
N                                             This parameter can be a number between Min_Data = 0 and Max_Data = 99 */
N    uint8_t u8Month;                    /*!< Specifies the RTC Month (in Decimal format).
N                                             This parameter can be a value of @ref RTC_Month */
N    uint8_t u8Day;                      /*!< Specifies the RTC Day.
N                                             This parameter can be a number between Min_Data = 1 and Max_Data = 31 */
N    uint8_t u8Weekday;                  /*!< Specifies the RTC Weekday.
N                                             This parameter can be a value of @ref RTC_Weekday */
N} stc_rtc_date_t;
N
N/**
N * @brief RTC Time structure definition
N */
Ntypedef struct {
N    uint8_t u8Hour;                     /*!< Specifies the RTC Hour.
N                                             This parameter can be a number between Min_Data = 1 and Max_Data = 12 if the RTC_HOUR_FMT_12H is selected.
N                                             This parameter can be a number between Min_Data = 0 and Max_Data = 23 if the RTC_HOUR_FMT_24H is selected */
N    uint8_t u8Minute;                   /*!< Specifies the RTC Minute.
N                                             This parameter can be a number between Min_Data = 0 and Max_Data = 59 */
N    uint8_t u8Second;                   /*!< Specifies the RTC Second.
N                                             This parameter can be a number between Min_Data = 0 and Max_Data = 59 */
N    uint8_t u8AmPm;                     /*!< Specifies the RTC Am/Pm Time (in RTC_HOUR_FMT_12H mode).
N                                             This parameter can be a value of @ref RTC_Hour12_AM_PM */
N} stc_rtc_time_t;
N
N/**
N * @brief RTC Alarm structure definition
N */
Ntypedef struct {
N    uint8_t u8AlarmHour;                /*!< Specifies the RTC Alarm Hour.
N                                           This parameter can be a number between Min_Data = 1 and Max_Data = 12 if the RTC_HOUR_FMT_12H is selected.
N                                           This parameter can be a number between Min_Data = 0 and Max_Data = 23 if the RTC_HOUR_FMT_24H is selected */
N    uint8_t u8AlarmMinute;              /*!< Specifies the RTC Alarm Minute.
N                                             This parameter can be a number between Min_Data = 0 and Max_Data = 59 */
N    uint8_t u8AlarmWeekday;             /*!< Specifies the RTC Alarm Weekday.
N                                             This parameter can be a value of @ref RTC_Alarm_Weekday */
N    uint8_t u8AlarmAmPm;                /*!< Specifies the RTC Alarm Am/Pm Time (in RTC_HOUR_FMT_12H mode).
N                                             This parameter can be a value of @ref RTC_Hour12_AM_PM */
N} stc_rtc_alarm_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup RTC_Global_Macros RTC Global Macros
N * @{
N */
N
N/**
N * @defgroup RTC_Data_Format RTC Data Format
N * @{
N */
N#define RTC_DATA_FMT_DEC                        (0x00U)     /*!< Decimal data format */
N#define RTC_DATA_FMT_BCD                        (0x01U)     /*!< BCD data format     */
N/**
N * @}
N */
N
N/**
N * @defgroup RTC_Decimal_BCD_Conversion RTC Decimal BCD Conversion
N * @{
N */
N#define RTC_DEC2BCD(__DATA__)                   ((((__DATA__) / 10U) << 4U) + ((__DATA__) % 10U))
N#define RTC_BCD2DEC(__DATA__)                   ((((__DATA__) >> 4U) * 10U) + ((__DATA__) & 0x0FU))
N/**
N * @}
N */
N
N/**
N * @defgroup RTC_Clock_Source RTC Clock Source
N * @{
N */
N#define RTC_CLK_SRC_XTAL32                      (0U)                                    /*!< XTAL32 Clock   */
N#define RTC_CLK_SRC_LRC                         (RTC_CR3_RCKSEL | RTC_CR3_LRCEN)        /*!< RTC LRC Clock  */
N/**
N * @}
N */
N
N/**
N * @defgroup RTC_Hour_Format RTC Hour Format
N * @{
N */
N#define RTC_HOUR_FMT_12H                        (0U)                /*!< 12 hour time system */
N#define RTC_HOUR_FMT_24H                        (RTC_CR1_AMPM)      /*!< 24 hour time system */
N/**
N * @}
N */
N
N/**
N * @defgroup RTC_Interrupt_Period RTC Interrupt Period
N * @{
N */
N#define RTC_INT_PERIOD_INVD                     (0U)                          /*!< Interrupt period invalid         */
N#define RTC_INT_PERIOD_PER_HALF_SEC             (0x01U << RTC_CR1_PRDS_POS)   /*!< Interrupt period per half second */
N#define RTC_INT_PERIOD_PER_SEC                  (0x02U << RTC_CR1_PRDS_POS)   /*!< Interrupt period per second      */
N#define RTC_INT_PERIOD_PER_MINUTE               (0x03U << RTC_CR1_PRDS_POS)   /*!< Interrupt period per minute      */
N#define RTC_INT_PERIOD_PER_HOUR                 (0x04U << RTC_CR1_PRDS_POS)   /*!< Interrupt period per hour        */
N#define RTC_INT_PERIOD_PER_DAY                  (0x05U << RTC_CR1_PRDS_POS)   /*!< Interrupt period per day         */
N#define RTC_INT_PERIOD_PER_MONTH                (0x06U << RTC_CR1_PRDS_POS)   /*!< Interrupt period per month       */
N/**
N * @}
N */
N
N/**
N * @defgroup RTC_Clock_Compensation RTC Clock Compensation
N * @{
N */
N#define RTC_CLK_COMPEN_DISABLE                  (0U)
N#define RTC_CLK_COMPEN_ENABLE                   (RTC_ERRCRH_COMPEN)
N/**
N * @}
N */
N
N/**
N * @defgroup RTC_Clock_Compensation_Mode RTC Clock Compensation Mode
N * @{
N */
N#define RTC_CLK_COMPEN_MD_DISTRIBUTED           (0U)                    /*!< Distributed compensation 1Hz output */
N#define RTC_CLK_COMPEN_MD_UNIFORM               (RTC_CR1_ONEHZSEL)      /*!< Uniform compensation 1Hz output     */
N/**
N * @}
N */
N
N/**
N * @defgroup RTC_Hour12_AM_PM RTC Hour12 AM/PM
N * @{
N */
N#define RTC_HOUR_24H                            (0U)                /*!< 24-hour format */
N#define RTC_HOUR_12H_AM                         (0U)                /*!< AM in 12-hour  */
N#define RTC_HOUR_12H_PM                         (RTC_HOUR_HOURD_1)  /*!< PM in 12-hour  */
N/**
N * @}
N */
N
N/**
N * @defgroup RTC_Month RTC Month
N * @{
N */
N#define RTC_MONTH_JANUARY                       (0x01U)
N#define RTC_MONTH_FEBRUARY                      (0x02U)
N#define RTC_MONTH_MARCH                         (0x03U)
N#define RTC_MONTH_APRIL                         (0x04U)
N#define RTC_MONTH_MAY                           (0x05U)
N#define RTC_MONTH_JUNE                          (0x06U)
N#define RTC_MONTH_JULY                          (0x07U)
N#define RTC_MONTH_AUGUST                        (0x08U)
N#define RTC_MONTH_SEPTEMBER                     (0x09U)
N#define RTC_MONTH_OCTOBER                       (0x0AU)
N#define RTC_MONTH_NOVEMBER                      (0x0BU)
N#define RTC_MONTH_DECEMBER                      (0x0CU)
N/**
N * @}
N */
N
N/**
N * @defgroup RTC_Weekday RTC Weekday
N * @{
N */
N#define RTC_WEEKDAY_SUNDAY                      (0x00U)
N#define RTC_WEEKDAY_MONDAY                      (0x01U)
N#define RTC_WEEKDAY_TUESDAY                     (0x02U)
N#define RTC_WEEKDAY_WEDNESDAY                   (0x03U)
N#define RTC_WEEKDAY_THURSDAY                    (0x04U)
N#define RTC_WEEKDAY_FRIDAY                      (0x05U)
N#define RTC_WEEKDAY_SATURDAY                    (0x06U)
N/**
N * @}
N */
N
N/**
N * @defgroup RTC_Alarm_Weekday RTC Alarm Weekday
N * @{
N */
N#define RTC_ALARM_WEEKDAY_SUNDAY                (0x01U)
N#define RTC_ALARM_WEEKDAY_MONDAY                (0x02U)
N#define RTC_ALARM_WEEKDAY_TUESDAY               (0x04U)
N#define RTC_ALARM_WEEKDAY_WEDNESDAY             (0x08U)
N#define RTC_ALARM_WEEKDAY_THURSDAY              (0x10U)
N#define RTC_ALARM_WEEKDAY_FRIDAY                (0x20U)
N#define RTC_ALARM_WEEKDAY_SATURDAY              (0x40U)
N#define RTC_ALARM_WEEKDAY_EVERYDAY              (0x7FU)
N/**
N * @}
N */
N
N/**
N * @defgroup RTC_Flag RTC Flag
N * @{
N */
N#define RTC_FLAG_RD_WR                          (RTC_CR2_RWEN)                      /*!< Read and write permission flag */
N#define RTC_FLAG_ALARM                          (RTC_CR2_ALMF)                      /*!< Alarm flag                     */
N#define RTC_FLAG_ALL                            (RTC_FLAG_RD_WR | RTC_FLAG_ALARM)
N#define RTC_FLAG_CLR_ALL                        (RTC_FLAG_ALARM)
N/**
N * @}
N */
N
N/**
N * @defgroup RTC_Interrupt RTC Interrupt
N * @{
N */
N#define RTC_INT_PERIOD                          (RTC_CR2_PRDIE)                     /*!< Period interrupt          */
N#define RTC_INT_ALARM                           (RTC_CR2_ALMIE)                     /*!< Alarm interrupt           */
N#define RTC_INT_ALL                             (RTC_INT_PERIOD | RTC_INT_ALARM)
N/**
N * @}
N */
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global variable definitions ('extern')
N ******************************************************************************/
N
N/*******************************************************************************
N  Global function prototypes (definition in C source)
N ******************************************************************************/
N/**
N * @addtogroup RTC_Global_Functions
N * @{
N */
N
N/* Initialization and configuration functions */
Nint32_t RTC_DeInit(void);
Nint32_t RTC_Init(const stc_rtc_init_t *pstcRtcInit);
Nint32_t RTC_StructInit(stc_rtc_init_t *pstcRtcInit);
Nint32_t RTC_EnterRwMode(void);
Nint32_t RTC_ExitRwMode(void);
N
N/* Control configuration */
Nint32_t RTC_ConfirmLPMCond(void);
Nvoid RTC_SetIntPeriod(uint8_t u8Period);
Nvoid RTC_SetClockSrc(uint8_t u8Src);
Nvoid RTC_SetClockCompenValue(uint16_t u16Value);
Nen_functional_state_t RTC_GetCounterState(void);
Nvoid RTC_Cmd(en_functional_state_t enNewState);
Nvoid RTC_LrcCmd(en_functional_state_t enNewState);
Nvoid RTC_OneHzOutputCmd(en_functional_state_t enNewState);
Nvoid RTC_ClockCompenCmd(en_functional_state_t enNewState);
N
N/* Date and time functions */
Nint32_t RTC_SetDate(uint8_t u8Format, stc_rtc_date_t *pstcRtcDate);
Nint32_t RTC_GetDate(uint8_t u8Format, stc_rtc_date_t *pstcRtcDate);
Nint32_t RTC_SetTime(uint8_t u8Format, stc_rtc_time_t *pstcRtcTime);
Nint32_t RTC_GetTime(uint8_t u8Format, stc_rtc_time_t *pstcRtcTime);
N
N/* Alarm configuration functions */
Nint32_t RTC_SetAlarm(uint8_t u8Format, stc_rtc_alarm_t *pstcRtcAlarm);
Nint32_t RTC_GetAlarm(uint8_t u8Format, stc_rtc_alarm_t *pstcRtcAlarm);
Nvoid RTC_AlarmCmd(en_functional_state_t enNewState);
N
N/* Interrupt and flag management functions */
Nvoid RTC_IntCmd(uint32_t u32IntType, en_functional_state_t enNewState);
Nen_flag_status_t RTC_GetStatus(uint32_t u32Flag);
Nvoid RTC_ClearStatus(uint32_t u32Flag);
N
N/**
N * @}
N */
N
N#endif /* LL_RTC_ENABLE */
N
N/**
N * @}
N */
N
N/**
N * @}
N */
N
N#ifdef __cplusplus
S}
N#endif
N
N#endif /* __HC32_LL_RTC_H__ */
