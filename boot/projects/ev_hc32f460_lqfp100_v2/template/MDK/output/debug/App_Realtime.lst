N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup ADC_Global_Types ADC Global Types
N * @{
N */
N/**
N * @brief Structure definition of analog watchdog(AWD) configuration.
N */
Ntypedef struct {
N    uint16_t u16WatchdogMode;           /*!< Specifies the ADC analog watchdog mode.
N                                             This parameter can be a value of @ref ADC_AWD_Mode */
N    uint16_t u16LowThreshold;           /*!< Specifies the ADC analog watchdog Low threshold value. */
N    uint16_t u16HighThreshold;          /*!< Specifies the ADC analog watchdog High threshold value. */
N} stc_adc_awd_config_t;
N
N/**
N * @brief Structure definition of ADC initialization.
N */
Ntypedef struct {
N    uint16_t u16ScanMode;               /*!< Specifies the ADC scan convert mode.
N                                             This parameter can be a value of @ref ADC_Scan_Mode */
N    uint16_t u16Resolution;             /*!< Specifies the ADC resolution.
N                                             This parameter can be a value of @ref ADC_Resolution */
N    uint16_t u16DataAlign;              /*!< Specifies ADC data alignment.
N                                             This parameter can be a value of @ref ADC_Data_Align */
N} stc_adc_init_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup ADC_Global_Macros ADC Global Macros
N * @{
N */
N
N/**
N * @defgroup ADC_Sequence ADC Sequence
N * @{
N */
N#define ADC_SEQ_A                       (0U)                /*!< ADC sequence A. */
N#define ADC_SEQ_B                       (1U)                /*!< ADC sequence B. */
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_Channel ADC Channel
N * @{
N */
N#define ADC_CH0                         (0U)        /*!< Default input pin: PA0 for ADC1, PA4 for ADC2. */
N#define ADC_CH1                         (1U)        /*!< Default input pin: PA1 for ADC1, PA5 for ADC2. */
N#define ADC_CH2                         (2U)        /*!< Default input pin: PA2 for ADC1, PA6 for ADC2. */
N#define ADC_CH3                         (3U)        /*!< Default input pin: PA3 for ADC1, PA7 for ADC2. */
N#define ADC_CH4                         (4U)        /*!< Default input pin: PA4 for ADC1, PB0 for ADC2. */
N#define ADC_CH5                         (5U)        /*!< Default input pin: PA5 for ADC1, PB1 for ADC2. */
N#define ADC_CH6                         (6U)        /*!< Default input pin: PA6 for ADC1, PC0 for ADC2. */
N#define ADC_CH7                         (7U)        /*!< Default input pin: PA7 for ADC1, PC1 for ADC2. */
N#define ADC_CH8                         (8U)        /*!< Default input pin: PB0 for ADC1, internal analog signal for ADC2. */
N#define ADC_CH9                         (9U)        /*!< Default input pin: PB1 for ADC1. NOT support ADC2. */
N#define ADC_CH10                        (10U)       /*!< Default input pin: PC0 for ADC1. NOT support ADC2. */
N#define ADC_CH11                        (11U)       /*!< Default input pin: PC1 for ADC1. NOT support ADC2. */
N#define ADC_CH12                        (12U)       /*!< Default input pin: PC2 for ADC1. NOT support ADC2. */
N#define ADC_CH13                        (13U)       /*!< Default input pin: PC3 for ADC1. NOT support ADC2. */
N#define ADC_CH14                        (14U)       /*!< Default input pin: PC4 for ADC1. NOT support ADC2. */
N#define ADC_CH15                        (15U)       /*!< Default input pin: PC5 for ADC1. NOT support ADC2. */
N#define ADC_CH16                        (16U)       /*!< ADC1 extended channel, input source is internal analog signal */
N
N#define ADC1_EXT_CH                     (ADC_CH16)  /*!< ADC1 extended channel, input source is internal analog signal:
N                                                         internal reference voltage or 8bit-DAC. */
N#define ADC2_EXT_CH                     (ADC_CH8)   /*!< ADC2 extended channel, input source is internal analog signal:
N                                                         internal reference voltage or 8bit-DAC. */
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_Mx_Channel ADC Channel
N * @{
N */
N#define ADC_MX_CH0                      (1U << 0U)          /*!< ADC channel 0 position  */
N#define ADC_MX_CH1                      (1U << 1U)          /*!< ADC channel 1 position  */
N#define ADC_MX_CH2                      (1U << 2U)          /*!< ADC channel 2 position  */
N#define ADC_MX_CH3                      (1U << 3U)          /*!< ADC channel 3 position  */
N#define ADC_MX_CH4                      (1U << 4U)          /*!< ADC channel 4 position  */
N#define ADC_MX_CH5                      (1U << 5U)          /*!< ADC channel 5 position  */
N#define ADC_MX_CH6                      (1U << 6U)          /*!< ADC channel 6 position  */
N#define ADC_MX_CH7                      (1U << 7U)          /*!< ADC channel 7 position  */
N#define ADC_MX_CH8                      (1U << 8U)          /*!< ADC channel 8 position  */
N#define ADC_MX_CH9                      (1U << 9U)          /*!< ADC channel 9 position  */
N#define ADC_MX_CH10                     (1U << 10U)         /*!< ADC channel 10 position */
N#define ADC_MX_CH11                     (1U << 11U)         /*!< ADC channel 11 position */
N#define ADC_MX_CH12                     (1U << 12U)         /*!< ADC channel 12 position */
N#define ADC_MX_CH13                     (1U << 13U)         /*!< ADC channel 13 position */
N#define ADC_MX_CH14                     (1U << 14U)         /*!< ADC channel 14 position */
N#define ADC_MX_CH15                     (1U << 15U)         /*!< ADC channel 15 position */
N#define ADC_MX_CH16                     (1U << 16U)         /*!< ADC channel 16 position */
N
N#define ADC1_MX_CH_ALL                  (0xFFFFUL)          /*!< ADC1 Channel mask position */
N#define ADC2_MX_CH_ALL                  (0x1FFUL)           /*!< ADC2 Channel mask position */
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_Scan_Mode ADC Scan Convert Mode
N * @{
N */
N#define ADC_MD_SEQA_SINGLESHOT              (0x0U)                      /*!< Sequence A single shot. Sequence B is disabled. */
N#define ADC_MD_SEQA_CONT                    (0x1U << ADC_CR0_MS_POS)    /*!< Sequence A continuous. Sequence B is disabled. */
N#define ADC_MD_SEQA_SEQB_SINGLESHOT         (0x2U << ADC_CR0_MS_POS)    /*!< Sequence A and B both single shot. */
N#define ADC_MD_SEQA_CONT_SEQB_SINGLESHOT    (0x3U << ADC_CR0_MS_POS)    /*!< Sequence A continuous and sequence B single shot. */
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_Resolution ADC Resolution
N * @{
N */
N#define ADC_RESOLUTION_12BIT            (0x0U)              /*!< Resolution is 12 bit. */
N#define ADC_RESOLUTION_10BIT            (ADC_CR0_ACCSEL_0)  /*!< Resolution is 10 bit. */
N#define ADC_RESOLUTION_8BIT             (ADC_CR0_ACCSEL_1)  /*!< Resolution is 8 bit. */
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_Data_Align ADC Data Align
N * @{
N */
N#define ADC_DATAALIGN_RIGHT             (0x0U)              /*!< Right alignment of converted data. */
N#define ADC_DATAALIGN_LEFT              (ADC_CR0_DFMT)      /*!< Left alignment of converted data. */
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_Average_Count ADC Average Count
N * @{
N */
N#define ADC_AVG_CNT2                    (0x0U)                      /*!< 2 consecutive average conversions. */
N#define ADC_AVG_CNT4                    (0x1U << ADC_CR0_AVCNT_POS) /*!< 4 consecutive average conversions. */
N#define ADC_AVG_CNT8                    (0x2U << ADC_CR0_AVCNT_POS) /*!< 8 consecutive average conversions. */
N#define ADC_AVG_CNT16                   (0x3U << ADC_CR0_AVCNT_POS) /*!< 16 consecutive average conversions. */
N#define ADC_AVG_CNT32                   (0x4U << ADC_CR0_AVCNT_POS) /*!< 32 consecutive average conversions. */
N#define ADC_AVG_CNT64                   (0x5U << ADC_CR0_AVCNT_POS) /*!< 64 consecutive average conversions. */
N#define ADC_AVG_CNT128                  (0x6U << ADC_CR0_AVCNT_POS) /*!< 128 consecutive average conversions. */
N#define ADC_AVG_CNT256                  (0x7U << ADC_CR0_AVCNT_POS) /*!< 256 consecutive average conversions. */
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_SeqA_Resume_Mode ADC Sequence A Resume Mode
N * @brief After interrupted by sequence B, sequence A continues to scan from the interrupt channel or the first channel.
N * @{
N */
N#define ADC_SEQA_RESUME_SCAN_CONT       (0U)                /*!< Scanning will continue from the interrupted channel. */
N#define ADC_SEQA_RESUME_SCAN_RESTART    (ADC_CR1_RSCHSEL)   /*!< Scanning will start from the first channel. */
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_Hard_Trigger_Sel ADC Hard Trigger Selection
N * @{
N */
N#define ADC_HARDTRIG_ADTRG_PIN          (0x0U)                      /*!< Selects the following edge of pin ADTRG as the trigger of ADC sequence. */
N#define ADC_HARDTRIG_EVT0               (ADC_TRGSR_TRGSELA_0)       /*!< Selects an internal event as the trigger of ADC sequence.
N                                                                         This event is specified by register ADCx_TRGSEL0(x=(null), 1, 2, 3). */
N#define ADC_HARDTRIG_EVT1               (ADC_TRGSR_TRGSELA_1)       /*!< Selects an internal event as the trigger of ADC sequence.
N                                                                         This event is specified by register ADCx_TRGSEL1(x=(null), 1, 2, 3). */
N#define ADC_HARDTRIG_EVT0_EVT1          (ADC_TRGSR_TRGSELA)         /*!< Selects two internal events as the trigger of ADC sequence.
N                                                                         The two events are specified by register ADCx_TRGSEL0 and register ADCx_TRGSEL1. */
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_Int_Type ADC Interrupt Type
N * @{
N */
N#define ADC_INT_EOCA                    (ADC_ICR_EOCAIEN)           /*!< Interrupt of the end of conversion of sequence A. */
N#define ADC_INT_EOCB                    (ADC_ICR_EOCBIEN)           /*!< Interrupt of the end of conversion of sequence B. */
N#define ADC_INT_ALL                     (ADC_INT_EOCA | ADC_INT_EOCB)
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_Status_Flag ADC Status Flag
N * @{
N */
N#define ADC_FLAG_EOCA                   (ADC_ISR_EOCAF)             /*!< Status flag of the end of conversion of sequence A. */
N#define ADC_FLAG_EOCB                   (ADC_ISR_EOCBF)             /*!< Status flag of the end of conversion of sequence B. */
N#define ADC_FLAG_ALL                    (ADC_FLAG_EOCA | ADC_FLAG_EOCB)
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_Sync_Unit ADC Synchronous Unit
N * @{
N */
N#define ADC_SYNC_ADC1_ADC2              (0U)                                /*!< ADC1 and ADC2 work synchronously. */
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_Sync_Mode ADC Synchronous Mode
N * @{
N */
N#define ADC_SYNC_SINGLE_DELAY_TRIG      (0U)                            /*!< Single shot delayed trigger mode.
N                                                                             When the trigger condition occurs, ADC1 starts first, then ADC2, last ADC3(if has).
N                                                                             All ADCs scan once. */
N#define ADC_SYNC_SINGLE_PARALLEL_TRIG   (0x2U << ADC_SYNCCR_SYNCMD_POS) /*!< Single shot parallel trigger mode.
N                                                                             When the trigger condition occurs, all ADCs start at the same time.
N                                                                             All ADCs scan once. */
N#define ADC_SYNC_CYCLIC_DELAY_TRIG      (0x4U << ADC_SYNCCR_SYNCMD_POS) /*!< Cyclic delayed trigger mode.
N                                                                             When the trigger condition occurs, ADC1 starts first, then ADC2, last ADC3(if has).
N                                                                             All ADCs scan cyclically(keep scanning till you stop them). */
N#define ADC_SYNC_CYCLIC_PARALLEL_TRIG   (0x6U << ADC_SYNCCR_SYNCMD_POS) /*!< Single shot parallel trigger mode.
N                                                                             When the trigger condition occurs, all ADCs start at the same time.
N                                                                             All ADCs scan cyclically(keep scanning till you stop them). */
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_AWD_Unit ADC Analog Watchdog Unit
N * @{
N */
N#define ADC_AWD0                        (0U)    /*!< ADC analog watchdog 0. */
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_AWD_Int_Type ADC AWD Interrupt Type
N * @{
N */
N#define ADC_AWD_INT_SEQA                (ADC_AWDCR_AWDSS_0)     /*!< Interrupt of AWD sequence A. */
N#define ADC_AWD_INT_SEQB                (ADC_AWDCR_AWDSS_1)     /*!< Interrupt of AWD sequence B. */
N#define ADC_AWD_INT_ALL                 (ADC_AWDCR_AWDSS)
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_AWD_Mode ADC Analog Watchdog Mode
N * @{
N */
N#define ADC_AWD_MD_CMP_OUT              (0x0U)  /*!< ADCValue > HighThreshold or ADCValue < LowThreshold */
N#define ADC_AWD_MD_CMP_IN               (0x1U)  /*!< LowThreshold < ADCValue < HighThreshold */
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_AWD_Status_Flag ADC AWD Status Flag
N * @{
N */
N#define ADC_AWD_FLAG_CH0                (1UL << ADC_CH0)
N#define ADC_AWD_FLAG_CH1                (1UL << ADC_CH1)
N#define ADC_AWD_FLAG_CH2                (1UL << ADC_CH2)
N#define ADC_AWD_FLAG_CH3                (1UL << ADC_CH3)
N#define ADC_AWD_FLAG_CH4                (1UL << ADC_CH4)
N#define ADC_AWD_FLAG_CH5                (1UL << ADC_CH5)
N#define ADC_AWD_FLAG_CH6                (1UL << ADC_CH6)
N#define ADC_AWD_FLAG_CH7                (1UL << ADC_CH7)
N#define ADC_AWD_FLAG_CH8                (1UL << ADC_CH8)
N#define ADC_AWD_FLAG_CH9                (1UL << ADC_CH9)
N#define ADC_AWD_FLAG_CH10               (1UL << ADC_CH10)
N#define ADC_AWD_FLAG_CH11               (1UL << ADC_CH11)
N#define ADC_AWD_FLAG_CH12               (1UL << ADC_CH12)
N#define ADC_AWD_FLAG_CH13               (1UL << ADC_CH13)
N#define ADC_AWD_FLAG_CH14               (1UL << ADC_CH14)
N#define ADC_AWD_FLAG_CH15               (1UL << ADC_CH15)
N#define ADC_AWD_FLAG_CH16               (1UL << ADC_CH16)
N#define ADC1_AWD_FLAG_ALL               (0x1FFFFUL)
N#define ADC2_AWD_FLAG_ALL               (0x1FFUL)
N/**
N * @}
N */
N
N/**
N * @defgroup ADC_PGA_Unit ADC PGA Unit
N * @{
N */
N#define ADC_PGA1                        (0U)    /*!< PGA1, belongs to ADC1. Input source can one of @ref ADC_PGA_Input_Src */
