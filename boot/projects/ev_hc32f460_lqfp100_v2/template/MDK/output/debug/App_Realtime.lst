N
N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup PWC_Global_Types PWC Global Types
N * @{
N */
N/**
N * @brief PWC LVD Init
N */
Ntypedef struct {
N    uint32_t u32State;              /*!< LVD function setting, @ref PWC_LVD_Config for details */
N    uint32_t u32CompareOutputState; /*!< LVD compare output function setting, @ref PWC_LVD_CMP_Config for details */
N    uint32_t u32ExceptionType;      /*!< LVD interrupt or reset selection, @ref PWC_LVD_Exception_Type_Sel for details */
N    uint32_t u32Filter;             /*!< LVD digital filter function setting, @ref PWC_LVD_DF_Config for details */
N    uint32_t u32FilterClock;        /*!< LVD digital filter clock setting, @ref PWC_LVD_DFS_Clk_Sel for details */
N    uint32_t u32ThresholdVoltage;   /*!< LVD detect voltage setting, @ref PWC_LVD_Detection_Voltage_Sel for details */
N} stc_pwc_lvd_init_t;
N
N/**
N * @brief PWC power down mode innit
N */
Ntypedef struct {
N    uint8_t u8Mode;         /*!< Power down mode, @ref PWC_PDMode_Sel for details. */
N    uint8_t u8IOState;      /*!< IO state in power down mode, @ref PWC_PDMode_IO_Sel for details. */
N    uint8_t u8VcapCtrl;     /*!< Power down Wakeup time control, @ref PWC_PD_VCAP_Sel for details. */
N} stc_pwc_pd_mode_config_t;
N
N/**
N * @brief PWC Stop mode Init
N */
Ntypedef struct {
N    uint16_t u16Clock;          /*!< System clock setting after wake-up from stop mode,
N                                    @ref PWC_STOP_CLK_Sel for details.        */
N    uint8_t u8StopDrv;          /*!< Stop mode drive capacity,
N                                    @ref PWC_STOP_DRV_Sel for details.        */
N    uint16_t u16FlashWait;      /*!< Waiting flash stable after wake-up from stop mode,
N                                    @ref PWC_STOP_Flash_Wait_Sel for details. */
N} stc_pwc_stop_mode_config_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup PWC_Global_Macros PWC Global Macros
N * @{
N */
N
N/**
N * @defgroup PWC_PDMode_Sel Power down mode selection
N * @{
N */
N#define PWC_PD_MD1                      (0x00U)        /*!< Power down mode 1 */
N#define PWC_PD_MD2                      (0x01U)        /*!< Power down mode 2 */
N#define PWC_PD_MD3                      (0x02U)        /*!< Power down mode 3 */
N#define PWC_PD_MD4                      (0x03U)        /*!< Power down mode 4 */
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_PDMode_IO_Sel IO state config in Power down mode
N * @{
N */
N#define PWC_PD_IO_KEEP1                 (0x00U)                 /*!< IO state retain in PD mode and configurable after wakeup */
N#define PWC_PD_IO_KEEP2                 (PWC_PWRC0_IORTN_0)     /*!< IO state retain in PD mode and configurable after wakeup & set IORTN[1:0]=00b */
N#define PWC_PD_IO_HIZ                   (PWC_PWRC0_IORTN_1)     /*!< IO state switch to HiZ */
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_PD_VCAP_Sel Wakeup speed config in Power down mode
N * @{
N */
N#define PWC_PD_VCAP_0P1UF               (0x00U)        /*!< VCAP1/VCAP2 = 0.1uF x2 or 0.22uF x1 */
N#define PWC_PD_VCAP_0P047UF             (0x01U)        /*!< VCAP1/VCAP2 = 0.047uF x2 or 0.1uF x1 */
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_STOP_DRV_Sel Drive capacity while enter stop mode
N * @{
N */
N#define PWC_STOP_DRV_HIGH               (0x00U)                 /*!< Enter stop mode from high speed mode */
N#define PWC_STOP_DRV_LOW                (PWC_PWRC1_STPDAS)      /*!< Enter stop mode from ultra low speed mode */
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_STOP_CLK_Sel System clock setting after wake-up from stop mode
N * @{
N */
N#define PWC_STOP_CLK_KEEP               (0x00U)                 /*!< Keep System clock setting after wake-up from stop mode */
N#define PWC_STOP_CLK_MRC                (PWC_STPMCR_CKSMRC)     /*!< System clock switch to MRC after wake-up from stop mode */
N
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_STOP_Flash_Wait_Sel Whether wait flash stable or not after wake-up from stop mode
N * @{
N */
N#define PWC_STOP_FLASH_WAIT_ON          (0x00U)                 /*!< Wait flash stable after wake-up from stop mode */
N#define PWC_STOP_FLASH_WAIT_OFF         (PWC_STPMCR_FLNWT)      /*!< Don't wait flash stable after wake-up from stop mode */
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_Stop_Type PWC stop mode type.
N * @{
N */
N#define PWC_STOP_WFI                    (0x00U)                 /*!< Enter stop mode by WFI, and wake-up by interrupt handle. */
N#define PWC_STOP_WFE_INT                (0x01U)                 /*!< Enter stop mode by WFE, and wake-up by interrupt request. */
N#define PWC_STOP_WFE_EVT                (0x02U)                 /*!< Enter stop mode by WFE, and wake-up by event. */
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_Stop_Type PWC stop mode type.
N * @{
N */
N#define PWC_SLEEP_WFI                   (0x00U)                 /*!< Enter sleep mode by WFI, and wake-up by interrupt handle. */
N#define PWC_SLEEP_WFE_INT               (0x01U)                 /*!< Enter sleep mode by WFE, and wake-up by interrupt request. */
N#define PWC_SLEEP_WFE_EVT               (0x02U)                 /*!< Enter sleep mode by WFE, and wake-up by event. */
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_RAM_Config Operating mode for RAM Config
N * @{
N */
N#define PWC_RAM_HIGH_SPEED              (0x8043U)               /*!< MCU operating under high frequency (lower than 240MHz) */
N#define PWC_RAM_ULOW_SPEED              (0x9062U)               /*!< MCU operating under ultra low frequency (lower than 8MHz) */
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_PD_Periph_Ram  Peripheral ram to power down
N * @{
N */
N#define PWC_RAM_PD_SRAM1                (PWC_RAMPC0_RAMPDC0)
N#define PWC_RAM_PD_SRAM2                (PWC_RAMPC0_RAMPDC1)
N#define PWC_RAM_PD_SRAM3                (PWC_RAMPC0_RAMPDC2)
N#define PWC_RAM_PD_SRAMH                (PWC_RAMPC0_RAMPDC3)
N#define PWC_RAM_PD_USBFS                (PWC_RAMPC0_RAMPDC4)
N#define PWC_RAM_PD_SDIO0                (PWC_RAMPC0_RAMPDC5)
N#define PWC_RAM_PD_SDIO1                (PWC_RAMPC0_RAMPDC6)
N#define PWC_RAM_PD_CACHE                (PWC_RAMPC0_RAMPDC8)
N#define PWC_RAM_PD_CAN                  (PWC_RAMPC0_RAMPDC7)
N#define PWC_RAM_PD_ALL                  (0x1FFU)
N
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_LVD_Channel PWC LVD channel
N * @{
N */
N#define PWC_LVD_CH1                     (0x00U)
N#define PWC_LVD_CH2                     (0x01U)
N
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_LVD_Config PWC LVD Config
N * @{
N */
N#define PWC_LVD_ON                      (PWC_PVDCR0_PVD1EN)
N#define PWC_LVD_OFF                     (0x00U)
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_LVD_Exception_Type_Sel PWC LVD Exception Type Select
N * @{
N */
N#define PWC_LVD_EXP_TYPE_NONE           (0x00U)
N#define PWC_LVD_EXP_TYPE_INT            (0x0101U)
N#define PWC_LVD_EXP_TYPE_NMI            (0x0001U)
N#define PWC_LVD_EXP_TYPE_RST            (PWC_PVDCR1_PVD1IRE | PWC_PVDCR1_PVD1IRS)
N
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_LVD_CMP_Config PWC LVD Compare Config
N * @{
N */
N#define PWC_LVD_CMP_OFF                 (0x00U)
N#define PWC_LVD_CMP_ON                  (PWC_PVDCR1_PVD1CMPOE)
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_LVD_DF_Config LVD digital filter ON or OFF
N * @{
N */
N#define PWC_LVD_FILTER_ON               (0x00U)
N#define PWC_LVD_FILTER_OFF              (0x01U)
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_LVD_DFS_Clk_Sel LVD digital filter sample ability
N * @note     modified this value must when PWC_LVD_FILTER_OFF
N * @{
N */
N#define PWC_LVD_FILTER_LRC_DIV4        (0x00UL << PWC_PVDFCR_PVD1NFCKS_POS)     /*!< 0.25 LRC cycle */
N#define PWC_LVD_FILTER_LRC_DIV2        (0x01UL << PWC_PVDFCR_PVD1NFCKS_POS)     /*!< 0.5 LRC cycle  */
N#define PWC_LVD_FILTER_LRC_DIV1        (0x02UL << PWC_PVDFCR_PVD1NFCKS_POS)     /*!< 1 LRC cycle    */
N#define PWC_LVD_FILTER_LRC_MUL2        (0x03UL << PWC_PVDFCR_PVD1NFCKS_POS)     /*!< 2 LRC cycles   */
N
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_LVD_Detection_Voltage_Sel PWC LVD Detection voltage
N * @{
N * @note
N * @verbatim
N *       |  LVL0   |  LVL1   |  LVL2   |  LVL3   |  LVL4   |  LVL5   |  LVL6   |  LVL7   |  EXVCC |
N * LVD1  |  2.00V  |  2.10V  |  2.30V  |  2.55V  |  2.65V  |  2.75V  |  2.85V  |  2.95V  |   --   |
N * LVD2  |  2.10V  |  2.30V  |  2.55V  |  2.65V  |  2.75V  |  2.85V  |  2.95V  |  1.10V  |  EXVCC |
N * @endverbatim
N */
N#define PWC_LVD_THRESHOLD_LVL0          (0x00U)
N#define PWC_LVD_THRESHOLD_LVL1          (0x01U)
N#define PWC_LVD_THRESHOLD_LVL2          (0x02U)
N#define PWC_LVD_THRESHOLD_LVL3          (0x03U)
N#define PWC_LVD_THRESHOLD_LVL4          (0x04U)
N#define PWC_LVD_THRESHOLD_LVL5          (0x05U)
N#define PWC_LVD_THRESHOLD_LVL6          (0x06U)
N#define PWC_LVD_THRESHOLD_LVL7          (0x07U)
N#define PWC_LVD_EXTVCC                  (0x07U)
N
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_LVD_Flag LVD flag
N * @{
N */
N#define PWC_LVD1_FLAG_DETECT            (PWC_PVDDSR_PVD1DETFLG)          /*!< VCC across VLVD1   */
N#define PWC_LVD2_FLAG_DETECT            (PWC_PVDDSR_PVD2DETFLG)          /*!< VCC across VLVD2   */
N#define PWC_LVD1_FLAG_MON               (PWC_PVDDSR_PVD1MON)             /*!< VCC > VLVD1        */
N#define PWC_LVD2_FLAG_MON               (PWC_PVDDSR_PVD2MON)             /*!< VCC > VLVD2        */
N
N/**
N * @}
N */
N
N/**
N * @defgroup PWC_WKUP_Event_Sel Power down mode wakeup event selection
N * @{
N */
N#define PWC_PD_WKUP0_POS                (0U)
N#define PWC_PD_WKUP1_POS                (8U)
N#define PWC_PD_WKUP2_POS                (16U)
N#define PWC_PD_WKUP_WKUP00              (PWC_PDWKE0_WKE00 << PWC_PD_WKUP0_POS)
N#define PWC_PD_WKUP_WKUP01              (PWC_PDWKE0_WKE01 << PWC_PD_WKUP0_POS)
N#define PWC_PD_WKUP_WKUP02              (PWC_PDWKE0_WKE02 << PWC_PD_WKUP0_POS)
