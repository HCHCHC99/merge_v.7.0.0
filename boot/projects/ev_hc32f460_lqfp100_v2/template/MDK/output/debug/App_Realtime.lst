N/**
N *******************************************************************************
N * @file  hc32_ll_sram.h
N * @brief This file contains all the functions prototypes of the SRAM driver
N *        library.
N @verbatim
N   Change Logs:
N   Date             Author          Notes
N   2022-03-31       CDT             First version
N   2022-10-31       CDT             Deleted redundant comments
N   2023-06-30       CDT             Modify typo
N   2023-12-15       CDT             Refine def group SRAM_ECC_Mode, and refine def group SRAM_Err_Mode as SRAM_Exception_Type
N                                    Add macro SRAM_ECC_SRAM_ALL and group SRAM_Check_SRAM
N @endverbatim
N *******************************************************************************
N * Copyright (C) 2022-2025, Xiaohua Semiconductor Co., Ltd. All rights reserved.
N *
N * This software component is licensed by XHSC under BSD 3-Clause license
N * (the "License"); You may not use this file except in compliance with the
N * License. You may obtain a copy of the License at:
N *                    opensource.org/licenses/BSD-3-Clause
N *
N *******************************************************************************
N */
N#ifndef __HC32_LL_SRAM_H__
N#define __HC32_LL_SRAM_H__
N
N/* C binding of definitions if building with C++ compiler */
N#ifdef __cplusplus
Sextern "C"
S{
N#endif
N
N/*******************************************************************************
N * Include files
N ******************************************************************************/
N#include "hc32_ll_def.h"
N
N#include "hc32f4xx.h"
N#include "hc32f4xx_conf.h"
N/**
N * @addtogroup LL_Driver
N * @{
N */
N
N/**
N * @addtogroup LL_SRAM
N * @{
N */
N
N#if (LL_SRAM_ENABLE == DDL_ON)
X#if (((1U)) == (1U))
N
N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup SRAM_Global_Macros SRAM Global Macros
N * @{
N */
N
N/**
N * @defgroup SRAM_Sel SRAM Selection
N * @{
N */
N#define SRAM_SRAMH              (1UL << 2U)                 /*!< SRAMH: 0x1FFF8000~0x1FFFFFFF, 32KB */
N#define SRAM_SRAM12             (1UL << 0U)                 /*!< SRAM1: 0x20000000~0x2000FFFF, 64KB
N                                                                 SRAM2: 0x20010000~0x2001FFFF, 64KB */
N#define SRAM_SRAM3              (1UL << 1U)                 /*!< SRAM3: 0x20020000~0x20026FFF, 28KB */
N#define SRAM_SRAMR              (1UL << 3U)                 /*!< Ret_SRAM: 0x200F0000~0x200F0FFF, 4KB */
N#define SRAM_SRAM_ALL           (SRAM_SRAMH | SRAM_SRAM12 | SRAM_SRAM3 | SRAM_SRAMR)
N/**
N * @}
N */
N
N/**
N * @defgroup SRAM_ECC_SRAM ECC SRAM Definition
N * @{
N */
N#define SRAM_ECC_SRAM3          (1UL << 0U)
N#define SRAM_ECC_SRAM_ALL       SRAM_ECC_SRAM3
N/**
N * @}
N */
N
N/**
N * @defgroup SRAM_Access_Wait_Cycle SRAM Access Wait Cycle
N * @{
N */
N#define SRAM_WAIT_CYCLE0        (0U)                        /*!< Wait 0 CPU cycle. */
N#define SRAM_WAIT_CYCLE1        (1U)                        /*!< Wait 1 CPU cycle. */
N#define SRAM_WAIT_CYCLE2        (2U)                        /*!< Wait 2 CPU cycles. */
N#define SRAM_WAIT_CYCLE3        (3U)                        /*!< Wait 3 CPU cycles. */
N#define SRAM_WAIT_CYCLE4        (4U)                        /*!< Wait 4 CPU cycles. */
N#define SRAM_WAIT_CYCLE5        (5U)                        /*!< Wait 5 CPU cycles. */
N#define SRAM_WAIT_CYCLE6        (6U)                        /*!< Wait 6 CPU cycles. */
N#define SRAM_WAIT_CYCLE7        (7U)                        /*!< Wait 7 CPU cycles. */
N/**
N * @}
N */
N
N/**
N * @defgroup SRAM_Exception_Type SRAM exception type
N * @note Even-parity check error, ECC check error.
N * @{
N */
N#define SRAM_EXP_TYPE_NMI               (0UL)
N#define SRAM_EXP_TYPE_RST               (1UL)
N/**
N * @}
N */
N
N/**
N * @defgroup SRAM_Check_SRAM SRAM check sram
N * @{
N */
N#define SRAM_CHECK_SRAM3                (SRAMC_CKCR_ECCOAD)
N#define SRAM_CHECK_SRAMH_1_2_B          (SRAMC_CKCR_PYOAD)
N#define SRAM_CHECK_SRAM_ALL             (SRAM_CHECK_SRAM3 | SRAM_CHECK_SRAMH_1_2_B)
N/**
N * @}
N */
N
N/**
N * @defgroup SRAM_ECC_Mode SRAM ECC Mode
N * @note     XX_INVD: The ECC mode is invalid
N *           XX_MD1:  When 1-bit error occurs, ECC error corrects. No 1-bit-error status flag setting, no interrupt or reset.
N *                    When 2-bit error occurs, ECC error detects. 2-bit-error status flag sets and interrupt or reset occurs.
N *           XX_MD2:  When 1-bit error occurs, ECC error corrects. 1-bit-error status flag sets, no interrupt or reset.
N *                    When 2-bit error occurs, ECC error detects. 2-bit-error status flag sets and interrupt or reset occurs.
N *           XX_MD3:  When 1-bit error occurs, ECC error corrects. 1-bit-error status flag sets and interrupt or reset occurs.
N *                    When 2-bit error occurs, ECC error detects. 2-bit-error status flag sets and interrupt or reset occurs.
N * @{
N */
N#define SRAM_SRAM3_ECC_INVD             (0x0UL)
N#define SRAM_SRAM3_ECC_MD1              (SRAMC_CKCR_ECCMOD_0)
N#define SRAM_SRAM3_ECC_MD2              (SRAMC_CKCR_ECCMOD_1)
N#define SRAM_SRAM3_ECC_MD3              (SRAMC_CKCR_ECCMOD)
N#define SRAM_ECC_MD_INVD                (SRAM_SRAM3_ECC_INVD)
N/**
N * @}
N */
N
N/**
N * @defgroup SRAM_Err_Status_Flag SRAM Error Status Flag
N * @{
N */
N#define SRAM_FLAG_SRAM3_1ERR            (SRAMC_CKSR_SRAM3_1ERR)     /*!< SRAM3 ECC 1-bit error. */
N#define SRAM_FLAG_SRAM3_2ERR            (SRAMC_CKSR_SRAM3_2ERR)     /*!< SRAM3 ECC 2-bit error. */
N#define SRAM_FLAG_SRAM12_PYERR          (SRAMC_CKSR_SRAM12_PYERR)   /*!< SRAM12 parity error. */
N#define SRAM_FLAG_SRAMH_PYERR           (SRAMC_CKSR_SRAMH_PYERR)    /*!< SRAMH parity error. */
N#define SRAM_FLAG_SRAMR_PYERR           (SRAMC_CKSR_SRAMR_PYERR)    /*!< SRAMR parity error. */
N#define SRAM_FLAG_ALL                   (0x1FUL)
N
N/**
N * @}
N */
N
N/**
N * @defgroup SRAM_Reg_Protect_Key SRAM Register Protect Key
N * @{
N */
N#define SRAM_REG_LOCK_KEY               (0x76U)
N#define SRAM_REG_UNLOCK_KEY             (0x77U)
N/**
N * @}
N */
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global variable definitions ('extern')
N ******************************************************************************/
N
N/*******************************************************************************
N  Global function prototypes (definition in C source)
N ******************************************************************************/
N/**
N * @addtogroup SRAM_Global_Functions
N * @{
N */
N
N/**
N * @brief  Lock SRAM registers, write protect.
N * @param  None
N * @retval None
N */
N__STATIC_INLINE void SRAM_REG_Lock(void)
Xstatic __inline void SRAM_REG_Lock(void)
N{
N    WRITE_REG32(CM_SRAMC->WTPR, SRAM_REG_LOCK_KEY);
X    ((((CM_SRAMC_TypeDef *)(0x40050800UL))->WTPR) = ((uint32_t)((0x76U))));
N    WRITE_REG32(CM_SRAMC->CKPR, SRAM_REG_LOCK_KEY);
X    ((((CM_SRAMC_TypeDef *)(0x40050800UL))->CKPR) = ((uint32_t)((0x76U))));
N}
N
N/**
N * @brief  Unlock SRAM registers, write enable.
N * @param  None
N * @retval None
N */
N__STATIC_INLINE void SRAM_REG_Unlock(void)
Xstatic __inline void SRAM_REG_Unlock(void)
N{
N    WRITE_REG32(CM_SRAMC->WTPR, SRAM_REG_UNLOCK_KEY);
X    ((((CM_SRAMC_TypeDef *)(0x40050800UL))->WTPR) = ((uint32_t)((0x77U))));
N    WRITE_REG32(CM_SRAMC->CKPR, SRAM_REG_UNLOCK_KEY);
X    ((((CM_SRAMC_TypeDef *)(0x40050800UL))->CKPR) = ((uint32_t)((0x77U))));
N}
N
Nvoid SRAM_Init(void);
Nvoid SRAM_DeInit(void);
N
Nvoid SRAM_REG_Lock(void);
Nvoid SRAM_REG_Unlock(void);
N
Nvoid SRAM_SetWaitCycle(uint32_t u32SramSel, uint32_t u32WriteCycle, uint32_t u32ReadCycle);
Nvoid SRAM_SetEccMode(uint32_t u32EccSram, uint32_t u32EccMode);
Nvoid SRAM_SetExceptionType(uint32_t u32CheckSram, uint32_t u32ExceptionType);
N
Nen_flag_status_t SRAM_GetStatus(uint32_t u32Flag);
Nvoid SRAM_ClearStatus(uint32_t u32Flag);
N
N/**
N * @}
N */
N
N#endif /* LL_SRAM_ENABLE */
N
N/**
N * @}
N */
N
N/**
N * @}
N */
N
N#ifdef __cplusplus
S}
N#endif
N
N#endif /* __HC32_LL_SRAM_H__ */
