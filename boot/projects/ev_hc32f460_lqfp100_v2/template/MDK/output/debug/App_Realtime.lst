N/**
N *******************************************************************************
N * @file  hc32_ll_usart.h
N * @brief This file contains all the functions prototypes of the USART(Universal
N *        Synchronous/Asynchronous Receiver Transmitter) driver library.
N @verbatim
N   Change Logs:
N   Date             Author          Notes
N   2022-03-31       CDT             First version
N   2023-06-30       CDT             Modify typo
N                                    Change macro-definition: USART_DR_MPID -> USART_TDR_MPID
N                                    Modify USART_SetTransType parameter: u32Type -> u16Type
N                                    Modify USART_SC_ETU_CLK128/256 value
N                                    Modify return type of function USART_DeInit
N   2023-09-30       CDT             Remove u32StopBit param from stc_usart_smartcard_init_t structure
N   2023-12-15       CDT             Add the declaration of API USART_GetFuncState()
N   2024-06-30       CDT             Add interfaces for getting USART configuration status
N @endverbatim
N *******************************************************************************
N * Copyright (C) 2022-2025, Xiaohua Semiconductor Co., Ltd. All rights reserved.
N *
N * This software component is licensed by XHSC under BSD 3-Clause license
N * (the "License"); You may not use this file except in compliance with the
N * License. You may obtain a copy of the License at:
N *                    opensource.org/licenses/BSD-3-Clause
N *
N *******************************************************************************
N */
N#ifndef __HC32_LL_USART_H__
N#define __HC32_LL_USART_H__
N
N/* C binding of definitions if building with C++ compiler */
N#ifdef __cplusplus
Sextern "C"
S{
N#endif
N
N/*******************************************************************************
N * Include files
N ******************************************************************************/
N#include "hc32_ll_def.h"
N
N#include "hc32f4xx.h"
N#include "hc32f4xx_conf.h"
N
N/**
N * @addtogroup LL_Driver
N * @{
N */
N
N/**
N * @addtogroup LL_USART
N * @{
N */
N
N#if (LL_USART_ENABLE == DDL_ON)
X#if (((1U)) == (1U))
N
N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup USART_Global_Types USART Global Types
N * @{
N */
N
N/**
N * @brief clock synchronization mode initialization structure definition
N * @note The parameter(u32ClockDiv/u32CKOutput/u32Baudrate) is valid when clock source is the internal clock.
N */
Ntypedef struct {
N    uint32_t u32ClockSrc;               /*!< Clock Source.
N                                             This parameter can be a value of @ref USART_Clock_Source */
N    uint32_t u32ClockDiv;               /*!< Clock division.
N                                             This parameter can be a value of @ref USART_Clock_Division. */
N    uint32_t u32Baudrate;               /*!< USART baudrate.
N                                             This parameter is valid when clock source is the internal clock. */
N    uint32_t u32FirstBit;               /*!< Significant bit.
N                                             This parameter can be a value of @ref USART_First_Bit */
N    uint32_t u32HWFlowControl;          /*!< Hardware flow control.
N                                             This parameter can be a value of @ref USART_Hardware_Flow_Control */
N} stc_usart_clocksync_init_t;
N
N/**
N * @brief UART multiple-processor initialization structure definition
N * @note The parameter(u32ClockDiv/u32CKOutput/u32Baudrate) is valid when clock source is the internal clock.
N */
Ntypedef struct {
N    uint32_t u32ClockSrc;               /*!< Clock Source.
N                                             This parameter can be a value of @ref USART_Clock_Source */
N    uint32_t u32ClockDiv;               /*!< Clock division.
N                                             This parameter can be a value of @ref USART_Clock_Division. */
N    uint32_t u32CKOutput;               /*!< USART_CK output selection.
N                                             This parameter can be a value of @ref USART_CK_Output_Selection. */
N    uint32_t u32Baudrate;               /*!< USART baudrate.
N                                             This parameter is valid when clock source is the internal clock. */
N    uint32_t u32DataWidth;              /*!< Data width.
N                                             This parameter can be a value of @ref USART_Data_Width_Bit */
N    uint32_t u32StopBit;                /*!< Stop Bits.
N                                             This parameter can be a value of @ref USART_Stop_Bit */
N    uint32_t u32OverSampleBit;          /*!< Oversampling Bits.
N                                             This parameter can be a value of @ref USART_Over_Sample_Bit */
N    uint32_t u32FirstBit;               /*!< Significant bit.
N                                             This parameter can be a value of @ref USART_First_Bit */
N    uint32_t u32StartBitPolarity;       /*!< Start Bit Detect Polarity.
N                                             This parameter can be a value of @ref USART_Start_Bit_Polarity */
N    uint32_t u32HWFlowControl;          /*!< Hardware flow control.
N                                             This parameter can be a value of @ref USART_Hardware_Flow_Control */
N} stc_usart_multiprocessor_init_t;
N
N/**
N * @brief UART mode initialization structure definition
N * @note The parameter(u32ClockDiv/u32CKOutput/u32Baudrate) is valid when clock source is the internal clock.
N */
Ntypedef struct {
N    uint32_t u32ClockSrc;               /*!< Clock Source.
N                                             This parameter can be a value of @ref USART_Clock_Source */
N    uint32_t u32ClockDiv;               /*!< Clock division.
N                                             This parameter can be a value of @ref USART_Clock_Division. */
N    uint32_t u32CKOutput;               /*!< USART_CK output selection.
N                                             This parameter can be a value of @ref USART_CK_Output_Selection. */
N    uint32_t u32Baudrate;               /*!< USART baudrate.
N                                             This parameter is valid when clock source is the internal clock. */
N    uint32_t u32DataWidth;              /*!< Data width.
N                                             This parameter can be a value of @ref USART_Data_Width_Bit */
N    uint32_t u32StopBit;                /*!< Stop Bits.
N                                             This parameter can be a value of @ref USART_Stop_Bit */
N    uint32_t u32Parity;                 /*!< Parity format.
N                                             This parameter can be a value of @ref USART_Parity_Control */
N    uint32_t u32OverSampleBit;          /*!< Oversampling Bits.
N                                             This parameter can be a value of @ref USART_Over_Sample_Bit */
N    uint32_t u32FirstBit;               /*!< Significant bit.
N                                             This parameter can be a value of @ref USART_First_Bit */
N    uint32_t u32StartBitPolarity;       /*!< Start Bit Detect Polarity.
N                                             This parameter can be a value of @ref USART_Start_Bit_Polarity */
N    uint32_t u32HWFlowControl;          /*!< Hardware flow control.
N                                             This parameter can be a value of @ref USART_Hardware_Flow_Control */
N} stc_usart_uart_init_t;
N
N/**
N * @brief Smartcard mode initialization structure definition
N */
Ntypedef struct {
N    uint32_t u32ClockDiv;               /*!< Clock division. This parameter can be a value of @ref USART_Clock_Division.
N                                             @note This parameter is valid when clock source is the internal clock. */
N    uint32_t u32CKOutput;               /*!< USART_CK output selection. This parameter can be a value of @ref USART_CK_Output_Selection.
N                                             @note This parameter is valid when clock source is the internal clock. */
N    uint32_t u32Baudrate;               /*!< USART baudrate.
N                                             This parameter is calculated according with smartcard default ETU and clock. */
N    uint32_t u32FirstBit;               /*!< Significant bit.
N                                             This parameter can be a value of @ref USART_First_Bit */
N} stc_usart_smartcard_init_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup USART_Global_Macros USART Global Macros
N * @{
N */
N
N/**
N * @defgroup USART_Flag USART Flag
N * @{
N */
N#define USART_FLAG_RX_FULL              (USART_SR_RXNE)     /*!< Receive data register not empty flag */
N#define USART_FLAG_OVERRUN              (USART_SR_ORE)      /*!< Overrun error flag */
N#define USART_FLAG_TX_CPLT              (USART_SR_TC)       /*!< Transmission complete flag */
N#define USART_FLAG_TX_EMPTY             (USART_SR_TXE)      /*!< Transmit data register empty flag */
N#define USART_FLAG_FRAME_ERR            (USART_SR_FE)       /*!< Framing error flag */
N#define USART_FLAG_PARITY_ERR           (USART_SR_PE)       /*!< Parity error flag */
N#define USART_FLAG_MX_PROCESSOR         (USART_SR_MPB)      /*!< Receive processor ID flag */
N#define USART_FLAG_RX_TIMEOUT           (USART_SR_RTOF)     /*!< Receive timeout flag */
N
N#define USART_FLAG_ALL                  (USART_FLAG_RX_FULL | USART_FLAG_FRAME_ERR  | USART_FLAG_TX_EMPTY   | \
N                                         USART_FLAG_OVERRUN | USART_FLAG_PARITY_ERR | USART_FLAG_RX_TIMEOUT | \
N                                         USART_FLAG_TX_CPLT | USART_FLAG_MX_PROCESSOR)
