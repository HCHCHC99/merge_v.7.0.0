N/**
N * @brief  EFM Protect Unlock.
N * @param  None
N * @retval None
N */
N
N__STATIC_INLINE void EFM_REG_Unlock(void)
Xstatic __inline void EFM_REG_Unlock(void)
N{
N    WRITE_REG32(CM_EFM->FAPRT, EFM_REG_UNLOCK_KEY1);
X    ((((CM_EFM_TypeDef *)(0x40010400UL))->FAPRT) = ((uint32_t)((0x0123UL))));
N    WRITE_REG32(CM_EFM->FAPRT, EFM_REG_UNLOCK_KEY2);
X    ((((CM_EFM_TypeDef *)(0x40010400UL))->FAPRT) = ((uint32_t)((0x3210UL))));
N}
N
N/**
N * @brief  EFM Protect Lock.
N * @param  None
N * @retval None
N */
N__STATIC_INLINE void EFM_REG_Lock(void)
Xstatic __inline void EFM_REG_Lock(void)
N{
N    WRITE_REG32(CM_EFM->FAPRT, EFM_REG_LOCK_KEY);
X    ((((CM_EFM_TypeDef *)(0x40010400UL))->FAPRT) = ((uint32_t)((0x0000UL))));
N}
N
N/**
N * @brief  EFM remap Unlock.
N * @param  None
N * @retval None
N */
N__STATIC_INLINE void EFM_REMAP_Unlock(void)
Xstatic __inline void EFM_REMAP_Unlock(void)
N{
N    WRITE_REG32(CM_EFM->MMF_REMPRT, EFM_REMAP_REG_UNLOCK_KEY1);
X    ((((CM_EFM_TypeDef *)(0x40010400UL))->MMF_REMPRT) = ((uint32_t)((0x0123UL))));
N    WRITE_REG32(CM_EFM->MMF_REMPRT, EFM_REMAP_REG_UNLOCK_KEY2);
X    ((((CM_EFM_TypeDef *)(0x40010400UL))->MMF_REMPRT) = ((uint32_t)((0x3210UL))));
N}
N
N/**
N * @brief  EFM remap Lock.
N * @param  None
N * @retval None
N */
N__STATIC_INLINE void EFM_REMAP_Lock(void)
Xstatic __inline void EFM_REMAP_Lock(void)
N{
N    WRITE_REG32(CM_EFM->MMF_REMPRT, EFM_REMAP_REG_LOCK_KEY);
X    ((((CM_EFM_TypeDef *)(0x40010400UL))->MMF_REMPRT) = ((uint32_t)((0x0000UL))));
N}
