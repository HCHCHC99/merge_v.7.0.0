N/**
N *******************************************************************************
N * @file  hc32_ll_dma.h
N * @brief This file contains all the functions prototypes of the DMA driver
N *        library.
N @verbatim
N   Change Logs:
N   Date             Author          Notes
N   2022-03-31       CDT             First version
N   2023-06-30       CDT             Add API DMA_SetDataWidth()
N   2023-12-15       CDT             Modify API input param type:u16->u32
N                                    Add structure stc_dma_rc_nonseq_init_t
N                                    Add API DMA_ReconfigNonSeqStructInit() & DMA_ReconfigNonSeqInit()
N   2024-11-08       CDT             Add API DMA_MxChSWTrigger() and DMA_SWReconfig()
N @endverbatim
N *******************************************************************************
N * Copyright (C) 2022-2025, Xiaohua Semiconductor Co., Ltd. All rights reserved.
N *
N * This software component is licensed by XHSC under BSD 3-Clause license
N * (the "License"); You may not use this file except in compliance with the
N * License. You may obtain a copy of the License at:
N *                    opensource.org/licenses/BSD-3-Clause
N *
N *******************************************************************************
N */
N#ifndef __HC32_LL_DMA_H__
N#define __HC32_LL_DMA_H__
N
N/* C binding of definitions if building with C++ compiler */
N#ifdef __cplusplus
Sextern "C"
S{
N#endif
N
N/*******************************************************************************
N * Include files
N ******************************************************************************/
N#include "hc32_ll_def.h"
N
N#include "hc32f4xx.h"
N#include "hc32f4xx_conf.h"
N/**
N * @addtogroup LL_Driver
N * @{
N */
N
N/**
N * @addtogroup LL_DMA
N * @{
N */
N
N#if (LL_DMA_ENABLE == DDL_ON)
X#if (((1U)) == (1U))
N
N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup DMA_Global_Types DMA Global Types
N * @{
N */
N
N/**
N * @brief  DMA basic configuration
N */
Ntypedef struct {
N    uint32_t u32IntEn;          /*!< Specifies the DMA interrupt function.
N                                    This parameter can be a value of @ref DMA_Int_Config                */
N    uint32_t u32SrcAddr;        /*!< Specifies the DMA source address.                                  */
N    uint32_t u32DestAddr;       /*!< Specifies the DMA destination address.                             */
N    uint32_t u32DataWidth;      /*!< Specifies the DMA transfer data width.
N                                    This parameter can be a value of @ref DMA_DataWidth_Sel             */
N    uint32_t u32BlockSize;      /*!< Specifies the DMA block size.                                      */
N    uint32_t u32TransCount;     /*!< Specifies the DMA transfer count.                                  */
N    uint32_t u32SrcAddrInc;     /*!< Specifies the source address increment mode.
N                                    This parameter can be a value of @ref DMA_SrcAddr_Incremented_Mode  */
N    uint32_t u32DestAddrInc;    /*!< Specifies the destination address increment mode.
N                                    This parameter can be a value of @ref DMA_DesAddr_Incremented_Mode  */
N} stc_dma_init_t;
N
N/**
N * @brief  DMA repeat mode configuration
N */
Ntypedef struct {
N    uint32_t u32Mode;       /*!< Specifies the DMA source repeat function.
N                                This parameter can be a value of @ref DMA_Repeat_Config */
N    uint32_t u32SrcCount;   /*!< Specifies the DMA source repeat size. */
N    uint32_t u32DestCount;  /*!< Specifies the DMA destination repeat size. */
N} stc_dma_repeat_init_t;
N
N/**
N * @brief  DMA non-sequence mode configuration
N */
Ntypedef struct {
N    uint32_t u32Mode;        /*!< Specifies the DMA source non-sequence function.
N                                        This parameter can be a value of @ref DMA_NonSeq_Config */
N    uint32_t u32SrcCount;     /*!< Specifies the DMA source non-sequence function count. */
N    uint32_t u32SrcOffset;    /*!< Specifies the DMA source non-sequence function offset. */
N    uint32_t u32DestCount;    /*!< Specifies the DMA destination non-sequence function count. */
N    uint32_t u32DestOffset;   /*!< Specifies the DMA destination non-sequence function offset. */
N} stc_dma_nonseq_init_t;
N
N/**
N * @brief  DMA Link List Pointer (LLP) mode configuration
N */
Ntypedef struct {
N    uint32_t u32State;      /*!< Specifies the DMA LLP function.
N                                This parameter can be a value of @ref DMA_Llp_En */
N    uint32_t u32Mode;       /*!< Specifies the DMA LLP auto or wait REQ.
N                                This parameter can be a value of @ref DMA_Llp_Mode */
N    uint32_t u32Addr;       /*!< Specifies the DMA list pointer address for LLP function. */
N} stc_dma_llp_init_t;
N
N/**
N * @brief  DMA re-config function configuration
N */
Ntypedef struct {
N    uint32_t u32CountMode;          /*!< Specifies the DMA reconfig function count mode.
N                                      This parameter can be a value of @ref DMA_Reconfig_Count_Sel */
N    uint32_t u32DestAddrMode;       /*!< Specifies the DMA reconfig function destination address mode.
N                                        This parameter can be a value of @ref DMA_Reconfig_DestAddr_Sel */
N    uint32_t u32SrcAddrMode;        /*!< Specifies the DMA reconfig function source address mode.
N                                        This parameter can be a value of @ref DMA_Reconfig_SrcAddr_Sel */
N} stc_dma_reconfig_init_t;
N
N/**
N * @brief  DMA re-config non-sequence mode configuration
N */
Ntypedef struct {
N    uint32_t u32Mode;           /*!< Specifies the DMA source non-sequence function.
N                                    This parameter can be a value of @ref DMA_NonSeq_Config         */
N    uint32_t u32SrcCount;       /*!< Specifies the DMA source non-sequence function count.          */
N    uint32_t u32SrcDist;        /*!< Specifies the DMA source non-sequence function distance.       */
N    uint32_t u32DestCount;      /*!< Specifies the DMA destination non-sequence function count.     */
N    uint32_t u32DestDist;       /*!< Specifies the DMA destination non-sequence function distance.  */
N} stc_dma_rc_nonseq_init_t;
N
N/**
N * @brief  Dma LLP(linked list pointer) descriptor structure definition
N */
Ntypedef struct {
N    uint32_t SARx;              /*!< LLP source address */
N    uint32_t DARx;              /*!< LLP destination address */
N    uint32_t DTCTLx;            /*!< LLP transfer count and block size */
N    uint32_t RPTx;              /*!< LLP source & destination repeat size */
N    uint32_t SNSEQCTLx;         /*!< LLP source non-seq count and offset */
N    uint32_t DNSEQCTLx;         /*!< LLP destination non-seq count and offset */
