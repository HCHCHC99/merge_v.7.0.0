N/**
N * @addtogroup TMR6_Global_Functions
N * @{
N */
N/**
N * @brief  Get Software Sync start status
N * @param  None
N * @retval uint32_t                 Data indicate the read status.
N */
N__STATIC_INLINE uint32_t TMR6_GetSWSyncStartStatus(void)
Xstatic __inline uint32_t TMR6_GetSWSyncStartStatus(void)
N{
N    return READ_REG32(CM_TMR6_COMMON->SSTAR);
X    return (((CM_TMR6_COMMON_TypeDef *)(0x40018300UL))->SSTAR);
N}
N
