N
N#ifndef __ADC_H__
S#define __ADC_H__
S
S#include "main.h"
S#include "Hardware.h"
S#include "TickTimer.h"
S
S#define ADC_RTT 1
S
S#ifdef DEBUG_ADC_Adp
S    #define ADC_Adp_DEBUG(fmt, ...)    MAIN_D("[ADC_DEBUG] " fmt, ##__VA_ARGS__)
S#else
S    #define ADC_Adp_DEBUG(fmt, ...)    ((void)0)
S#endif
S
S#ifdef ADC_OUTPUT_Adp
S    #define ADC_Adp_OUT(fmt, ...)      MAIN_D("[ADC_OUT] " fmt, ##__VA_ARGS__)
S#else
S    #define ADC_Adp_OUT(fmt, ...)      ((void)0)
S#endif
S
S#ifdef __cplusplus
Sextern "C" {
S#endif
S
S/*******************************************************************************
S * Global pre-processor symbols/macros ('#define')
S ******************************************************************************/
S
S/* DMAª∫≥Â«¯¥Û–°∂®“Â */
S#define ADC_DMA_BUFFER_SIZE              (8U)  /* √ø¥Œ¥•∑¢≤…ºØ8¥Œ */
S
S/* ADC”≤º˛≈‰÷√∫Í */
S#define ADC_UNIT                        (CM_ADC1)
S#define ADC_PERIPH_CLK                  (FCG3_PERIPH_ADC1)
S
S/* ===== –Ú¡–A¥•∑¢≈‰÷√£®µ⁄“ªº∂£∫TMR0 °˙ ADC£©===== */
S#define ADC_SEQA_HARDTRIG               (ADC_HARDTRIG_EVT0)        /*  π”√ ¬º˛¥•∑¢ */
S#define ADC_SEQA_AOS_TRIG_SEL           (AOS_ADC1_0)               /* ADC1µƒ ¬º˛ ‰»Î */
S#define ADC_SEQA_TRIG_EVT               (EVT_SRC_TMR0_1_CMP_B)     /* ∂® ±∆˜±»Ωœ ¬º˛ */
S
S/* ===== DMA¥•∑¢≈‰÷√£®µ⁄∂˛º∂£∫ADC °˙ DMA£©===== */
S#define DMA_UNIT                        (CM_DMA1)
S#define DMA_PERIPH_CLK                  (FCG0_PERIPH_DMA1)
S#define DMA_DATA_WIDTH                  (DMA_DATAWIDTH_16BIT)      /* 16Œª ˝æ› */
S#define DMA_TRANS_CNT                   (0U)                        /* 0:Œﬁœﬁ¥´ ‰ */
S#define DMA_INT_PRIO                    (DDL_IRQ_PRIO_03)
S
S/* Timer0 for sequence A */
S#define TMR0_UNIT                       (CM_TMR0_1)
S#define TMR0_CH                         (TMR0_CH_B)
S#define TMR0_PERIPH_CLK                 (FCG2_PERIPH_TMR0_1)
S#define TMR0_CLK_DIV                    (TMR0_CLK_DIV256)
S
S/* ADC–Ú¡–A÷–∂œ≈‰÷√ */
S#define ADC_SEQA_INT_PRIO               (DDL_IRQ_PRIO_04)
S#define ADC_SEQA_INT_SRC                (INT_SRC_ADC1_EOCA)
S#define ADC_SEQA_INT_IRQn               (INT116_IRQn)
S
S/* ADC≤ŒøºµÁ—π */
S#define ADC_VREF                        (3.3F)
S#define ADC_ACCURACY                    (1UL << 12U)
S#define ADC_CAL_VOL(adcVal)             (uint16_t)((((float32_t)(adcVal) * ADC_VREF) / ((float32_t)ADC_ACCURACY)) * 1000.F)
S
S/* ◊Ó¥ÛADC µ¿˝ ˝¡ø */
S#define ADC_MAX_INSTANCES               (8U)
S
S/* ◊Ó¥ÛADCÕ®µ¿∫≈ */
S#define ADC_MAX_CHANNEL                 (32U)
S
S/* ◊Ó¥ÛDMAÕ®µ¿ ˝ */
S#define ADC_MAX_DMA_CH                  (8U)
S
S/*******************************************************************************
S * Global type definitions ('typedef')
S ******************************************************************************/
S
S/**
S * @brief  ADCÕ®µ¿¥¶¿Ìƒ£ Ω∂®“Â
S */
Stypedef enum {
S    ADC_MODE_INTERRUPT = 0,    /* ÷–∂œƒ£ Ω */
S    ADC_MODE_DMA = 1,          /* DMAƒ£ Ω */
S} en_adc_mode_t;
S
S/**
S * @brief  ADC“˝Ω≈”≥…‰Ω·ππÃÂ
S */
Stypedef struct {
S    uint8_t u8Port;      /* GPIO∂Àø⁄ (»Á GPIO_PORT_A) */
S    uint8_t u8Pin;       /* GPIO“˝Ω≈ (»Á GPIO_PIN_01) */
S} stc_adc_pin_t;
S
S/**
S * @brief  ADCÕ®µ¿≈‰÷√Ω·ππÃÂ (”√ªß¥¥Ω® ±ÃÓ–¥)
S */
Stypedef struct {
S    uint8_t u8Channel;              /* ADCÕ®µ¿∫≈ (»Á ADC_CH1, ADC_CH4 µ») */
S    en_adc_mode_t enMode;           /* ¥¶¿Ìƒ£ Ω */
S    stc_adc_pin_t stcPin;           /* “˝Ω≈≈‰÷√ */
S    void (*pfnCallback)(uint16_t u16AdcValue);  /* ÷–∂œƒ£ Ωªÿµ˜∫Ø ˝ */
S    /* DMAœ‡πÿ≈‰÷√ - ÷ª”–ƒ£ ΩŒ™DMA ±≤≈”––ß */
S    struct {
S        uint16_t u16BufferSize;       /* DMAª∫≥Â«¯¥Û–° */
S        uint8_t u8DmaChannel;         /*  π”√µƒDMAÕ®µ¿ */
S    } stcDmaConfig;
S} stc_adc_config_t;
S
S
Stypedef struct {
S    uint8_t u8Id;                    /* ADC µ¿˝ID (0-7) */
S    uint8_t u8Channel;              /* ADCÕ®µ¿∫≈ */
S    en_adc_mode_t enMode;           /* ¥¶¿Ìƒ£ Ω */
S    uint8_t u8Port;                 /* GPIO∂Àø⁄ */
S    uint8_t u8Pin;                  /* GPIO“˝Ω≈ */
S    void (*pfnCallback)(uint16_t u16AdcValue);  /* ÷–∂œƒ£ Ωªÿµ˜∫Ø ˝ */
S    /* DMAœ‡πÿ */
S    uint16_t *pu16DmaBuffer;         /* DMAª∫≥Â«¯÷∏’Î */
S    uint16_t u16DmaBufferSize;       /* DMAª∫≥Â«¯¥Û–° */
S    uint8_t u8DmaChannel;            /*  π”√µƒDMAÕ®µ¿ */
S    /* ‘À––◊¥Ã¨ */
S    uint32_t u32SampleCount;         /* ≤…—˘º∆ ˝ */
S    uint16_t u16LatestValue;         /* ◊Ó–¬÷µ (÷–∂œƒ£ Ω) */
S    uint8_t u8ValueUpdated;          /*  ˝æ›∏¸–¬±Í÷æ */
S} stc_adc_instance_t;
S
S
S/*******************************************************************************
S * Global function prototypes
S ******************************************************************************/
S
S/* ADC  µ¿˝π‹¿Ì */
Suint8_t Adc_Create(stc_adc_config_t *pstcConfig);
Svoid Adc_Init(void);
Svoid Adc_DeInit(void);
S
S/* ADC øÿ÷∆∫Ø ˝ */
Svoid Adc_Start(void);
Svoid Adc_Stop(void);
Svoid Adc_ProcessData(uint32_t u32PrintIntervalMs);
S
S/* ADC  ˝æ›ªÒ»°∫Ø ˝ */
Suint16_t Adc_GetLatestValue(uint8_t u8AdcId);
Suint16_t Adc_GetAverageValue(uint8_t u8AdcId);
Suint32_t Adc_GetSampleCount(uint8_t u8AdcId);
S
S/* ∏˘æ›Õ®µ¿∫≈≤È’“ADC ID */
Sint8_t Adc_FindIdByChannel(uint8_t u8Channel);
S
S/* ÷ÿ–¬ πƒ‹ADC÷–∂œ£®”√”⁄‘⁄“—”–DMAÕ®µ¿∫ÛÃÌº”÷–∂œƒ£ ΩÕ®µ¿£© */
Svoid Adc_EnableInterrupt(void);
S
S/* µ˜ ‘–≈œ¢ */
S#ifdef DEBUG
Svoid Adc_PrintDebugInfo(void);
S#endif
S
S#ifdef __cplusplus
S}
S#endif
S
N#endif /* __ADC_H__ */
