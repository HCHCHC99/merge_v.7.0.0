N
N/**
N * @brief  Set FCM upper limit value.
N * @param  [in] FCMx FCM unit instance.
N *   @arg  CM_FCMx or CM_FCM
N * @param  u16Limit
N * @retval None.
N */
N__STATIC_INLINE void FCM_SetUpperLimit(CM_FCM_TypeDef *FCMx, uint16_t u16Limit)
Xstatic __inline void FCM_SetUpperLimit(CM_FCM_TypeDef *FCMx, uint16_t u16Limit)
N{
N    WRITE_REG32(FCMx->UVR, u16Limit);
X    ((FCMx->UVR) = ((uint32_t)(u16Limit)));
N}
N
N/**
N * @brief  Set FCM lower limit value.
N * @param  [in] FCMx FCM unit instance.
N *   @arg  CM_FCMx or CM_FCM
N * @param  u16Limit
N * @retval None
N */
N__STATIC_INLINE void FCM_SetLowerLimit(CM_FCM_TypeDef *FCMx, uint16_t u16Limit)
Xstatic __inline void FCM_SetLowerLimit(CM_FCM_TypeDef *FCMx, uint16_t u16Limit)
N{
N    WRITE_REG32(FCMx->LVR, u16Limit);
X    ((FCMx->LVR) = ((uint32_t)(u16Limit)));
N}
N
