N * @{
N */
N#define ADC1_PIN_PA0                    (0U)    /*!< ADC1_IN0(PA0): default channel is ADC_CH0 of ADC1. */
N#define ADC1_PIN_PA1                    (1U)    /*!< ADC1_IN1(PA1): default channel is ADC_CH1 of ADC1. */
N#define ADC1_PIN_PA2                    (2U)    /*!< ADC1_IN2(PA2): default channel is ADC_CH2 of ADC1. */
N#define ADC1_PIN_PA3                    (3U)    /*!< ADC1_IN3(PA3): default channel is ADC_CH3 of ADC1. */
N#define ADC1_PIN_PA4                    (4U)    /*!< ADC12_IN4(PA4): default channel is ADC_CH4 of ADC1. */
N#define ADC1_PIN_PA5                    (5U)    /*!< ADC12_IN5(PA5): default channel is ADC_CH5 of ADC1. */
N#define ADC1_PIN_PA6                    (6U)    /*!< ADC12_IN6(PA6): default channel is ADC_CH6 of ADC1. */
N#define ADC1_PIN_PA7                    (7U)    /*!< ADC12_IN7(PA7): default channel is ADC_CH7 of ADC1. */
N#define ADC1_PIN_PB0                    (8U)    /*!< ADC12_IN8(PB0): default channel is ADC_CH8 of ADC1. */
N#define ADC1_PIN_PB1                    (9U)    /*!< ADC12_IN9(PB1): default channel is ADC_CH9 of ADC1. */
N#define ADC1_PIN_PC0                    (10U)   /*!< ADC12_IN10(PC0): default channel is ADC_CH10 of ADC1. */
N#define ADC1_PIN_PC1                    (11U)   /*!< ADC12_IN11(PC1): default channel is ADC_CH11 of ADC1. */
N#define ADC1_PIN_PC2                    (12U)   /*!< ADC1_IN12(PC2): default channel is ADC_CH12 of ADC1. */
N#define ADC1_PIN_PC3                    (13U)   /*!< ADC1_IN13(PC3): default channel is ADC_CH13 of ADC1. */
N#define ADC1_PIN_PC4                    (14U)   /*!< ADC1_IN14(PC4): default channel is ADC_CH14 of ADC1. */
N#define ADC1_PIN_PC5                    (15U)   /*!< ADC1_IN15(PC5): default channel is ADC_CH15 of ADC1. */
N
N#define ADC2_PIN_PA4                    (0U)    /*!< ADC12_IN4(PA4): default channel is ADC_CH0 of ADC2 */
N#define ADC2_PIN_PA5                    (1U)    /*!< ADC12_IN5(PA5): default channel is ADC_CH1 of ADC2 */
N#define ADC2_PIN_PA6                    (2U)    /*!< ADC12_IN6(PA6): default channel is ADC_CH2 of ADC2 */
N#define ADC2_PIN_PA7                    (3U)    /*!< ADC12_IN7(PA7): default channel is ADC_CH3 of ADC2 */
N#define ADC2_PIN_PB0                    (4U)    /*!< ADC12_IN8(PB0): default channel is ADC_CH4 of ADC2 */
N#define ADC2_PIN_PB1                    (5U)    /*!< ADC12_IN9(PB1): default channel is ADC_CH5 of ADC2 */
N#define ADC2_PIN_PC0                    (6U)    /*!< ADC12_IN10(PC0): default channel is ADC_CH6 of ADC2 */
N#define ADC2_PIN_PC1                    (7U)    /*!< ADC12_IN11(PC1): default channel is ADC_CH7 of ADC2 */
