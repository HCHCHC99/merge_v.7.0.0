N/**
N *******************************************************************************
N * @file  hc32_ll_sdioc.h
N * @brief This file contains all the functions prototypes of the SDIOC driver
N *        library.
N @verbatim
N   Change Logs:
N   Date             Author          Notes
N   2022-03-31       CDT             First version
N   2023-09-30       CDT             Modify typo
N                                    Rename function SDMMC_ACMD41_SendOperatCond to SDMMC_ACMD41_SendOperateCond
N                                    Rename function SDMMC_CMD1_SendOperatCond to SDMMC_CMD1_SendOperateCond
N                                    Support CMD5/CMD52/CMD53
N                                    Rename macro definition SDIOC_ACMD52_RW_DIRECT to SDIOC_CMD52_IO_RW_DIRECT
N                                    Rename macro definition SDIOC_ACMD53_RW_EXTENDED to SDIOC_CMD53_IO_RW_EXTENDED
N   2024-08-31       CDT             Add parameter for SDMMC_CMD38_Erase
N @endverbatim
N *******************************************************************************
N * Copyright (C) 2022-2025, Xiaohua Semiconductor Co., Ltd. All rights reserved.
N *
N * This software component is licensed by XHSC under BSD 3-Clause license
N * (the "License"); You may not use this file except in compliance with the
N * License. You may obtain a copy of the License at:
N *                    opensource.org/licenses/BSD-3-Clause
N *
N *******************************************************************************
N */
N#ifndef __HC32_LL_SDIOC_H__
N#define __HC32_LL_SDIOC_H__
N
N/* C binding of definitions if building with C++ compiler */
N#ifdef __cplusplus
Sextern "C"
S{
N#endif
N
N/*******************************************************************************
N * Include files
N ******************************************************************************/
N#include "hc32_ll_def.h"
N
N#include "hc32f4xx.h"
N#include "hc32f4xx_conf.h"
N/**
N * @addtogroup LL_Driver
N * @{
N */
N
N/**
N * @addtogroup LL_SDIOC
N * @{
N */
N
N#if (LL_SDIOC_ENABLE == DDL_ON)
X#if (((1U)) == (1U))
N
N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup SDIOC_Global_Types SDIOC Global Types
N * @{
N */
N
N/**
N * @brief SDIOC Init structure definition
N */
Ntypedef struct {
N    uint32_t u32Mode;                   /*!< Specifies the SDIOC work mode.
N                                             This parameter can be a value of @ref SDIOC_Mode */
N    uint8_t  u8CardDetect;              /*!< Specifies the SDIOC card detect way.
N                                             This parameter can be a value of @ref SDIOC_Card_Detect_Way */
N    uint8_t  u8SpeedMode;               /*!< Specifies the SDIOC speed mode.
N                                             This parameter can be a value of @ref SDIOC_Speed_Mode */
N    uint8_t  u8BusWidth;                /*!< Specifies the SDIOC bus width.
N                                             This parameter can be a value of @ref SDIOC_Bus_Width */
N    uint16_t u16ClockDiv;               /*!< Specifies the SDIOC clock division.
N                                             This parameter can be a value of @ref SDIOC_Clock_Division */
N} stc_sdioc_init_t;
N
N/**
N * @brief SDIOC Command Configuration structure definition
N */
Ntypedef struct {
N    uint32_t u32Argument;               /*!< Specifies the SDIOC command argument. */
N    uint16_t u16CmdIndex;               /*!< Specifies the SDIOC command index.
N                                             This parameter must be a number between Min_Data = 0 and Max_Data = 63 */
N    uint16_t u16CmdType;                /*!< Specifies the SDIOC command type.
N                                             This parameter can be a value of @ref SDIOC_Command_Type */
N    uint16_t u16DataLine;               /*!< Specifies whether SDIOC uses data lines in current command.
N                                             This parameter can be a value of @ref SDIOC_Data_Line_Valid */
N    uint16_t u16ResponseType;           /*!< Specifies the SDIOC response type.
N                                             This parameter can be a value of @ref SDIOC_Response_Type */
N} stc_sdioc_cmd_config_t;
N
N/**
N * @brief SDIOC Data Configuration structure definition
N */
Ntypedef struct {
N    uint16_t u16BlockSize;              /*!< Specifies the SDIOC data block size.
N                                             This parameter must be a number between Min_Data = 1 and Max_Data = 512 */
N    uint16_t u16BlockCount;             /*!< Specifies the SDIOC data block count.
N                                             This parameter must be a number between Min_Data = 0 and Max_Data = 0xFFFF */
N    uint16_t u16TransDir;               /*!< Specifies the SDIOC data transfer direction.
N                                             This parameter can be a value of @ref SDIOC_Transfer_Direction */
N    uint16_t u16AutoCmd12;              /*!< Specifies the validity of the SDIOC Auto Send CMD12.
N                                             This parameter can be a value of @ref SDIOC_Auto_Send_CMD12 */
N    uint16_t u16TransMode;              /*!< Specifies the SDIOC data transfer mode.
N                                             This parameter can be a value of @ref SDIOC_Transfer_Mode */
N    uint8_t  u16DataTimeout;            /*!< Specifies the SDIOC data timeout time.
N                                             This parameter can be a value of @ref SDIOC_Data_Timeout_Time */
N} stc_sdioc_data_config_t;
N
N/**
N * @brief SDIO CMD52 arguments structure definition
N */
Ntypedef struct {
N    uint8_t u8FuncNum;                  /*!< Specifies the number of the function within the I/O card.
N                                             This parameter must be a number between Min_Data = 0 and Max_Data = 7 */
N    uint32_t u32RwFlag;                 /*!< Specifies the direction of the I/O operation.
N                                             This parameter can be a value of @ref SDIO_CMD52_Arguments_RW_Flag */
N    uint32_t u32RegAddr;                /*!< Specifies the address of the byte of data inside of the selected function.
N                                             This parameter must be a number between Min_Data = 0 and Max_Data = 0x1FFFF */
N    uint32_t u32RawFlag;                /*!< Specifies the direction of the I/O operation.
N                                             This parameter can be a value of @ref SDIO_CMD52_Arguments_RAW_Flag */
N} stc_sdio_cmd52_arg_t;
N
N/**
N * @brief SDIO CMD53 arguments structure definition
N */
Ntypedef struct {
N    uint8_t u8FuncNum;                  /*!< Specifies the number of the function within the I/O card.
N                                             This parameter must be a number between Min_Data = 0 and Max_Data = 7 */
N    uint32_t u32RwFlag;                 /*!< Specifies the direction of the I/O operation.
N                                             This parameter can be a value of @ref SDIO_CMD53_Arguments_RW_Flag */
N    uint32_t u32RegAddr;                /*!< Specifies the address of the byte of data inside of the selected function.
N                                             This parameter must be a number between Min_Data = 0 and Max_Data = 0x1FFFF */
N    uint32_t u32OperateCode;            /*!< Specifies the operation code.
N                                             This parameter can be a value of @ref SDIO_CMD53_Arguments_Operate_Code */
N    uint32_t u32BlockMode;              /*!< Specifies the operation code.
N                                             This parameter can be a value of @ref SDIO_CMD53_Arguments_Block_Mode */
N    uint32_t u32Count;                  /*!< Specifies the byte/block count.
N                                             This parameter must be a number between Min_Data = 0 and Max_Data = 0x1FF */
N} stc_sdio_cmd53_arg_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup SDIOC_Global_Macros SDIOC Global Macros
N * @{
N */
N
N/**
N * @defgroup SDIOC_Mode SDIOC Mode
N * @{
N */
N#define SDIOC_MD_SD                             (0x00UL)    /*!< SDIOCx selects SD mode  */
N#define SDIOC_MD_MMC                            (0x01UL)    /*!< SDIOCx selects MMC mode */
N/**
N * @}
N */
N
