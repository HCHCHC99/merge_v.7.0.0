N */
N#define FCM_REF_CLK_RISING          (0x00UL)
N#define FCM_REF_CLK_FALLING         (FCM_RCCR_EDGES_0)
N#define FCM_REF_CLK_BOTH            (FCM_RCCR_EDGES_1)
N/**
N * @}
N */
N
