N *
N *******************************************************************************
N */
N#ifndef __HC32_LL_TMR0_H__
N#define __HC32_LL_TMR0_H__
N
N/* C binding of definitions if building with C++ compiler */
N#ifdef __cplusplus
Sextern "C"
S{
N#endif
N
N/*******************************************************************************
N * Include files
N ******************************************************************************/
N#include "hc32_ll_def.h"
N
N#include "hc32f4xx.h"
N#include "hc32f4xx_conf.h"
N
N/**
N * @addtogroup LL_Driver
N * @{
N */
N
N/**
N * @addtogroup LL_TMR0
N * @{
N */
N
N#if (LL_TMR0_ENABLE == DDL_ON)
X#if (((1U)) == (1U))
N
N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup TMR0_Global_Types TMR0 Global Types
N * @{
N */
N
N/**
N * @brief TMR0 initialization structure definition
N * @note  The 'u32ClockDiv' is invalid when the value of 'u32ClockSrc' is "TMR0_CLK_SRC_SPEC_EVT".
N */
Ntypedef struct {
N    uint32_t u32ClockSrc;               /*!< Specifies the clock source of TMR0 channel.
N                                             This parameter can be a value of @ref TMR0_Clock_Source */
N    uint32_t u32ClockDiv;               /*!< Specifies the clock division of TMR0 channel.
N                                             This parameter can be a value of @ref TMR0_Clock_Division */
N    uint32_t u32Func;                   /*!< Specifies the function of TMR0 channel.
N                                             This parameter can be a value of @ref TMR0_Function */
N    uint16_t u16CompareValue;           /*!< Specifies the compare value of TMR0 channel.
N                                             This parameter can be a value of half-word */
N} stc_tmr0_init_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup TMR0_Global_Macros TMR0 Global Macros
N * @{
N */
N
N/**
N * @defgroup TMR0_Channel TMR0 Channel
N * @{
N */
N#define TMR0_CH_A                       (0UL)
N#define TMR0_CH_B                       (1UL)
N/**
N * @}
N */
N
N/**
N * @defgroup TMR0_Clock_Source TMR0 Clock Source
N * @note In asynchronous clock, continuous operation of the BCONR register requires waiting for 6 asynchronous clocks.
N * @{
N */
N#define TMR0_CLK_SRC_INTERN_CLK         (0UL)                                       /*!< Internal clock (Synchronous clock)  */
N#define TMR0_CLK_SRC_SPEC_EVT           (TMR0_BCONR_SYNCLKA)                        /*!< Specified event (Synchronous clock) */
N#define TMR0_CLK_SRC_LRC                (TMR0_BCONR_SYNSA)                          /*!< LRC (Asynchronous clock)            */
N#define TMR0_CLK_SRC_XTAL32             (TMR0_BCONR_ASYNCLKA | TMR0_BCONR_SYNSA)    /*!< XTAL32 (Asynchronous clock)         */
N/**
N * @}
N */
N
N/**
N * @defgroup TMR0_Clock_Division TMR0 Clock Division
N * @{
N */
N#define TMR0_CLK_DIV1                   (0UL  << TMR0_BCONR_CKDIVA_POS)     /*!< CLK      */
N#define TMR0_CLK_DIV2                   (1UL  << TMR0_BCONR_CKDIVA_POS)     /*!< CLK/2    */
N#define TMR0_CLK_DIV4                   (2UL  << TMR0_BCONR_CKDIVA_POS)     /*!< CLK/4    */
N#define TMR0_CLK_DIV8                   (3UL  << TMR0_BCONR_CKDIVA_POS)     /*!< CLK/8    */
N#define TMR0_CLK_DIV16                  (4UL  << TMR0_BCONR_CKDIVA_POS)     /*!< CLK/16   */
N#define TMR0_CLK_DIV32                  (5UL  << TMR0_BCONR_CKDIVA_POS)     /*!< CLK/32   */
N#define TMR0_CLK_DIV64                  (6UL  << TMR0_BCONR_CKDIVA_POS)     /*!< CLK/64   */
N#define TMR0_CLK_DIV128                 (7UL  << TMR0_BCONR_CKDIVA_POS)     /*!< CLK/128  */
N#define TMR0_CLK_DIV256                 (8UL  << TMR0_BCONR_CKDIVA_POS)     /*!< CLK/256  */
N#define TMR0_CLK_DIV512                 (9UL  << TMR0_BCONR_CKDIVA_POS)     /*!< CLK/512  */
N#define TMR0_CLK_DIV1024                (10UL << TMR0_BCONR_CKDIVA_POS)     /*!< CLK/1024 */
N/**
N * @}
N */
N
N/**
N * @defgroup TMR0_Function TMR0 Function
N * @{
N */
N#define TMR0_FUNC_CMP                   (0UL)                                   /*!< Output compare function */
N#define TMR0_FUNC_CAPT                  (TMR0_BCONR_CAPMDA | TMR0_BCONR_HICPA)  /*!< Input capture function */
N/**
N * @}
N */
N
N/**
N * @defgroup TMR0_Interrupt TMR0 Interrupt
N * @{
N */
N#define TMR0_INT_CMP_A                  (TMR0_BCONR_INTENA)
N#define TMR0_INT_CMP_B                  (TMR0_BCONR_INTENB)
N#define TMR0_INT_ALL                    (TMR0_INT_CMP_A | TMR0_INT_CMP_B)
N/**
N * @}
N */
N
