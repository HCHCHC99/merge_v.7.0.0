Ndo {                                                                           \
N    ((x) ? (void)0 : DDL_AssertHandler(__FILE__, __LINE__));                   \
N} while (0)
X#define DDL_ASSERT(x)                                                          do {                                                                               ((x) ? (void)0 : DDL_AssertHandler(__FILE__, __LINE__));                   } while (0)
N/* Exported function */
