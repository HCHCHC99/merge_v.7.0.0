N/**
N *******************************************************************************
N ** \brief Event number enumeration
N ******************************************************************************/
Ntypedef enum {
N    EVT_SRC_SWI_IRQ0            = 0U,       /* SWI_IRQ0  */
N    EVT_SRC_SWI_IRQ1            = 1U,       /* SWI_IRQ1  */
N    EVT_SRC_SWI_IRQ2            = 2U,       /* SWI_IRQ2  */
N    EVT_SRC_SWI_IRQ3            = 3U,       /* SWI_IRQ3  */
N    EVT_SRC_SWI_IRQ4            = 4U,       /* SWI_IRQ4  */
N    EVT_SRC_SWI_IRQ5            = 5U,       /* SWI_IRQ5  */
N    EVT_SRC_SWI_IRQ6            = 6U,       /* SWI_IRQ6  */
N    EVT_SRC_SWI_IRQ7            = 7U,       /* SWI_IRQ7  */
N    EVT_SRC_SWI_IRQ8            = 8U,       /* SWI_IRQ8  */
N    EVT_SRC_SWI_IRQ9            = 9U,       /* SWI_IRQ9  */
N    EVT_SRC_SWI_IRQ10           = 10U,      /* SWI_IRQ10 */
N    EVT_SRC_SWI_IRQ11           = 11U,      /* SWI_IRQ11 */
N    EVT_SRC_SWI_IRQ12           = 12U,      /* SWI_IRQ12 */
N    EVT_SRC_SWI_IRQ13           = 13U,      /* SWI_IRQ13 */
N    EVT_SRC_SWI_IRQ14           = 14U,      /* SWI_IRQ14 */
N    EVT_SRC_SWI_IRQ15           = 15U,      /* SWI_IRQ15 */
N    EVT_SRC_SWI_IRQ16           = 16U,      /* SWI_IRQ16 */
N    EVT_SRC_SWI_IRQ17           = 17U,      /* SWI_IRQ17 */
