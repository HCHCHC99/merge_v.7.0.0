N/**
N *******************************************************************************
N * @file  hc32_ll_keyscan.h
N * @brief This file contains all the functions prototypes of the KEYSCAN driver
N *        library.
N @verbatim
N   Change Logs:
N   Date             Author          Notes
N   2022-03-31       CDT             First version
N   2023-06-30       CDT             Add function KEYSCAN_DeInit
N @endverbatim
N *******************************************************************************
N * Copyright (C) 2022-2025, Xiaohua Semiconductor Co., Ltd. All rights reserved.
N *
N * This software component is licensed by XHSC under BSD 3-Clause license
N * (the "License"); You may not use this file except in compliance with the
N * License. You may obtain a copy of the License at:
N *                    opensource.org/licenses/BSD-3-Clause
N *
N *******************************************************************************
N */
N#ifndef __HC32_LL_KEYSCAN_H__
N#define __HC32_LL_KEYSCAN_H__
N
N/* C binding of definitions if building with C++ compiler */
N#ifdef __cplusplus
Sextern "C"
S{
N#endif
N
N/*******************************************************************************
N * Include files
N ******************************************************************************/
N#include "hc32_ll_def.h"
N
N#include "hc32f4xx.h"
N#include "hc32f4xx_conf.h"
N/**
N * @addtogroup LL_Driver
N * @{
N */
N
N/**
N * @addtogroup LL_KEYSCAN
N * @{
N */
N
N#if (LL_KEYSCAN_ENABLE == DDL_ON)
X#if (((1U)) == (1U))
N
N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup KEYSCAN_Global_Types KEYSCAN Global Types
N * @{
N */
N
N/**
N * @brief  KEYSCAN configuration
N */
Ntypedef struct {
N    uint32_t u32HizCycle;           /*!< Specifies the KEYSCAN Hiz cycles.
N                                        This parameter can be a value of @ref KEYSCAN_Hiz_Cycle_Sel */
N
N    uint32_t u32LowCycle;           /*!< Specifies the KEYSCAN low cycles.
N                                        This parameter can be a value of @ref KEYSCAN_Low_Cycle_Sel */
N
N    uint32_t u32KeyClock;           /*!< Specifies the KEYSCAN low cycles.
N                                        This parameter can be a value of @ref KEYSCAN_Clock_Sel */
N
N    uint32_t u32KeyOut;             /*!< Specifies the KEYSCAN low cycles.
N                                        This parameter can be a value of @ref KEYSCAN_Keyout_Sel */
N
N    uint32_t u32KeyIn;              /*!< Specifies the KEYSCAN low cycles.
N                                        This parameter can be a value of @ref KEYSCAN_Keyin_Sel */
N} stc_keyscan_init_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup KEYSCAN_Global_Macros KEYSCAN Global Macros
N * @{
N */
N
N/**
N * @defgroup KEYSCAN_Hiz_Cycle_Sel KEYSCAN Hiz cycles during low output selection
N * @{
N */
N#define KEYSCAN_HIZ_CYCLE_4     (0x00UL << KEYSCAN_SCR_T_HIZ_POS)       /*!< KEYSCAN HiZ keep 4 cycles during low output */
N#define KEYSCAN_HIZ_CYCLE_8     (0x01UL << KEYSCAN_SCR_T_HIZ_POS)       /*!< KEYSCAN HiZ keep 8 cycles during low output */
N#define KEYSCAN_HIZ_CYCLE_16    (0x02UL << KEYSCAN_SCR_T_HIZ_POS)       /*!< KEYSCAN HiZ keep 16 cycles during low output */
N#define KEYSCAN_HIZ_CYCLE_32    (0x03UL << KEYSCAN_SCR_T_HIZ_POS)       /*!< KEYSCAN HiZ keep 32 cycles during low output */
N#define KEYSCAN_HIZ_CYCLE_64    (0x04UL << KEYSCAN_SCR_T_HIZ_POS)       /*!< KEYSCAN HiZ keep 64 cycles during low output */
N#define KEYSCAN_HIZ_CYCLE_256   (0x05UL << KEYSCAN_SCR_T_HIZ_POS)       /*!< KEYSCAN HiZ keep 256 cycles during low output */
N#define KEYSCAN_HIZ_CYCLE_512   (0x06UL << KEYSCAN_SCR_T_HIZ_POS)       /*!< KEYSCAN HiZ keep 512 cycles during low output */
N#define KEYSCAN_HIZ_CYCLE_1024  (0x07UL << KEYSCAN_SCR_T_HIZ_POS)       /*!< KEYSCAN HiZ keep 1024 cycles during low output */
N/**
N * @}
N */
N
N/**
N * @defgroup KEYSCAN_Low_Cycle_Sel KEYSCAN low level output cycles selection
N * @{
N */
N#define KEYSCAN_LOW_CYCLE_4     (0x02UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^2=4 cycles */
N#define KEYSCAN_LOW_CYCLE_8     (0x03UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^3=8 cycles */
N#define KEYSCAN_LOW_CYCLE_16    (0x04UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^4=16 cycles */
N#define KEYSCAN_LOW_CYCLE_32    (0x05UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^5=32 cycles */
N#define KEYSCAN_LOW_CYCLE_64    (0x06UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^6=64 cycles */
N#define KEYSCAN_LOW_CYCLE_128   (0x07UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^7=128 cycles */
N#define KEYSCAN_LOW_CYCLE_256   (0x08UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^8=256 cycles */
N#define KEYSCAN_LOW_CYCLE_512   (0x09UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^9=512 cycles */
N#define KEYSCAN_LOW_CYCLE_1K    (0x0AUL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^10=1K cycles */
N#define KEYSCAN_LOW_CYCLE_2K    (0x0BUL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^11=2K cycles */
N#define KEYSCAN_LOW_CYCLE_4K    (0x0CUL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^12=4K cycles */
N#define KEYSCAN_LOW_CYCLE_8K    (0x0DUL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^13=8K cycles */
N#define KEYSCAN_LOW_CYCLE_16K   (0x0EUL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^14=16K cycles */
N#define KEYSCAN_LOW_CYCLE_32K   (0x0FUL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^15=32K cycles */
N#define KEYSCAN_LOW_CYCLE_64K   (0x10UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^16=64K cycles */
N#define KEYSCAN_LOW_CYCLE_128K  (0x11UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^17=128K cycles */
N#define KEYSCAN_LOW_CYCLE_256K  (0x12UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^18=256K cycles */
N#define KEYSCAN_LOW_CYCLE_512K  (0x13UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^19=512K cycles */
N#define KEYSCAN_LOW_CYCLE_1M    (0x14UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^20=1M cycles */
N#define KEYSCAN_LOW_CYCLE_2M    (0x15UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^21=2M cycles */
N#define KEYSCAN_LOW_CYCLE_4M    (0x16UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^22=4M cycles */
N#define KEYSCAN_LOW_CYCLE_8M    (0x17UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^23=8M cycles */
N#define KEYSCAN_LOW_CYCLE_16M   (0x18UL << KEYSCAN_SCR_T_LLEVEL_POS)    /*!< KEYSCAN low level output is 2^24=16M cycles */
N/**
N * @}
N */
N
N/**
N * @defgroup KEYSCAN_Clock_Sel KEYSCAN scan clock selection
N * @{
N */
N#define KEYSCAN_CLK_HCLK        (0x00UL)                    /*!< Use as HCLK KEYSCAN clock */
N#define KEYSCAN_CLK_LRC         (KEYSCAN_SCR_CKSEL_0)       /*!< Use as LRC KEYSCAN clock */
N#define KEYSCAN_CLK_XTAL32      (KEYSCAN_SCR_CKSEL_1)       /*!< Use as XTAL32 KEYSCAN clock */
