N */
N#define ADC_PGA_PIN_ADC1_PA0            (ADC_PGAINSR0_PGAINSEL_0)   /*!< ADC1 pin ADC1_IN0(PA0). */
N#define ADC_PGA_PIN_ADC1_PA1            (ADC_PGAINSR0_PGAINSEL_1)   /*!< ADC1 pin ADC1_IN1(PA1). */
N#define ADC_PGA_PIN_ADC1_PA2            (ADC_PGAINSR0_PGAINSEL_2)   /*!< ADC1 pin ADC1_IN2(PA2). */
N#define ADC_PGA_PIN_ADC1_PA3            (ADC_PGAINSR0_PGAINSEL_3)   /*!< ADC1 pin ADC1_IN3(PA3). */
N#define ADC_PGA_PIN_ADC1_PA4            (ADC_PGAINSR0_PGAINSEL_4)   /*!< ADC1 pin ADC12_IN4(PA4). */
N#define ADC_PGA_PIN_ADC1_PA5            (ADC_PGAINSR0_PGAINSEL_5)   /*!< ADC1 pin ADC12_IN5(PA5). */
N#define ADC_PGA_PIN_ADC1_PA6            (ADC_PGAINSR0_PGAINSEL_6)   /*!< ADC1 pin ADC12_IN6(PA6). */
N#define ADC_PGA_PIN_ADC1_PA7            (ADC_PGAINSR0_PGAINSEL_7)   /*!< ADC1 pin ADC12_IN7(PA7). */
