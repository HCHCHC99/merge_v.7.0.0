N */
Ntypedef enum {
N    EVT_PIN_RESET = 0U,         /*!< Pin reset    */
N    EVT_PIN_SET   = 1U          /*!< Pin set      */
N} en_ep_state_t;
N
Ntypedef struct {
N    uint32_t u32PinDir;         /*!< Input/Output setting, @ref EP_PinDirection_Sel for details */
N    en_ep_state_t enPinState;   /*!< Corresponding pin initial state, @ref en_ep_state_t for details */
N    uint32_t u32PinTriggerOps;  /*!< Corresponding pin state after triggered, @ref EP_TriggerOps_Sel for details */
N    uint32_t u32Edge;           /*!< Event port trigger edge, @ref EP_Trigger_Sel for details */
N    uint32_t u32Filter;         /*!< Filter clock function setting, @ref EP_FilterClock_Sel for details */
N    uint32_t u32FilterClock;    /*!< Filter clock, ref@ EP_FilterClock_Div for details */
N} stc_ep_init_t;
