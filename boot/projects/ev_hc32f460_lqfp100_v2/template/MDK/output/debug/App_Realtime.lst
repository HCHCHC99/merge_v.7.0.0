Ntypedef struct {
N    NonBlockingDelay_t delay;
N    uint32_t intervalMs;
N    uint32_t skippedCount;
N} RTT_IntervalPrinter_t;
N
N// …˘√˜¥¯º‰∏Ùµƒ¥Ú”°∫Ø ˝
N// ”√∑®: INTERVAL_DECLARE(SENSOR_D, 1000); »ª∫ÛæÕø…“‘”√ SENSOR_D("value=%d", val);
N#define INTERVAL_DECLARE(name, interval_ms) \
N    static RTT_IntervalPrinter_t name##_printer = { \
N        .delay.startTick = 0, \
N        .delay.delayMs = ((interval_ms) == -1 ? 0 : (interval_ms)), \
N        .delay.isRunning = false, \
N        .intervalMs = (interval_ms), \
N        .skippedCount = 0, \
N    }; \
N    void name(const char* format, ...) { \
N        va_list _args; \
N        va_start(_args, format); \
N        if ((interval_ms) != -1) { \
N            _rtt_interval_print(&name##_printer, format, _args); \
N        } \
N        va_end(_args); \
N    }
X#define INTERVAL_DECLARE(name, interval_ms)     static RTT_IntervalPrinter_t name##_printer = {         .delay.startTick = 0,         .delay.delayMs = ((interval_ms) == -1 ? 0 : (interval_ms)),         .delay.isRunning = false,         .intervalMs = (interval_ms),         .skippedCount = 0,     };     void name(const char* format, ...) {         va_list _args;         va_start(_args, format);         if ((interval_ms) != -1) {             _rtt_interval_print(&name##_printer, format, _args);         }         va_end(_args);     }
N// ƒ⁄≤ø∫Ø ˝£¨”…∫Íµ˜”√
Nvoid _rtt_interval_print(RTT_IntervalPrinter_t* printer, const char* format, va_list args);
N
N// ªÒ»°∂™∆˙¥Œ ˝
Nuint32_t RTT_GetSkippedCount(RTT_IntervalPrinter_t* printer);
N
N// «Â≥˝∂™∆˙º∆ ˝
Nvoid RTT_ClearSkippedCount(RTT_IntervalPrinter_t* printer);
N
