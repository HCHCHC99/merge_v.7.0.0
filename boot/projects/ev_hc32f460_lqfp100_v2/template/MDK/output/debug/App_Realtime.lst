N ******************************************************************************/
N/**
N * @addtogroup AES_Global_Functions
N * @{
N */
Nint32_t AES_Encrypt(const uint8_t *pu8Plaintext, uint32_t u32PlaintextSize,
N                    const uint8_t *pu8Key, uint8_t u8KeySize,
N                    uint8_t *pu8Ciphertext);
N
Nint32_t AES_Decrypt(const uint8_t *pu8Ciphertext, uint32_t u32CiphertextSize,
N                    const uint8_t *pu8Key, uint8_t u8KeySize,
N                    uint8_t *pu8Plaintext);
N
Nint32_t AES_DeInit(void);
N/**
N * @}
N */
N
N#endif /* LL_AES_ENABLE */
N
N/**
N * @}
N */
N
N/**
N * @}
N */
N
N#ifdef __cplusplus
S}
N#endif
N
N#endif /* __HC32_LL_AES_H__ */
