N
N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup SPI_Global_Types SPI Global Types
N * @{
N */
N
N/**
N * @brief Structure definition of SPI initialization.
N * @note The parameter u32BaudRatePrescaler is invalid while slave mode
N */
Ntypedef struct {
N    uint32_t u32WireMode;           /*!< SPI wire mode, 3 wire mode or 4 wire mode.
N                                         This parameter can be a value of @ref SPI_Wire_Mode_Define */
N    uint32_t u32TransMode;          /*!< SPI transfer mode, send only or full duplex.
N                                         This parameter can be a value of @ref SPI_Trans_Mode_Define */
N    uint32_t u32MasterSlave;        /*!< SPI master/slave mode.
N                                         This parameter can be a value of @ref SPI_Master_Slave_Mode_Define */
N    uint32_t u32ModeFaultDetect;    /*!< SPI mode fault detect command.
N                                         This parameter can be a value of @ref SPI_Mode_Fault_Detect_Command_Define */
N    uint32_t u32Parity;             /*!< SPI parity check selection.
N                                         This parameter can be a value of @ref SPI_Parity_Check_Define */
N    uint32_t u32SpiMode;            /*!< SPI mode.
N                                         This parameter can be a value of @ref SPI_Mode_Define */
N    uint32_t u32BaudRatePrescaler;  /*!< SPI baud rate prescaler.
N                                         This parameter can be a value of @ref SPI_Baud_Rate_Prescaler_Define */
N    uint32_t u32DataBits;           /*!< SPI data bits, 4 bits ~ 32 bits.
N                                         This parameter can be a value of @ref SPI_Data_Size_Define */
N    uint32_t u32FirstBit;           /*!< MSB first or LSB first.
N                                         This parameter can be a value of @ref SPI_First_Bit_Define */
N    uint32_t u32SuspendMode;        /*!< SPI communication suspend function.
N                                         This parameter can be a value of @ref SPI_Com_Suspend_Func_Define */
N    uint32_t u32FrameLevel;         /*!< SPI frame level, SPI_1_FRAME ~ SPI_4_FRAME.
N                                         This parameter can be a value of @ref SPI_Frame_Level_Define */
N} stc_spi_init_t;
N
N/**
N * @brief Structure definition of SPI delay time configuration.
N */
Ntypedef struct {
N    uint32_t u32IntervalDelay;      /*!< SPI interval time delay (Next access delay time)
N                                         This parameter can be a value of @ref SPI_Interval_Delay_Time_define */
N    uint32_t u32ReleaseDelay;       /*!< SPI release time delay (SCK invalid delay time)
N                                         This parameter can be a value of @ref SPI_Release_Delay_Time_define */
N    uint32_t u32SetupDelay;         /*!< SPI Setup time delay (SCK valid delay time) define
N                                         This parameter can be a value of @ref SPI_Setup_Delay_Time_define */
N} stc_spi_delay_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup SPI_Global_Macros SPI Global Macros
N * @{
N */
N
N/**
N * @defgroup SPI_Wire_Mode_Define SPI Wire Mode Define
N * @{
N */
N#define SPI_4_WIRE                  (0UL)
N#define SPI_3_WIRE                  (SPI_CR1_SPIMDS)
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Trans_Mode_Define SPI Transfer Mode Define
N * @{
N */
N#define SPI_FULL_DUPLEX             (0UL)               /*!< Full duplex. */
N#define SPI_SEND_ONLY               (SPI_CR1_TXMDS)     /*!< Send only. */
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Master_Slave_Mode_Define SPI Master Slave Mode Define
N * @{
N */
N#define SPI_SLAVE                   (0UL)
N#define SPI_MASTER                  (SPI_CR1_MSTR)
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Loopback_Selection_Define SPI Loopback Selection Define
N * @note Loopback mode is mainly used for parity self-diagnosis in 4-wire full-duplex mode.
N * @{
N */
N#define SPI_LOOPBACK_INVD           (0UL)
N#define SPI_LOOPBACK_MOSI_INVT      (SPI_CR1_SPLPBK)    /*!< MISO data is the inverse of the data output by MOSI. */
N#define SPI_LOOPBACK_MOSI           (SPI_CR1_SPLPBK2)   /*!< MISO data is the data output by MOSI. */
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Int_Type_Define SPI Interrupt Type Define
N * @{
N */
N#define SPI_INT_ERR                 (SPI_CR1_EIE)       /*!< Including overload, underload and parity error. */
N#define SPI_INT_TX_BUF_EMPTY        (SPI_CR1_TXIE)
N#define SPI_INT_RX_BUF_FULL         (SPI_CR1_RXIE)
N#define SPI_INT_IDLE                (SPI_CR1_IDIE)
N#define SPI_INT_ALL                 (SPI_INT_ERR | SPI_INT_TX_BUF_EMPTY | SPI_INT_RX_BUF_FULL | SPI_INT_IDLE)
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Mode_Fault_Detect_Command_Define SPI Mode Fault Detect Command Define
N * @{
N */
N#define SPI_MD_FAULT_DETECT_DISABLE (0UL)               /*!< Disable mode fault detection. */
N#define SPI_MD_FAULT_DETECT_ENABLE  (SPI_CR1_MODFE)     /*!< Enable mode fault detection. */
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Parity_Check_Define SPI Parity Check Mode Define
N * @{
N */
N#define SPI_PARITY_INVD             (0UL)                           /*!< Parity check invalid. */
N#define SPI_PARITY_EVEN             (SPI_CR1_PAE)                   /*!< Parity check selection even parity. */
N#define SPI_PARITY_ODD              (SPI_CR1_PAE | SPI_CR1_PAOE)    /*!< Parity check selection odd parity. */
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_SS_Pin_Define SPI SSx Define
N * @{
N */
N#define SPI_PIN_SS0                 (SPI_CFG1_SS0PV)
N#define SPI_PIN_SS1                 (SPI_CFG1_SS1PV)
N#define SPI_PIN_SS2                 (SPI_CFG1_SS2PV)
N#define SPI_PIN_SS3                 (SPI_CFG1_SS3PV)
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_SS_Level SPI SS pin valid level
N * @{
N */
N#define SPI_SS_VALID_LVL_HIGH       (1UL)
N#define SPI_SS_VALID_LVL_LOW        (0UL)
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Read_Target_Buf_Define SPI Read Data Register Target Buffer Define
N * @{
N */
N#define SPI_RD_TARGET_RD_BUF        (0UL)               /*!< Read RX buffer. */
N#define SPI_RD_TARGET_WR_BUF        (SPI_CFG1_SPRDTD)   /*!< Read TX buffer. */
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Frame_Level_Define SPI data frame level define, The Data in the SPI_DR register will be send to TX_BUFF
N *                                   after enough data frame write to the SPI_DR
N * @{
N */
N#define SPI_1_FRAME                 (0UL)                   /*!< Data 1 frame */
N#define SPI_2_FRAME                 (SPI_CFG1_FTHLV_0)      /*!< Data 2 frame.*/
N#define SPI_3_FRAME                 (SPI_CFG1_FTHLV_1)      /*!< Data 3 frame.*/
N#define SPI_4_FRAME                 (SPI_CFG1_FTHLV)        /*!< Data 4 frame.*/
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Interval_Delay_Time_define SPI Interval Time Delay (Next Access Delay Time) define
N * @{
N */
N#define SPI_INTERVAL_TIME_1SCK      (0UL << SPI_CFG1_MIDI_POS)    /*!< 1 SCK + 2 PCLK1 */
N#define SPI_INTERVAL_TIME_2SCK      (1UL << SPI_CFG1_MIDI_POS)    /*!< 2 SCK + 2 PCLK1 */
N#define SPI_INTERVAL_TIME_3SCK      (2UL << SPI_CFG1_MIDI_POS)    /*!< 3 SCK + 2 PCLK1 */
N#define SPI_INTERVAL_TIME_4SCK      (3UL << SPI_CFG1_MIDI_POS)    /*!< 4 SCK + 2 PCLK1 */
N#define SPI_INTERVAL_TIME_5SCK      (4UL << SPI_CFG1_MIDI_POS)    /*!< 5 SCK + 2 PCLK1 */
N#define SPI_INTERVAL_TIME_6SCK      (5UL << SPI_CFG1_MIDI_POS)    /*!< 6 SCK + 2 PCLK1 */
N#define SPI_INTERVAL_TIME_7SCK      (6UL << SPI_CFG1_MIDI_POS)    /*!< 7 SCK + 2 PCLK1 */
N#define SPI_INTERVAL_TIME_8SCK      (7UL << SPI_CFG1_MIDI_POS)    /*!< 8 SCK + 2 PCLK1 */
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Release_Delay_Time_define SPI Release Time Delay (SCK Invalid Delay Time) Define
N * @{
N */
N#define SPI_RELEASE_TIME_1SCK       (0UL << SPI_CFG1_MSSDL_POS)
N#define SPI_RELEASE_TIME_2SCK       (1UL << SPI_CFG1_MSSDL_POS)
N#define SPI_RELEASE_TIME_3SCK       (2UL << SPI_CFG1_MSSDL_POS)
N#define SPI_RELEASE_TIME_4SCK       (3UL << SPI_CFG1_MSSDL_POS)
N#define SPI_RELEASE_TIME_5SCK       (4UL << SPI_CFG1_MSSDL_POS)
N#define SPI_RELEASE_TIME_6SCK       (5UL << SPI_CFG1_MSSDL_POS)
N#define SPI_RELEASE_TIME_7SCK       (6UL << SPI_CFG1_MSSDL_POS)
N#define SPI_RELEASE_TIME_8SCK       (7UL << SPI_CFG1_MSSDL_POS)
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Setup_Delay_Time_define SPI Setup Time Delay (SCK Valid Delay Time) Define
N * @{
N */
N#define SPI_SETUP_TIME_1SCK         (0UL << SPI_CFG1_MSSI_POS)
N#define SPI_SETUP_TIME_2SCK         (1UL << SPI_CFG1_MSSI_POS)
N#define SPI_SETUP_TIME_3SCK         (2UL << SPI_CFG1_MSSI_POS)
N#define SPI_SETUP_TIME_4SCK         (3UL << SPI_CFG1_MSSI_POS)
N#define SPI_SETUP_TIME_5SCK         (4UL << SPI_CFG1_MSSI_POS)
N#define SPI_SETUP_TIME_6SCK         (5UL << SPI_CFG1_MSSI_POS)
N#define SPI_SETUP_TIME_7SCK         (6UL << SPI_CFG1_MSSI_POS)
N#define SPI_SETUP_TIME_8SCK         (7UL << SPI_CFG1_MSSI_POS)
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Com_Suspend_Func_Define SPI Communication Suspend Function Define
N * @{
N */
N#define SPI_COM_SUSP_FUNC_OFF       (0UL)
N#define SPI_COM_SUSP_FUNC_ON        (SPI_CR1_CSUSPE)
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Mode_Define SPI Mode Define
N * @{
N */
N#define SPI_MD_0                    (0UL)                           /*!< SCK pin output low in idle state; \
N                                                                         MOSI/MISO pin data valid in odd edge, \
N                                                                         MOSI/MISO pin data change in even edge */
X#define SPI_MD_0                    (0UL)                            
N#define SPI_MD_1                    (SPI_CFG2_CPHA)                 /*!< SCK pin output low in idle state; \
N                                                                         MOSI/MISO pin data valid in even edge, \
N                                                                         MOSI/MISO pin data change in odd edge */
X#define SPI_MD_1                    (SPI_CFG2_CPHA)                  
N#define SPI_MD_2                    (SPI_CFG2_CPOL)                 /*!< SCK pin output high in idle state; \
N                                                                         MOSI/MISO pin data valid in odd edge, \
N                                                                         MOSI/MISO pin data change in even edge */
X#define SPI_MD_2                    (SPI_CFG2_CPOL)                  
N#define SPI_MD_3                    (SPI_CFG2_CPOL | SPI_CFG2_CPHA) /*!< SCK pin output high in idle state; \
N                                                                         MOSI/MISO pin data valid in even edge, \
N                                                                         MOSI/MISO pin data change in odd edge */
X#define SPI_MD_3                    (SPI_CFG2_CPOL | SPI_CFG2_CPHA)  
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_SCK_Polarity_Define SPI SCK Polarity Define
N * @{
N */
N#define SPI_SCK_POLARITY_LOW        (0UL)                   /*!< SCK pin output low in idle state  */
N#define SPI_SCK_POLARITY_HIGH       (SPI_CFG2_CPOL)         /*!< SCK pin output high in idle state */
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_SCK_Phase_Define SPI SCK Phase Define
N * @{
N */
N#define SPI_SCK_PHASE_ODD_EDGE_SAMPLE   (0UL)               /*!< MOSI/MISO pin data sample in odd edge, MOSI/MISO pin data change in even edge */
N#define SPI_SCK_PHASE_EVEN_EDGE_SAMPLE  (SPI_CFG2_CPHA)     /*!< MOSI/MISO pin data sample in even edge, MOSI/MISO pin data change in odd edge */
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Baud_Rate_Prescaler_Define SPI Baudrate Prescaler Define
N * @{
N */
N#define SPI_BR_CLK_DIV2             (0UL << SPI_CFG2_MBR_POS)   /*!< PCLK1 / 2. */
N#define SPI_BR_CLK_DIV4             (1UL << SPI_CFG2_MBR_POS)   /*!< PCLK1 / 4. */
N#define SPI_BR_CLK_DIV8             (2UL << SPI_CFG2_MBR_POS)   /*!< PCLK1 / 8. */
N#define SPI_BR_CLK_DIV16            (3UL << SPI_CFG2_MBR_POS)   /*!< PCLK1 / 16. */
N#define SPI_BR_CLK_DIV32            (4UL << SPI_CFG2_MBR_POS)   /*!< PCLK1 / 32. */
N#define SPI_BR_CLK_DIV64            (5UL << SPI_CFG2_MBR_POS)   /*!< PCLK1 / 64. */
N#define SPI_BR_CLK_DIV128           (6UL << SPI_CFG2_MBR_POS)   /*!< PCLK1 / 128. */
N#define SPI_BR_CLK_DIV256           (7UL << SPI_CFG2_MBR_POS)   /*!< PCLK1 / 256. */
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_Data_Size_Define SPI Data Size Define
N * @{
N */
N#define SPI_DATA_SIZE_4BIT          (0UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_5BIT          (1UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_6BIT          (2UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_7BIT          (3UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_8BIT          (4UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_9BIT          (5UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_10BIT         (6UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_11BIT         (7UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_12BIT         (8UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_13BIT         (9UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_14BIT         (10UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_15BIT         (11UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_16BIT         (12UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_20BIT         (13UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_24BIT         (14UL << SPI_CFG2_DSIZE_POS)
N#define SPI_DATA_SIZE_32BIT         (15UL << SPI_CFG2_DSIZE_POS)
N
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_First_Bit_Define SPI First Bit Define
N * @{
N */
N#define SPI_FIRST_MSB               (0UL)
N#define SPI_FIRST_LSB               (SPI_CFG2_LSBF)
N/**
N * @}
N */
N
N/**
N * @defgroup SPI_State_Flag_Define SPI State Flag Define
N * @{
N */
N#define SPI_FLAG_OVERRUN            (SPI_SR_OVRERF)
N#define SPI_FLAG_IDLE               (SPI_SR_IDLNF)
N#define SPI_FLAG_MD_FAULT           (SPI_SR_MODFERF)
N#define SPI_FLAG_PARITY_ERR         (SPI_SR_PERF)
N#define SPI_FLAG_UNDERRUN           (SPI_SR_UDRERF)
N#define SPI_FLAG_TX_BUF_EMPTY       (SPI_SR_TDEF)       /*!< This flag is set when the data in the data register     \
N                                                             is copied into the shift register, but the transmission \
N                                                             of the data bit may not have been completed. */
X#define SPI_FLAG_TX_BUF_EMPTY       (SPI_SR_TDEF)        
N#define SPI_FLAG_RX_BUF_FULL        (SPI_SR_RDFF)       /*!< Indicates that a data was received. */
N#define SPI_FLAG_CLR_ALL            (SPI_FLAG_OVERRUN  | SPI_FLAG_MD_FAULT | SPI_FLAG_PARITY_ERR | SPI_FLAG_UNDERRUN)
N#define SPI_FLAG_ALL                (SPI_FLAG_OVERRUN  | SPI_FLAG_IDLE | SPI_FLAG_MD_FAULT | SPI_FLAG_PARITY_ERR | \
N                                     SPI_FLAG_UNDERRUN | SPI_FLAG_TX_BUF_EMPTY | SPI_FLAG_RX_BUF_FULL)
X#define SPI_FLAG_ALL                (SPI_FLAG_OVERRUN  | SPI_FLAG_IDLE | SPI_FLAG_MD_FAULT | SPI_FLAG_PARITY_ERR |                                      SPI_FLAG_UNDERRUN | SPI_FLAG_TX_BUF_EMPTY | SPI_FLAG_RX_BUF_FULL)
N/**
