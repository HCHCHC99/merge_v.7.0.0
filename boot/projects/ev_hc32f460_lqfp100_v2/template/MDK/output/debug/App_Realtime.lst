N/*=============================================================================
N * @brief  Ëé∑ÂèñÂÆûÊó∂ËΩ¨ÈÄü (r/min)
N *============================================================================*/
Nint16_t Realtime_GetSpeed(void)
N{
N    float fSpeedDegS = 0.0f;
N    DeviceCommandData_t stcCmd;
N    memset(&stcCmd, 0, sizeof(DeviceCommandData_t));
N    stcCmd.cmd = CMD_RTURN_GET_SPEED;
X    stcCmd.cmd = (0xA000 + 0x03);
N    stcCmd.params = NULL;
X    stcCmd.params = 0;
N    stcCmd.param_size = 0;
N    stcCmd.response = &fSpeedDegS;
N    stcCmd.response_size = sizeof(float);
N
N    DeviceResult_t res = Device_Control(ID_RTURN, &stcCmd);
X    DeviceResult_t res = Device_Control(15, &stcCmd);
N    if (res == RESULT_OK)
N    {
N        /* deg/s -> r/min: r/min = deg/s / 360 * 60 = deg/s / 6 */
N        return (int16_t)(fSpeedDegS / 6.0f);
N    }
N    
N    REALTIME_DBG("GetSpeed failed, res=%d", (int)res);
X    ((void)0);
N    return 0;
N}
N
N/*=============================================================================
N * @brief  Ëé∑ÂèñÂÆûÊó∂ËßíÂ∫¶ (0.1Â∫¶)
N *============================================================================*/
Nint16_t Realtime_GetAngle(void)
N{
N    float fAngleDeg = 0.0f;
N    DeviceCommandData_t stcCmd;
N    memset(&stcCmd, 0, sizeof(DeviceCommandData_t));
N    stcCmd.cmd = CMD_RTURN_GET_ANGLE_DEG;
X    stcCmd.cmd = (0xA000 + 0x02);
N    stcCmd.params = NULL;
X    stcCmd.params = 0;
N    stcCmd.param_size = 0;
N    stcCmd.response = &fAngleDeg;
N    stcCmd.response_size = sizeof(float);
N
N    DeviceResult_t res = Device_Control(ID_RTURN, &stcCmd);
X    DeviceResult_t res = Device_Control(15, &stcCmd);
N    if (res == RESULT_OK)
N    {
N        /* deg -> 0.1deg */
N        return (int16_t)(fAngleDeg * 10.0f);
N    }
N    
N    REALTIME_DBG("GetAngle failed, res=%d", (int)res);
X    ((void)0);
N    return 0;
N}
N
