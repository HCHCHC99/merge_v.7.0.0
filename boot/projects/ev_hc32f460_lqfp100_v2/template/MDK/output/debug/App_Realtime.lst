Nint32_t QSPI_DeInit(void);
Nint32_t QSPI_Init(const stc_qspi_init_t *pstcQspiInit);
Nint32_t QSPI_StructInit(stc_qspi_init_t *pstcQspiInit);
Nvoid QSPI_SetWpPinLevel(uint32_t u32Level);
Nvoid QSPI_SetPrefetchMode(uint32_t u32Mode);
Nvoid QSPI_SelectMemoryBlock(uint8_t u8Block);
Nvoid QSPI_SetReadMode(uint32_t u32Mode);
Nint32_t QSPI_CustomReadConfig(const stc_qspi_custom_mode_t *pstcCustomMode);
Nvoid QSPI_XipModeCmd(uint8_t u8ModeCode, en_functional_state_t enNewState);
N
N/* Transfer and receive data functions */
Nvoid QSPI_EnterDirectCommMode(void);
Nvoid QSPI_ExitDirectCommMode(void);
Nvoid QSPI_WriteDirectCommValue(uint8_t u8Value);
Nuint8_t QSPI_ReadDirectCommValue(void);
N
N/* Interrupt and flag management functions */
Nuint8_t QSPI_GetPrefetchBufSize(void);
Nen_flag_status_t QSPI_GetStatus(uint32_t u32Flag);
Nvoid QSPI_ClearStatus(uint32_t u32Flag);
