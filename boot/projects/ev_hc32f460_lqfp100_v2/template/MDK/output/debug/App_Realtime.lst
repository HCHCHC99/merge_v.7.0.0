N/**
N * @defgroup SDIOC_Response_Type SDIOC Response Type
N * @{
N */
N#define SDIOC_RESP_TYPE_NO                      (0x00U)                                               /*!< No Response                        */
N#define SDIOC_RESP_TYPE_R2                      (SDIOC_CMD_RESTYP_0)                                  /*!< Command Response 2                 */
N#define SDIOC_RESP_TYPE_R3_R4                   (SDIOC_CMD_RESTYP_1)                                  /*!< Command Response 3, 4              */
N#define SDIOC_RESP_TYPE_R1_R5_R6_R7             (SDIOC_CMD_RESTYP_1 | SDIOC_CMD_ICE | SDIOC_CMD_CCE)  /*!< Command Response 1, 5, 6, 7        */
N#define SDIOC_RESP_TYPE_R1B_R5B                 (SDIOC_CMD_RESTYP   | SDIOC_CMD_ICE | SDIOC_CMD_CCE)  /*!< Command Response 1 and 5 with busy */
N/**
N * @}
N */
N
N/**
N * @defgroup SDIOC_Command SDIOC Command
N * @{
N */
N/**
N * @defgroup SDIOC_SDMMC_CMD SDIOC SDMMC CMD
N * @{
N */
N#define SDIOC_CMD0_GO_IDLE_STATE                (0U)    /*!< Resets the SD memory card. */
N#define SDIOC_CMD1_SEND_OP_COND                 (1U)    /*!< Sends host capacity support information and activates the card's initialization process. */
N#define SDIOC_CMD2_ALL_SEND_CID                 (2U)    /*!< Asks any card connected to the host to send the CID numbers on the CMD line.             */
N#define SDIOC_CMD3_SEND_RELATIVE_ADDR           (3U)    /*!< Asks the card to publish a new relative address (RCA).                                   */
N#define SDIOC_CMD4_SET_DSR                      (4U)    /*!< Programs the DSR of all cards.                                                           */
N#define SDIOC_CMD5_IO_SEND_OP_COND              (5U)    /*!< Sends host capacity support information (HCS) and asks the accessed card to send its \
N                                                            operating condition register (OCR) content in the response on the CMD line.              */
X#define SDIOC_CMD5_IO_SEND_OP_COND              (5U)     
N#define SDIOC_CMD6_SWITCH_FUNC                  (6U)    /*!< Checks switchable function (mode 0) and switch card function (mode 1).                   */
N#define SDIOC_CMD7_SELECT_DESELECT_CARD         (7U)    /*!< Selects the card by its own relative address and gets deselected by any other address    */
N#define SDIOC_CMD8_SEND_IF_COND                 (8U)    /*!< Sends SD Memory Card interface condition, which includes host supply voltage information \
N                                                            and asks the card whether card supports voltage.                                         */
X#define SDIOC_CMD8_SEND_IF_COND                 (8U)     
N#define SDIOC_CMD9_SEND_CSD                     (9U)    /*!< Addressed card sends its card specific data (CSD) on the CMD line.                       */
N#define SDIOC_CMD10_SEND_CID                    (10U)   /*!< Addressed card sends its card identification (CID) on the CMD line.                      */
N#define SDIOC_CMD11_READ_DAT_UNTIL_STOP         (11U)   /*!< SD card doesn't support it.                                                              */
N#define SDIOC_CMD12_STOP_TRANSMISSION           (12U)   /*!< Forces the card to stop transmission.                                                    */
N#define SDIOC_CMD13_SEND_STATUS                 (13U)   /*!< Addressed card sends its status register.                                                */
N#define SDIOC_CMD14_HS_BUSTEST_READ             (14U)   /*!< Reserved                                                                                 */
N#define SDIOC_CMD15_GO_INACTIVE_STATE           (15U)   /*!< Sends an addressed card into the inactive state.                                         */
N#define SDIOC_CMD16_SET_BLOCKLEN                (16U)   /*!< Sets the block length (in bytes for SDSC) for all following block commands(read, write).  \
N                                                            Default block length is fixed to 512 Bytes. Not effective for SDHS and SDXC.             */
X#define SDIOC_CMD16_SET_BLOCKLEN                (16U)    
N#define SDIOC_CMD17_READ_SINGLE_BLOCK           (17U)   /*!< Reads single block of size selected by SET_BLOCKLEN in case of SDSC, and a block of fixed \
N                                                            512 bytes in case of SDHC and SDXC.                                                      */
X#define SDIOC_CMD17_READ_SINGLE_BLOCK           (17U)    
N#define SDIOC_CMD18_READ_MULTI_BLOCK            (18U)   /*!< Continuously transfers data blocks from card to host until interrupted by                 \
N                                                            STOP_TRANSMISSION command.                                                               */
X#define SDIOC_CMD18_READ_MULTI_BLOCK            (18U)    
N#define SDIOC_CMD19_HS_BUSTEST_WRITE            (19U)   /*!< 64 bytes tuning pattern is sent for SDR50 and SDR104.                                    */
N#define SDIOC_CMD20_WRITE_DAT_UNTIL_STOP        (20U)   /*!< Speed class control command.                                                             */
N#define SDIOC_CMD23_SET_BLOCK_COUNT             (23U)   /*!< Specify block count for CMD18 and CMD25.                                                 */
N#define SDIOC_CMD24_WRITE_SINGLE_BLOCK          (24U)   /*!< Writes single block of size selected by SET_BLOCKLEN in case of SDSC, and a block of fixed\
N                                                            512 bytes in case of SDHC and SDXC.                                                      */
X#define SDIOC_CMD24_WRITE_SINGLE_BLOCK          (24U)    
N#define SDIOC_CMD25_WRITE_MULTI_BLOCK           (25U)   /*!< Continuously writes blocks of data until a STOP_TRANSMISSION follows.                    */
N#define SDIOC_CMD26_PROGRAM_CID                 (26U)   /*!< Reserved for manufacturers.                                                              */
N#define SDIOC_CMD27_PROGRAM_CSD                 (27U)   /*!< Programming of the programmable bits of the CSD.                                         */
N#define SDIOC_CMD28_SET_WRITE_PROT              (28U)   /*!< Sets the write protection bit of the addressed group.                                    */
N#define SDIOC_CMD29_CLR_WRITE_PROT              (29U)   /*!< Clears the write protection bit of the addressed group.                                  */
N#define SDIOC_CMD30_SEND_WRITE_PROT             (30U)   /*!< Asks the card to send the status of the write protection bits.                           */
N#define SDIOC_CMD32_ERASE_WR_BLK_START          (32U)   /*!< Sets the address of the first write block to be erased. (For SD card only).              */
N#define SDIOC_CMD33_ERASE_WR_BLK_END            (33U)   /*!< Sets the address of the last write block of the continuous range to be erased.           */
N#define SDIOC_CMD35_ERASE_GROUP_START           (35U)   /*!< Sets the address of the first write block to be erased. Reserved for each command system  \
N                                                            set by switch function command (CMD6).                                                   */
X#define SDIOC_CMD35_ERASE_GROUP_START           (35U)    
N#define SDIOC_CMD36_ERASE_GROUP_END             (36U)   /*!< Sets the address of the last write block of the continuous range to be erased.            \
N                                                            Reserved for each command system set by switch function command (CMD6).                  */
X#define SDIOC_CMD36_ERASE_GROUP_END             (36U)    
N#define SDIOC_CMD38_ERASE                       (38U)   /*!< Reserved for SD security applications.                                                   */
N#define SDIOC_CMD39_FAST_IO                     (39U)   /*!< SD card doesn't support it (Reserved).                                                   */
N#define SDIOC_CMD40_GO_IRQ_STATE                (40U)   /*!< SD card doesn't support it (Reserved).                                                   */
N#define SDIOC_CMD42_LOCK_UNLOCK                 (42U)   /*!< Sets/resets the password or lock/unlock the card. The size of the data block is set by    \
N                                                            the SET_BLOCK_LEN command.                                                               */
X#define SDIOC_CMD42_LOCK_UNLOCK                 (42U)    
N#define SDIOC_CMD52_IO_RW_DIRECT                (52U)   /*!< For SD I/O card only, access a single I/O register.                                    */
N#define SDIOC_CMD53_IO_RW_EXTENDED              (53U)   /*!< For SD I/O card only, access multiple I/O registers with a single command.              */
N#define SDIOC_CMD55_APP_CMD                     (55U)   /*!< Indicates to the card that the next command is an application specific command rather     \
N                                                            than a standard command.                                                                 */
X#define SDIOC_CMD55_APP_CMD                     (55U)    
N#define SDIOC_CMD56_GEN_CMD                     (56U)   /*!< Used either to transfer a data block to the card or to get a data block from the card     \
N                                                            for general purpose/application specific commands.                                       */
X#define SDIOC_CMD56_GEN_CMD                     (56U)    
N#define SDIOC_CMD64_NO_CMD                      (64U)   /*!< No command                                                                               */
N/**
N * @}
N */
N
N/**
N * @defgroup SDIOC_SDMMC_ACMD SDIOC SDMMC ACMD
N * @{
N */
N/* Following commands are SD Card Specific commands. SDIOC_CMD55_APP_CMD should be sent before sending these commands. */
N#define SDIOC_ACMD6_SET_BUS_WIDTH               (6U)    /*!< (ACMD6) Defines the data bus width to be used for data transfer. The allowed data bus     \
N                                                            widths are given in SCR register.                                                        */
X#define SDIOC_ACMD6_SET_BUS_WIDTH               (6U)     
N#define SDIOC_ACMD13_SD_STATUS                  (13U)   /*!< (ACMD13) Sends the SD status.                                                            */
N#define SDIOC_ACMD22_SEND_NUM_WR_BLOCKS         (22U)   /*!< (ACMD22) Sends the number of the written (without errors) write blocks. Responds with     \
N                                                            32bit+CRC data block.                                                                    */
X#define SDIOC_ACMD22_SEND_NUM_WR_BLOCKS         (22U)    
N#define SDIOC_ACMD23_SET_WR_BLK_ERASE_COUNT     (23U)   /*!< Set the number of write blocks to be pre-erased before writing (to be used for faster     \
N                                                            Multiple Block WR command). */
X#define SDIOC_ACMD23_SET_WR_BLK_ERASE_COUNT     (23U)    
N#define SDIOC_ACMD41_SD_APP_OP_COND             (41U)   /*!< (ACMD41) Sends host capacity support information (HCS) and asks the accessed card to      \
N                                                            send its operating condition register (OCR) content in the response on the CMD line.     */
X#define SDIOC_ACMD41_SD_APP_OP_COND             (41U)    
N#define SDIOC_ACMD42_SET_CLR_CARD_DETECT        (42U)   /*!< (ACMD42) Connect/Disconnect the 50 KOhm pull-up resistor on CD/DAT3 (pin 1) of the card  */
N#define SDIOC_ACMD51_SEND_SCR                   (51U)   /*!< Reads the SD Configuration Register (SCR).                                               */
N
N#define SDIOC_ACMD43_GET_MKB                    (43U)
N#define SDIOC_ACMD44_GET_MID                    (44U)
N#define SDIOC_ACMD45_SET_CER_RN1                (45U)
N#define SDIOC_ACMD46_GET_CER_RN2                (46U)
N#define SDIOC_ACMD47_SET_CER_RES2               (47U)
N#define SDIOC_ACMD48_GET_CER_RES1               (48U)
N#define SDIOC_ACMD18_SECURE_READ_MULTI_BLOCK    (18U)
N#define SDIOC_ACMD25_SECURE_WRITE_MULTI_BLOCK   (25U)
N#define SDIOC_ACMD38_SECURE_ERASE               (38U)
N#define SDIOC_ACMD49_CHANGE_SECURE_AREA         (49U)
N#define SDIOC_ACMD48_SECURE_WRITE_MKB           (48U)
N/**
N * @}
N */
N/**
N * @}
N */
N
N/**
N * @defgroup SDMMC_Error_Code SDMMC Error Code
N * @{
N */
N#define SDMMC_ERR_NONE                          (0x00000000UL)  /*!< No error                                                      */
N#define SDMMC_ERR_ADDR_OUT_OF_RANGE             (0x80000000UL)  /*!< Error when addressed block is out of range                    */
N#define SDMMC_ERR_ADDR_MISALIGNED               (0x40000000UL)  /*!< Misaligned address                                            */
N#define SDMMC_ERR_BLOCK_LEN_ERR                 (0x20000000UL)  /*!< Transferred block length is not allowed for the card or the    \
N                                                                     number of transferred bytes does not match the block length   */
X#define SDMMC_ERR_BLOCK_LEN_ERR                 (0x20000000UL)   
N#define SDMMC_ERR_ERASE_SEQ_ERR                 (0x10000000UL)  /*!< An error in the sequence of erase command occurs              */
N#define SDMMC_ERR_BAD_ERASE_PARAM               (0x08000000UL)  /*!< An invalid selection for erase groups                         */
N#define SDMMC_ERR_WR_PROT_VIOLATION             (0x04000000UL)  /*!< Attempt to program a write protect block                      */
N#define SDMMC_ERR_LOCK_UNLOCK_FAILED            (0x01000000UL)  /*!< Sequence or password error has been detected in unlock command \
N                                                                     or if there was an attempt to access a locked card            */
X#define SDMMC_ERR_LOCK_UNLOCK_FAILED            (0x01000000UL)   
N#define SDMMC_ERR_COM_CRC_FAILED                (0x00800000UL)  /*!< CRC check of the previous command failed                      */
N#define SDMMC_ERR_ILLEGAL_CMD                   (0x00400000UL)  /*!< Command is not legal for the card state                       */
N#define SDMMC_ERR_CARD_ECC_FAILED               (0x00200000UL)  /*!< Card internal ECC was applied but failed to correct the data  */
N#define SDMMC_ERR_CC_ERR                        (0x00100000UL)  /*!< Internal card controller error                                */
N#define SDMMC_ERR_GENERAL_UNKNOWN_ERR           (0x00080000UL)  /*!< General or unknown error                                      */
N#define SDMMC_ERR_STREAM_RD_UNDERRUN            (0x00040000UL)  /*!< The card could not sustain data reading in stream mode       */
N#define SDMMC_ERR_STREAM_WR_OVERRUN             (0x00020000UL)  /*!< The card could not sustain data programming in stream mode    */
N#define SDMMC_ERR_CID_CSD_OVERWRITE             (0x00010000UL)  /*!< CID/CSD overwrite error                                       */
N#define SDMMC_ERR_WP_ERASE_SKIP                 (0x00008000UL)  /*!< Only partial address space was erased                         */
N#define SDMMC_ERR_CARD_ECC_DISABLED             (0x00004000UL)  /*!< Command has been executed without using internal ECC          */
N#define SDMMC_ERR_ERASE_RST                     (0x00002000UL)  /*!< Erase sequence was cleared before executing because an out of  \
N                                                                     erase sequence command was received                           */
X#define SDMMC_ERR_ERASE_RST                     (0x00002000UL)   
N#define SDMMC_ERR_CMD_AUTO_SEND                 (0x00001000UL)  /*!< An error occurred in sending the command automatically        */
N#define SDMMC_ERR_CMD_INDEX                     (0x00000800UL)  /*!< The received response contains a command number error         */
N#define SDMMC_ERR_CMD_STOP_BIT                  (0x00000400UL)  /*!< Command line detects low level at stop bit                    */
N#define SDMMC_ERR_CMD_CRC_FAIL                  (0x00000200UL)  /*!< Command response received (but CRC check failed)              */
N#define SDMMC_ERR_CMD_TIMEOUT                   (0x00000100UL)  /*!< Command response timeout                                      */
N#define SDMMC_ERR_SWITCH_ERR                    (0x00000080UL)  /*!< The card did not switch to the expected mode as requested by   \
N                                                                     the SWITCH command                                            */
X#define SDMMC_ERR_SWITCH_ERR                    (0x00000080UL)   
N#define SDMMC_ERR_DATA_STOP_BIT                 (0x00000040UL)  /*!< Data line detects low level at stop bit                       */
N#define SDMMC_ERR_DATA_CRC_FAIL                 (0x00000020UL)  /*!< Data block sent/received (CRC check failed)                   */
N#define SDMMC_ERR_DATA_TIMEOUT                  (0x00000010UL)  /*!< Data timeout                                                  */
N#define SDMMC_ERR_AKE_SEQ_ERR                   (0x00000008UL)  /*!< Error in sequence of authentication                           */
N#define SDMMC_ERR_INVD_VOLT                     (0x00000004UL)  /*!< Error in case of invalid voltage range                        */
N#define SDMMC_ERR_REQ_NOT_APPLICABLE            (0x00000002UL)  /*!< Error when command request is not applicable                  */
N#define SDMMC_ERR_UNSUPPORT_FEATURE             (0x00000001UL)  /*!< Error when feature is unsupported                         */
N
N#define SDMMC_ERR_BITS_MASK                     (0xFDFFE048UL)  /*!< SD/MMC Error status bits mask                                 */
N/**
N * @}
N */
N
N/**
N * @defgroup SDMMC_Card_Status_Bit SDMMC Card Status Bit
N * @{
N */
N#define SDMMC_STATUS_CARD_IS_LOCKED_POS         (24U)
N#define SDMMC_STATUS_CARD_IS_LOCKED             (0x02000000UL)  /*!< When set, signals that the card is locked by the host */
N#define SDMMC_STATUS_CURR_STATE_POS             (9U)
N#define SDMMC_STATUS_CURR_STATE                 (0x00001E00UL)  /*!< The state of the card when receiving the command */
N#define SDMMC_STATUS_RDY_FOR_DATA_POS           (8U)
N#define SDMMC_STATUS_RDY_FOR_DATA               (0x00000100UL)  /*!< Corresponds to buffer empty signaling on the bus */
N#define SDMMC_STATUS_APP_CMD_POS                (5U)
N#define SDMMC_STATUS_APP_CMD                    (0x00000020UL)  /*!< The card will expect ACMD, or an indication that the command has been interpreted as ACMD */
N/**
N * @}
N */
N
