N/**
N * @brief  MPU write protect unlock.
N * @param  None
N * @retval None
N */
N__STATIC_INLINE void MPU_REG_Unlock(void)
Xstatic __inline void MPU_REG_Unlock(void)
N{
N    WRITE_REG32(CM_MPU->WP, MPU_REG_UNLOCK_KEY);
X    ((((CM_MPU_TypeDef *)(0x40050000UL))->WP) = ((uint32_t)((0x96A5UL))));
