N#define I2C_DIG_FILTER_CLK_DIV2       (1UL << I2C_FLTR_DNF_POS) /*!< I2C Clock/2 */
N#define I2C_DIG_FILTER_CLK_DIV3       (2UL << I2C_FLTR_DNF_POS) /*!< I2C Clock/3 */
N#define I2C_DIG_FILTER_CLK_DIV4       (3UL << I2C_FLTR_DNF_POS) /*!< I2C Clock/4 */
N/**
N * @}
N */
N
N/**
N * @defgroup I2C_Flag I2C Flag
N * @{
N */
N#define I2C_FLAG_START                (I2C_SR_STARTF)      /*!< Start condition detected */
N#define I2C_FLAG_MATCH_ADDR0          (I2C_SR_SLADDR0F)    /*!< Address 0 detected */
N#define I2C_FLAG_MATCH_ADDR1          (I2C_SR_SLADDR1F)    /*!< Address 1 detected */
N#define I2C_FLAG_TX_CPLT              (I2C_SR_TENDF)       /*!< Transfer end */
N#define I2C_FLAG_STOP                 (I2C_SR_STOPF)       /*!< Stop condition detected */
N#define I2C_FLAG_RX_FULL              (I2C_SR_RFULLF)      /*!< Receive buffer full */
N#define I2C_FLAG_TX_EMPTY             (I2C_SR_TEMPTYF)     /*!< Transfer buffer empty */
N#define I2C_FLAG_ARBITRATE_FAIL       (I2C_SR_ARLOF)       /*!< Arbitration fails */
N#define I2C_FLAG_ACKR                 (I2C_SR_ACKRF)       /*!< ACK status */
N#define I2C_FLAG_NACKF                (I2C_SR_NACKF)       /*!< NACK detected */
N#define I2C_FLAG_TMOUTF               (I2C_SR_TMOUTF)      /*!<  Time out detected */
N#define I2C_FLAG_MASTER               (I2C_SR_MSL)         /*!< Master mode flag */
N#define I2C_FLAG_BUSY                 (I2C_SR_BUSY)        /*!< Bus busy status */
N#define I2C_FLAG_TRA                  (I2C_SR_TRA)         /*!< Transfer mode flag */
N#define I2C_FLAG_GENERAL_CALL         (I2C_SR_GENCALLF)    /*!< General call detected */
N#define I2C_FLAG_SMBUS_DEFAULT_MATCH  (I2C_SR_SMBDEFAULTF) /*!< SMBUS device default address detected */
N#define I2C_FLAG_SMBUS_HOST_MATCH     (I2C_SR_SMBHOSTF)    /*!< SMBUS host address detected */
N#define I2C_FLAG_SMBUS_ALERT_MATCH    (I2C_SR_SMBALRTF)    /*!< SMBUS alert response address detected */
N
N#define I2C_FLAG_ALL                  (I2C_FLAG_START          | I2C_FLAG_NACKF               | \
N                                       I2C_FLAG_MATCH_ADDR0    | I2C_FLAG_TMOUTF              | \
