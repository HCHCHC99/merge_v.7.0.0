N * @{
N */
N#define GPIO_PIN_00                 (0x0001U)  /*!< Pin 00 selected   */
N#define GPIO_PIN_01                 (0x0002U)  /*!< Pin 01 selected   */
N#define GPIO_PIN_02                 (0x0004U)  /*!< Pin 02 selected   */
N#define GPIO_PIN_03                 (0x0008U)  /*!< Pin 03 selected   */
N#define GPIO_PIN_04                 (0x0010U)  /*!< Pin 04 selected   */
N#define GPIO_PIN_05                 (0x0020U)  /*!< Pin 05 selected   */
N#define GPIO_PIN_06                 (0x0040U)  /*!< Pin 06 selected   */
N#define GPIO_PIN_07                 (0x0080U)  /*!< Pin 07 selected   */
N#define GPIO_PIN_08                 (0x0100U)  /*!< Pin 08 selected   */
N#define GPIO_PIN_09                 (0x0200U)  /*!< Pin 09 selected   */
N#define GPIO_PIN_10                 (0x0400U)  /*!< Pin 10 selected   */
N#define GPIO_PIN_11                 (0x0800U)  /*!< Pin 11 selected   */
N#define GPIO_PIN_12                 (0x1000U)  /*!< Pin 12 selected   */
