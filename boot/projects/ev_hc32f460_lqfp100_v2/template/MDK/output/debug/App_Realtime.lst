N * @}
N */
N
N/**
N * @defgroup ADC_PGA_Gain ADC PGA Gain Factor
N * @{
N */
N#define ADC_PGA_GAIN_2                  (0x0U)  /*!< PGA gain factor is 2. */
N#define ADC_PGA_GAIN_2P133              (0x1U)  /*!< PGA gain factor is 2.133. */
N#define ADC_PGA_GAIN_2P286              (0x2U)  /*!< PGA gain factor is 2.286. */
N#define ADC_PGA_GAIN_2P667              (0x3U)  /*!< PGA gain factor is 2.667. */
N#define ADC_PGA_GAIN_2P909              (0x4U)  /*!< PGA gain factor is 2.909. */
N#define ADC_PGA_GAIN_3P2                (0x5U)  /*!< PGA gain factor is 3.2. */
N#define ADC_PGA_GAIN_3P556              (0x6U)  /*!< PGA gain factor is 2.556. */
N#define ADC_PGA_GAIN_4                  (0x7U)  /*!< PGA gain factor is 4. */
N#define ADC_PGA_GAIN_4P571              (0x8U)  /*!< PGA gain factor is 4.571. */
N#define ADC_PGA_GAIN_5P333              (0x9U)  /*!< PGA gain factor is 5.333. */
N#define ADC_PGA_GAIN_6P4                (0xAU)  /*!< PGA gain factor is 6.4. */
N#define ADC_PGA_GAIN_8                  (0xBU)  /*!< PGA gain factor is 8. */
N#define ADC_PGA_GAIN_10P667             (0xCU)  /*!< PGA gain factor is 10.667. */
N#define ADC_PGA_GAIN_16                 (0xDU)  /*!< PGA gain factor is 16. */
N#define ADC_PGA_GAIN_32                 (0xEU)  /*!< PGA gain factor is 32. */
N/**
N * @}
N */
N
N/**
