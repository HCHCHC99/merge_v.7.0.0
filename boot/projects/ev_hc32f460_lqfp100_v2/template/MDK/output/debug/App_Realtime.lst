N/**
N *******************************************************************************
N * @file  hc32_ll_dcu.h
N * @brief This file contains all the functions prototypes of the DCU(Data
N *        Computing Unit) driver library.
N @verbatim
N   Change Logs:
N   Date             Author          Notes
N   2022-03-31       CDT             First version
N   2022-06-30       CDT             Modify macro group comments: DCU_Interrupt_Type
N   2023-06-30       CDT             Modify macro-definition according to RM:DCU_CTL_COMP_TRG->DCU_CTL_COMPTRG
N @endverbatim
N *******************************************************************************
N * Copyright (C) 2022-2025, Xiaohua Semiconductor Co., Ltd. All rights reserved.
N *
N * This software component is licensed by XHSC under BSD 3-Clause license
N * (the "License"); You may not use this file except in compliance with the
N * License. You may obtain a copy of the License at:
N *                    opensource.org/licenses/BSD-3-Clause
N *
N *******************************************************************************
N */
N#ifndef __HC32_LL_DCU_H__
N#define __HC32_LL_DCU_H__
N
N/* C binding of definitions if building with C++ compiler */
N#ifdef __cplusplus
Sextern "C"
S{
N#endif
N
N/*******************************************************************************
N * Include files
N ******************************************************************************/
N#include "hc32_ll_def.h"
N
N#include "hc32f4xx.h"
N#include "hc32f4xx_conf.h"
N
N/**
N * @addtogroup LL_Driver
N * @{
N */
N
N/**
N * @addtogroup LL_DCU
N * @{
N */
N
N#if (LL_DCU_ENABLE == DDL_ON)
X#if (((1U)) == (1U))
N
N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup DCU_Global_Types DCU Global Types
N * @{
N */
N
N/**
N * @brief DCU initialization structure definition
N */
Ntypedef struct {
N    uint32_t u32Mode;         /*!< Specifies DCU operation.
N                                   This parameter can be a value of @ref DCU_Mode */
N    uint32_t u32DataWidth;    /*!< Specifies DCU data width.
N                                   This parameter can be a value of @ref DCU_Data_Width */
N} stc_dcu_init_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup DCU_Global_Macros DCU Global Macros
N * @{
N */
N
N/**
N * @defgroup DCU_Data_Width DCU Data Width
N * @{
N */
N#define DCU_DATA_WIDTH_8BIT                 (0UL)                   /*!< DCU data width: 8 bit */
N#define DCU_DATA_WIDTH_16BIT                (DCU_CTL_DATASIZE_0)    /*!< DCU data width: 16 bit */
N#define DCU_DATA_WIDTH_32BIT                (DCU_CTL_DATASIZE_1)    /*!< DCU data width: 32 bit */
N/**
N * @}
N */
N
N/**
N * @defgroup DCU_Compare_Trigger_Condition DCU Compare Trigger Condition
N * @{
N */
N#define DCU_CMP_TRIG_DATA0                  (0UL)               /*!< DCU compare triggered by DATA0 */
N#define DCU_CMP_TRIG_DATA0_DATA1_DATA2      (DCU_CTL_COMPTRG)   /*!< DCU compare triggered by DATA0 or DATA1 or DATA2 */
N/**
N * @}
N */
N
N/**
N * @defgroup DCU_Mode DCU Mode
N * @{
N */
N#define DCU_MD_INVD                         (0UL)   /*!< DCU invalid */
N#define DCU_MD_ADD                          (1UL)   /*!< DCU add operation */
N#define DCU_MD_SUB                          (2UL)   /*!< DCU sub operation */
N#define DCU_MD_HW_ADD                       (3UL)   /*!< DCU hardware trigger add */
N#define DCU_MD_HW_SUB                       (4UL)   /*!< DCU hardware trigger sub */
N#define DCU_MD_CMP                          (5UL)   /*!< DCU compare */
N/**
N * @}
N */
N
N/**
N * @defgroup DCU_Flag DCU Flag
N * @{
N */
N#define DCU_FLAG_CARRY                      (DCU_FLAG_FLAG_OP)  /*!< DCU addition overflow or subtraction underflow flag */
N#define DCU_FLAG_DATA0_LT_DATA2             (DCU_FLAG_FLAG_LS2) /*!< DCU DATA0 < DATA2 flag */
N#define DCU_FLAG_DATA0_EQ_DATA2             (DCU_FLAG_FLAG_EQ2) /*!< DCU DATA0 = DATA2 flag */
N#define DCU_FLAG_DATA0_GT_DATA2             (DCU_FLAG_FLAG_GT2) /*!< DCU DATA0 > DATA2 flag */
N#define DCU_FLAG_DATA0_LT_DATA1             (DCU_FLAG_FLAG_LS1) /*!< DCU DATA0 < DATA1 flag */
N#define DCU_FLAG_DATA0_EQ_DATA1             (DCU_FLAG_FLAG_EQ1) /*!< DCU DATA0 = DATA1 flag */
N#define DCU_FLAG_DATA0_GT_DATA1             (DCU_FLAG_FLAG_GT1) /*!< DCU DATA0 > DATA1 flag */
N
N#define DCU_FLAG_ALL                        (0x0000007FUL)
N/**
N * @}
N */
N
N/**
N * @defgroup DCU_Category DCU Category
N * @{
N */
N#define DCU_CATEGORY_OP                     (0UL)   /*!< DCU operation result(overflow/underflow) */
N#define DCU_CATEGORY_CMP_WIN                (1UL)   /*!< DCU comparison(window) */
N#define DCU_CATEGORY_CMP_NON_WIN            (2UL)   /*!< DCU comparison(non-window) */
N/**
N * @}
N */
N
N/**
N * @defgroup DCU_Interrupt_Type DCU Interrupt Type
N * @{
N */
N/**
N * @defgroup DCU_Compare_Interrupt DCU Compare(Non-window) Interrupt
N * @note Interrupt type DCU_Compare_Interrupt is valid when only select DCU_CATEGORY_CMP_NON_WIN
N * @{
N */
N#define DCU_INT_CMP_DATA0_LT_DATA2          (DCU_INTEVTSEL_SEL_LS2)   /*!< DCU DATA0 < DATA2 interrupt */
N#define DCU_INT_CMP_DATA0_EQ_DATA2          (DCU_INTEVTSEL_SEL_EQ2)   /*!< DCU DATA0 = DATA2 interrupt */
N#define DCU_INT_CMP_DATA0_GT_DATA2          (DCU_INTEVTSEL_SEL_GT2)   /*!< DCU DATA0 > DATA2 interrupt */
N#define DCU_INT_CMP_DATA0_LT_DATA1          (DCU_INTEVTSEL_SEL_LS1)   /*!< DCU DATA0 < DATA1 interrupt */
N#define DCU_INT_CMP_DATA0_EQ_DATA1          (DCU_INTEVTSEL_SEL_EQ1)   /*!< DCU DATA0 = DATA1 interrupt */
N#define DCU_INT_CMP_DATA0_GT_DATA1          (DCU_INTEVTSEL_SEL_GT1)   /*!< DCU DATA0 > DATA1 interrupt */
N#define DCU_INT_CMP_NON_WIN_ALL             (DCU_INT_CMP_DATA0_LT_DATA2 |  \
N                                             DCU_INT_CMP_DATA0_EQ_DATA2 |  \
N                                             DCU_INT_CMP_DATA0_GT_DATA2 |  \
N                                             DCU_INT_CMP_DATA0_LT_DATA1 |  \
N                                             DCU_INT_CMP_DATA0_EQ_DATA1 |  \
N                                             DCU_INT_CMP_DATA0_GT_DATA1)
X#define DCU_INT_CMP_NON_WIN_ALL             (DCU_INT_CMP_DATA0_LT_DATA2 |                                               DCU_INT_CMP_DATA0_EQ_DATA2 |                                               DCU_INT_CMP_DATA0_GT_DATA2 |                                               DCU_INT_CMP_DATA0_LT_DATA1 |                                               DCU_INT_CMP_DATA0_EQ_DATA1 |                                               DCU_INT_CMP_DATA0_GT_DATA1)
N/**
N * @}
N */
N
N/**
N * @defgroup DCU_Window_Compare_Interrupt DCU Window Compare Interrupt
N * @note Interrupt type DCU_Window_Compare_Interrupt is valid when only select DCU_CATEGORY_CMP_WIN
N * @{
N */
N#define DCU_INT_CMP_WIN_INSIDE              (DCU_INTEVTSEL_SEL_WIN_0)  /*!< DCU comparison(DATA2 <= DATA0 <= DATA1) interrupt */
N#define DCU_INT_CMP_WIN_OUTSIDE             (DCU_INTEVTSEL_SEL_WIN_1)  /*!< DCU comparison(DATA0 < DATA2 & DATA0 > DATA1) interrupt */
N#define DCU_INT_CMP_WIN_ALL                 (DCU_INT_CMP_WIN_INSIDE | DCU_INT_CMP_WIN_OUTSIDE)
N/**
N * @}
N */
N
N/**
N * @defgroup DCU_Operation_Interrupt DCU Operation Interrupt
N * @note DCU_Window_Compare_Interrupt selection is valid when only select DCU_CATEGORY_OP
N * @{
N */
N#define DCU_INT_OP_CARRY                    (DCU_INTEVTSEL_SEL_OP) /*!< DCU addition overflow or subtraction underflow interrupt */
N/**
N * @}
N */
N
N/**
N * @}
N */
N
N/**
N * @defgroup DCU_Data_Register_Index DCU Data Register Index
N * @{
N */
N#define DCU_DATA0_IDX                       (0UL)   /*!< DCU DATA0 */
N#define DCU_DATA1_IDX                       (1UL)   /*!< DCU DATA1 */
N#define DCU_DATA2_IDX                       (2UL)   /*!< DCU DATA2 */
N/**
N * @}
N */
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global variable definitions ('extern')
N ******************************************************************************/
N
N/*******************************************************************************
N  Global function prototypes (definition in C source)
N ******************************************************************************/
N/**
N * @addtogroup DCU_Global_Functions
N * @{
N */
N
N/* Initialization and configuration functions */
Nint32_t DCU_Init(CM_DCU_TypeDef *DCUx, const stc_dcu_init_t *pstcDcuInit);
Nint32_t DCU_StructInit(stc_dcu_init_t *pstcDcuInit);
Nint32_t DCU_DeInit(CM_DCU_TypeDef *DCUx);
N
Nvoid DCU_SetMode(CM_DCU_TypeDef *DCUx, uint32_t u32Mode);
Nvoid DCU_SetDataWidth(CM_DCU_TypeDef *DCUx, uint32_t u32DataWidth);
Nvoid DCU_SetCompareCond(CM_DCU_TypeDef *DCUx, uint32_t u32Cond);
N
N/* Interrupt and flag management functions */
Nen_flag_status_t DCU_GetStatus(const CM_DCU_TypeDef *DCUx, uint32_t u32Flag);
Nvoid DCU_ClearStatus(CM_DCU_TypeDef *DCUx, uint32_t u32Flag);
Nvoid DCU_GlobalIntCmd(CM_DCU_TypeDef *DCUx, en_functional_state_t enNewState);
Nvoid DCU_IntCmd(CM_DCU_TypeDef *DCUx, uint32_t u32IntCategory, uint32_t u32IntType, en_functional_state_t enNewState);
N
N/* Read and write functions */
Nuint8_t DCU_ReadData8(const CM_DCU_TypeDef *DCUx, uint32_t u32DataIndex);
Nvoid DCU_WriteData8(CM_DCU_TypeDef *DCUx, uint32_t u32DataIndex, uint8_t u8Data);
Nuint16_t DCU_ReadData16(const CM_DCU_TypeDef *DCUx, uint32_t u32DataIndex);
Nvoid DCU_WriteData16(CM_DCU_TypeDef *DCUx, uint32_t u32DataIndex, uint16_t u16Data);
Nuint32_t DCU_ReadData32(const CM_DCU_TypeDef *DCUx, uint32_t u32DataIndex);
Nvoid DCU_WriteData32(CM_DCU_TypeDef *DCUx, uint32_t u32DataIndex, uint32_t u32Data);
N
N/**
N * @}
N */
N
N#endif /* LL_DCU_ENABLE */
N
N/**
N * @}
N */
N
N/**
N * @}
N */
N
N#ifdef __cplusplus
S}
N#endif
N
N#endif /* __HC32_LL_DCU_H__ */
