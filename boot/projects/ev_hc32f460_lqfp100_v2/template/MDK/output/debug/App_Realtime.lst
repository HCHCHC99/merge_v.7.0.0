N#define LL_OK                           (0)   /*!< No error */
N#define LL_ERR                          (-1)  /*!< Non-specific error code */
N#define LL_ERR_UNINIT                   (-2)  /*!< Module (or part of it) was not initialized properly */
N#define LL_ERR_INVD_PARAM               (-3)  /*!< Provided parameter is not valid */
N#define LL_ERR_INVD_MD                  (-4)  /*!< Operation not allowed in current mode */
N#define LL_ERR_NOT_RDY                  (-5)  /*!< A requested final state is not reached */
