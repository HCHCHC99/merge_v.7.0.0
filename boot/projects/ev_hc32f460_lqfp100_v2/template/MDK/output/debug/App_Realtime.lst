X#if (((1U)) == (1U))
N
N/*******************************************************************************
N * Global type definitions ('typedef')
N ******************************************************************************/
N/**
N * @defgroup TMRA_Global_Types TMRA Global Types
N * @{
N */
N/**
N * @brief TMRA initialization structure.
N */
Ntypedef struct {
N    uint8_t u8CountSrc;                     /*!< Specifies the count source of TMRA.
N                                                 This parameter can be a value of @ref TMRA_Count_Src */
N    struct {
N        uint8_t u8ClockDiv;                 /*!< Specifies the divider of software clock source.
N                                                 This parameter can be a value of @ref TMRA_Clock_Divider */
N        uint8_t u8CountMode;                /*!< Specifies count mode.
N                                                 This parameter can be a value of @ref TMRA_Count_Mode */
N        uint8_t u8CountDir;                 /*!< Specifies count direction.
N                                                    This parameter can be a value of @ref TMRA_Count_Dir */
N    } sw_count;
N    struct {
N        uint16_t u16CountUpCond;            /*!< Hardware count up condition.
N                                                 This parameter can be a value of @ref TMRA_Hard_Count_Up_Condition */
N        uint16_t u16CountDownCond;          /*!< Hardware count down condition.
N                                                 This parameter can be a value of @ref TMRA_Hard_Count_Down_Condition */
N    } hw_count;
N    uint32_t u32PeriodValue;                /*!< Specifies the period reference value.
N                                                 This parameter can be a number between 0U and 0xFFFFU, inclusive. */
N} stc_tmra_init_t;
N
N/**
N * @brief TMRA PWM configuration structure.
N */
Ntypedef struct {
N    uint32_t u32CompareValue;               /*!< Specifies compare value of the TMRA channel.
N                                                 This parameter can be a number between:
N                                                 0UL and 0xFFFFFFFFUL for 32-bit TimerA units.
N                                                 0UL and 0xFFFFUL for 16-bit TimerA units. */
N    uint16_t u16StartPolarity;              /*!< Specifies the polarity when the counter start counting.
N                                                 This parameter can be a value of @ref TMRA_PWM_Polarity
N                                                 NOTE: CAN NOT be specified as TMRA_PWM_LOW or TMRA_PWM_HIGH when
N                                                       sw_count.u16ClockDiv of @ref stc_tmra_init_t is NOT specified
N                                                       as @ref TMRA_CLK_DIV1 */
N    uint16_t u16StopPolarity;               /*!< Specifies the polarity when the counter stop counting.
N                                                 This parameter can be a value of @ref TMRA_PWM_Polarity */
N    uint16_t u16CompareMatchPolarity;       /*!< Specifies the polarity when the counter matches the compare register.
N                                                 This parameter can be a value of @ref TMRA_PWM_Polarity */
N    uint16_t u16PeriodMatchPolarity;        /*!< Specifies the polarity when the counter matches the period register.
N                                                 This parameter can be a value of @ref TMRA_PWM_Polarity */
N} stc_tmra_pwm_init_t;
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global pre-processor symbols/macros ('#define')
N ******************************************************************************/
N/**
N * @defgroup TMRA_Global_Macros TMRA Global Macros
N * @{
N */
N
N/**
N * @defgroup TMRA_Count_Src TMRA Count Source
N * @{
N */
N#define TMRA_CNT_SRC_SW                     (0U)                        /*!< Clock source is PCLK. */
N#define TMRA_CNT_SRC_HW                     (1U)                        /*!< Clock source is from external pin or peripheral event. */
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Channel TMRA Channel
N * @{
N */
N#define TMRA_CH1                            (0U)                        /*!< Channel 1 of TMRA. */
N#define TMRA_CH2                            (1U)                        /*!< Channel 2 of TMRA. */
N#define TMRA_CH3                            (2U)                        /*!< Channel 3 of TMRA. */
N#define TMRA_CH4                            (3U)                        /*!< Channel 4 of TMRA. */
N#define TMRA_CH5                            (4U)                        /*!< Channel 5 of TMRA. */
N#define TMRA_CH6                            (5U)                        /*!< Channel 6 of TMRA. */
N#define TMRA_CH7                            (6U)                        /*!< Channel 7 of TMRA. */
N#define TMRA_CH8                            (7U)                        /*!< Channel 8 of TMRA. */
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Count_Dir TMRA Count Direction
N * @{
N */
N#define TMRA_DIR_DOWN                       (0x0U)                      /*!< TMRA count down. */
N#define TMRA_DIR_UP                         (TMRA_BCSTRL_DIR)           /*!< TMRA count up. */
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Count_Mode TMRA Count Mode
N * @{
N */
N#define TMRA_MD_SAWTOOTH                    (0x0U)                      /*!< Count mode is sawtooth wave. */
N#define TMRA_MD_TRIANGLE                    (TMRA_BCSTRL_MODE)          /*!< Count mode is triangle wave. */
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Function_Mode TMRA TMRA Function Mode
N * @{
N */
N#define TMRA_FUNC_CMP                       (0x0U)                      /*!< Function mode of TMRA channel is output compare. */
N#define TMRA_FUNC_CAPT                      (TMRA_CCONR_CAPMD)          /*!< Function mode of TMRA channel is input capture. */
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Clock_Divider TMRA Clock Divider
N * @{
N */
N#define TMRA_CLK_DIV1                       (0x0U)                              /*!< The clock source of TMRA is PCLK. */
N#define TMRA_CLK_DIV2                       (0x1U << TMRA_BCSTRL_CKDIV_POS)     /*!< The clock source of TMRA is PCLK / 2. */
N#define TMRA_CLK_DIV4                       (0x2U << TMRA_BCSTRL_CKDIV_POS)     /*!< The clock source of TMRA is PCLK / 4. */
N#define TMRA_CLK_DIV8                       (0x3U << TMRA_BCSTRL_CKDIV_POS)     /*!< The clock source of TMRA is PCLK / 8. */
N#define TMRA_CLK_DIV16                      (0x4U << TMRA_BCSTRL_CKDIV_POS)     /*!< The clock source of TMRA is PCLK / 16. */
N#define TMRA_CLK_DIV32                      (0x5U << TMRA_BCSTRL_CKDIV_POS)     /*!< The clock source of TMRA is PCLK / 32. */
N#define TMRA_CLK_DIV64                      (0x6U << TMRA_BCSTRL_CKDIV_POS)     /*!< The clock source of TMRA is PCLK / 64. */
N#define TMRA_CLK_DIV128                     (0x7U << TMRA_BCSTRL_CKDIV_POS)     /*!< The clock source of TMRA is PCLK / 128. */
N#define TMRA_CLK_DIV256                     (0x8U << TMRA_BCSTRL_CKDIV_POS)     /*!< The clock source of TMRA is PCLK / 256. */
N#define TMRA_CLK_DIV512                     (0x9U << TMRA_BCSTRL_CKDIV_POS)     /*!< The clock source of TMRA is PCLK / 512. */
N#define TMRA_CLK_DIV1024                    (0xAU << TMRA_BCSTRL_CKDIV_POS)     /*!< The clock source of TMRA is PCLK / 1024. */
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Filter_Pin TMRA Pin With Filter
N * @{
N */
N#define TMRA_PIN_TRIG                       (0U)                        /*!< Pin TIMA_<t>_TRIG. */
N#define TMRA_PIN_CLKA                       (1U)                        /*!< Pin TIMA_<t>_CLKA. */
N#define TMRA_PIN_CLKB                       (2U)                        /*!< Pin TIMA_<t>_CLKB. */
N#define TMRA_PIN_PWM1                       (3U)                        /*!< Pin TIMA_<t>_PWM1. */
N#define TMRA_PIN_PWM2                       (4U)                        /*!< Pin TIMA_<t>_PWM2. */
N#define TMRA_PIN_PWM3                       (5U)                        /*!< Pin TIMA_<t>_PWM3. */
N#define TMRA_PIN_PWM4                       (6U)                        /*!< Pin TIMA_<t>_PWM4. */
N#define TMRA_PIN_PWM5                       (7U)                        /*!< Pin TIMA_<t>_PWM5. */
N#define TMRA_PIN_PWM6                       (8U)                        /*!< Pin TIMA_<t>_PWM6. */
N#define TMRA_PIN_PWM7                       (9U)                        /*!< Pin TIMA_<t>_PWM7. */
N#define TMRA_PIN_PWM8                       (10U)                       /*!< Pin TIMA_<t>_PWM8. */
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Hard_Count_Up_Condition TMRA Hardware Count Up Condition
N * @note Symmetric units: unit 1 and 2; unit 3 and 4; ...; unit 11 and 12.
N * @{
N */
N#define TMRA_CNT_UP_COND_INVD                        (0U)                    /*!< TMRA hardware count up condition is INVALID. */
N#define TMRA_CNT_UP_COND_CLKA_LOW_CLKB_RISING        (TMRA_HCUPR_HCUP0)      /*!< When CLKA is low, a rising edge is sampled on CLKB, the counter register counts up. */
N#define TMRA_CNT_UP_COND_CLKA_LOW_CLKB_FALLING       (TMRA_HCUPR_HCUP1)      /*!< When CLKA is low, a falling edge is sampled on CLKB, the counter register counts up. */
N#define TMRA_CNT_UP_COND_CLKA_HIGH_CLKB_RISING       (TMRA_HCUPR_HCUP2)      /*!< When CLKA is high, a rising edge is sampled on CLKB, the counter register counts up. */
N#define TMRA_CNT_UP_COND_CLKA_HIGH_CLKB_FALLING      (TMRA_HCUPR_HCUP3)      /*!< When CLKA is high, a falling edge is sampled on CLKB, the counter register counts up. */
N#define TMRA_CNT_UP_COND_CLKB_LOW_CLKA_RISING        (TMRA_HCUPR_HCUP4)      /*!< When CLKB is low, a rising edge is sampled on CLKA, the counter register counts up. */
N#define TMRA_CNT_UP_COND_CLKB_LOW_CLKA_FALLING       (TMRA_HCUPR_HCUP5)      /*!< When CLKB is low, a falling edge is sampled on CLKA, the counter register counts up. */
N#define TMRA_CNT_UP_COND_CLKB_HIGH_CLKA_RISING       (TMRA_HCUPR_HCUP6)      /*!< When CLKB is high, a rising edge is sampled on CLKA, the counter register counts up. */
N#define TMRA_CNT_UP_COND_CLKB_HIGH_CLKA_FALLING      (TMRA_HCUPR_HCUP7)      /*!< When CLKB is high, a falling edge is sampled on CLKA, the counter register counts up. */
N#define TMRA_CNT_UP_COND_TRIG_RISING                 (TMRA_HCUPR_HCUP8)      /*!< When a rising edge occurred on TRIG, the counter register counts up. */
N#define TMRA_CNT_UP_COND_TRIG_FALLING                (TMRA_HCUPR_HCUP9)      /*!< When a falling edge occurred on TRIG, the counter register counts up. */
N#define TMRA_CNT_UP_COND_EVT                         (TMRA_HCUPR_HCUP10)     /*!< When the TMRA common trigger event occurred, the counter register counts up. */
N#define TMRA_CNT_UP_COND_SYM_OVF                     (TMRA_HCUPR_HCUP11)     /*!< When the symmetric unit overflow, the counter register counts up. */
N#define TMRA_CNT_UP_COND_SYM_UDF                     (TMRA_HCUPR_HCUP12)     /*!< When the symmetric unit underflow, the counter register counts up. */
N#define TMRA_CNT_UP_COND_ALL                         (0x1FFFU)
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Hard_Count_Down_Condition TMRA Hardware Count Down Condition
N * @note Symmetric units: unit 1 and 2; unit 3 and 4; ...; unit 11 and 12.
N * @{
N */
N#define TMRA_CNT_DOWN_COND_INVD                      (0U)                    /*!< TMRA hardware count down condition is INVALID. */
N#define TMRA_CNT_DOWN_COND_CLKA_LOW_CLKB_RISING      (TMRA_HCDOR_HCDO0)      /*!< When CLKA is low, a rising edge is sampled on CLKB, the counter register counts down. */
N#define TMRA_CNT_DOWN_COND_CLKA_LOW_CLKB_FALLING     (TMRA_HCDOR_HCDO1)      /*!< When CLKA is low, a falling edge is sampled on CLKB, the counter register counts down. */
N#define TMRA_CNT_DOWN_COND_CLKA_HIGH_CLKB_RISING     (TMRA_HCDOR_HCDO2)      /*!< When CLKA is high, a rising edge is sampled on CLKB, the counter register counts down. */
N#define TMRA_CNT_DOWN_COND_CLKA_HIGH_CLKB_FALLING    (TMRA_HCDOR_HCDO3)      /*!< When CLKA is high, a falling edge is sampled on CLKB, the counter register counts down. */
N#define TMRA_CNT_DOWN_COND_CLKB_LOW_CLKA_RISING      (TMRA_HCDOR_HCDO4)      /*!< When CLKB is low, a rising edge is sampled on CLKA, the counter register counts down. */
N#define TMRA_CNT_DOWN_COND_CLKB_LOW_CLKA_FALLING     (TMRA_HCDOR_HCDO5)      /*!< When CLKB is low, a falling edge is sampled on CLKA, the counter register counts down. */
N#define TMRA_CNT_DOWN_COND_CLKB_HIGH_CLKA_RISING     (TMRA_HCDOR_HCDO6)      /*!< When CLKB is high, a rising edge is sampled on CLKA, the counter register counts down. */
N#define TMRA_CNT_DOWN_COND_CLKB_HIGH_CLKA_FALLING    (TMRA_HCDOR_HCDO7)      /*!< When CLKB is high, a falling edge is sampled on CLKA, the counter register counts down. */
N#define TMRA_CNT_DOWN_COND_TRIG_RISING               (TMRA_HCDOR_HCDO8)      /*!< When a rising edge occurred on TRIG, the counter register counts down. */
N#define TMRA_CNT_DOWN_COND_TRIG_FALLING              (TMRA_HCDOR_HCDO9)      /*!< When a falling edge occurred on TRIG, the counter register counts down. */
N#define TMRA_CNT_DOWN_COND_EVT                       (TMRA_HCDOR_HCDO10)     /*!< When the TMRA common trigger event occurred, the counter register counts down. */
N#define TMRA_CNT_DOWN_COND_SYM_OVF                   (TMRA_HCDOR_HCDO11)     /*!< When the symmetric unit overflow, the counter register counts down. */
N#define TMRA_CNT_DOWN_COND_SYM_UDF                   (TMRA_HCDOR_HCDO12)     /*!< When the symmetric unit underflow, the counter register counts down. */
N#define TMRA_CNT_DOWN_COND_ALL                       (0x1FFFU)
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Interrupt_Type TMRA Interrupt Type
N * @{
N */
N#define TMRA_INT_OVF                        (1UL << 4U)                 /*!< The interrupt of counting overflow. */
N#define TMRA_INT_UDF                        (1UL << 5U)                 /*!< The interrupt of counting underflow. */
N#define TMRA_INT_CMP_CH1                    (1UL << 16U)                /*!< The interrupt of compare-match of channel 1. */
N#define TMRA_INT_CMP_CH2                    (1UL << 17U)                /*!< The interrupt of compare-match of channel 2. */
N#define TMRA_INT_CMP_CH3                    (1UL << 18U)                /*!< The interrupt of compare-match of channel 3. */
N#define TMRA_INT_CMP_CH4                    (1UL << 19U)                /*!< The interrupt of compare-match of channel 4. */
N#define TMRA_INT_CMP_CH5                    (1UL << 20U)                /*!< The interrupt of compare-match of channel 5. */
N#define TMRA_INT_CMP_CH6                    (1UL << 21U)                /*!< The interrupt of compare-match of channel 6. */
N#define TMRA_INT_CMP_CH7                    (1UL << 22U)                /*!< The interrupt of compare-match of channel 7. */
N#define TMRA_INT_CMP_CH8                    (1UL << 23U)                /*!< The interrupt of compare-match of channel 8. */
N#define TMRA_INT_ALL                        (0xFF0030UL)
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Event_Type TMRA Event Type
N * @{
N */
N#define TMRA_EVT_CMP_CH1                    (TMRA_ECONR_ETEN1)          /*!< The event of compare-match of channel 1. */
N#define TMRA_EVT_CMP_CH2                    (TMRA_ECONR_ETEN2)          /*!< The event of compare-match of channel 2. */
N#define TMRA_EVT_CMP_CH3                    (TMRA_ECONR_ETEN3)          /*!< The event of compare-match of channel 3. */
N#define TMRA_EVT_CMP_CH4                    (TMRA_ECONR_ETEN4)          /*!< The event of compare-match of channel 4. */
N#define TMRA_EVT_CMP_CH5                    (TMRA_ECONR_ETEN5)          /*!< The event of compare-match of channel 5. */
N#define TMRA_EVT_CMP_CH6                    (TMRA_ECONR_ETEN6)          /*!< The event of compare-match of channel 6. */
N#define TMRA_EVT_CMP_CH7                    (TMRA_ECONR_ETEN7)          /*!< The event of compare-match of channel 7. */
N#define TMRA_EVT_CMP_CH8                    (TMRA_ECONR_ETEN8)          /*!< The event of compare-match of channel 8. */
N#define TMRA_EVT_ALL                        (TMRA_EVT_CMP_CH1 | TMRA_EVT_CMP_CH2 | TMRA_EVT_CMP_CH3 | \
N                                             TMRA_EVT_CMP_CH4 | TMRA_EVT_CMP_CH5 | TMRA_EVT_CMP_CH6 | \
N                                             TMRA_EVT_CMP_CH7 | TMRA_EVT_CMP_CH8)
X#define TMRA_EVT_ALL                        (TMRA_EVT_CMP_CH1 | TMRA_EVT_CMP_CH2 | TMRA_EVT_CMP_CH3 |                                              TMRA_EVT_CMP_CH4 | TMRA_EVT_CMP_CH5 | TMRA_EVT_CMP_CH6 |                                              TMRA_EVT_CMP_CH7 | TMRA_EVT_CMP_CH8)
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Status_Flag TMRA Status Flag
N * @{
N */
N#define TMRA_FLAG_OVF                       (1UL << 6U)                 /*!< The flag of counting overflow. */
N#define TMRA_FLAG_UDF                       (1UL << 7U)                 /*!< The flag of counting underflow. */
N#define TMRA_FLAG_CMP_CH1                   (1UL << 16U)                /*!< The flag of compare-match of channel 1. */
N#define TMRA_FLAG_CMP_CH2                   (1UL << 17U)                /*!< The flag of compare-match of channel 2. */
N#define TMRA_FLAG_CMP_CH3                   (1UL << 18U)                /*!< The flag of compare-match of channel 3. */
N#define TMRA_FLAG_CMP_CH4                   (1UL << 19U)                /*!< The flag of compare-match of channel 4. */
N#define TMRA_FLAG_CMP_CH5                   (1UL << 20U)                /*!< The flag of compare-match of channel 5. */
N#define TMRA_FLAG_CMP_CH6                   (1UL << 21U)                /*!< The flag of compare-match of channel 6. */
N#define TMRA_FLAG_CMP_CH7                   (1UL << 22U)                /*!< The flag of compare-match of channel 7. */
N#define TMRA_FLAG_CMP_CH8                   (1UL << 23U)                /*!< The flag of compare-match of channel 8. */
N#define TMRA_FLAG_ALL                       (0xFF00C0UL)
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Capture_Cond TMRA Capture Condition
N * @note 'TMRA_CAPT_COND_TRIG_RISING' and 'TMRA_CAPT_COND_TRIG_FALLING' are only valid for channel 4.
N * @{
N */
N#define TMRA_CAPT_COND_INVD                 (0x0U)                      /*!< The condition of capture is INVALID. */
N#define TMRA_CAPT_COND_PWM_RISING           (TMRA_CCONR_HICP0)          /*!< The condition of capture is a rising edge is sampled on pin TIMA_<t>_PWMn. */
N#define TMRA_CAPT_COND_PWM_FALLING          (TMRA_CCONR_HICP1)          /*!< The condition of capture is a falling edge is sampled on pin TIMA_<t>_PWMn. */
N#define TMRA_CAPT_COND_EVT                  (TMRA_CCONR_HICP2)          /*!< The condition of capture is the specified event occurred. */
N#define TMRA_CAPT_COND_TRIG_RISING          (TMRA_CCONR_HICP3)          /*!< The condition of capture is a rising edge is sampled on pin TIMA_<t>_TRIG.
N                                                                            This condition is only valid for channel 4. */
N#define TMRA_CAPT_COND_TRIG_FALLING         (TMRA_CCONR_HICP4)          /*!< The condition of capture is a falling edge is sampled on pin TIMA_<t>_TRIG.
N                                                                            This condition is only valid for channel 4. */
N#define TMRA_CAPT_COND_ALL                  (TMRA_CAPT_COND_PWM_RISING | TMRA_CAPT_COND_PWM_FALLING | \
N                                             TMRA_CAPT_COND_EVT | TMRA_CAPT_COND_TRIG_RISING | \
N                                             TMRA_CAPT_COND_TRIG_FALLING)
X#define TMRA_CAPT_COND_ALL                  (TMRA_CAPT_COND_PWM_RISING | TMRA_CAPT_COND_PWM_FALLING |                                              TMRA_CAPT_COND_EVT | TMRA_CAPT_COND_TRIG_RISING |                                              TMRA_CAPT_COND_TRIG_FALLING)
N
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Cmp_Value_Buf_Trans_Cond TMRA Compare Value Buffer Transmission Condition
N * @{
N */
N#define TMRA_BUF_TRANS_COND_OVF_UDF_CLR     (0x0U)                      /*!< This configuration value applies to non-triangular wave counting mode.
N                                                                             When counting overflow or underflow or counting register was cleared,
N                                                                             transfer CMPARm(m=2,4,6,8,...) to CMPARn(n=1,3,5,7,...). */
N#define TMRA_BUF_TRANS_COND_PEAK            (TMRA_BCONR_BSE0)           /*!< In triangle wave count mode, when count reached peak,
N                                                                             transfer CMPARm(m=2,4,6,8,...) to CMPARn(n=1,3,5,7,...). */
N#define TMRA_BUF_TRANS_COND_VALLEY          (TMRA_BCONR_BSE1)           /*!< In triangle wave count mode, when count reached valley,
N                                                                             transfer CMPARm(m=2,4,6,8,...) to CMPARn(n=1,3,5,7,.... */
N#define TMRA_BUF_TRANS_COND_PEAK_VALLEY     (TMRA_BCONR_BSE1 | \
N                                             TMRA_BCONR_BSE0)           /*!< In triangle wave count mode, when count reached peak or valley,
N                                                                             transfer CMPARm(m=2,4,6,8,...) to CMPARn(n=1,3,5,7,...). */
X#define TMRA_BUF_TRANS_COND_PEAK_VALLEY     (TMRA_BCONR_BSE1 |                                              TMRA_BCONR_BSE0)            
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Filter_Clock_Divider TMRA Filter Clock Divider
N * @{
N */
N#define TMRA_FILTER_CLK_DIV1                (0x0U)                      /*!< The filter clock is the clock of TimerA / 1 */
N#define TMRA_FILTER_CLK_DIV4                (0x1U)                      /*!< The filter clock is the clock of TimerA / 4 */
N#define TMRA_FILTER_CLK_DIV16               (0x2U)                      /*!< The filter clock is the clock of TimerA / 16 */
N#define TMRA_FILTER_CLK_DIV64               (0x3U)                      /*!< The filter clock is the clock of TimerA / 64 */
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Counter_State TMRA Counter State
N * @{
N */
N#define TMRA_CNT_STAT_START                 (0U)                        /*!< Counter start counting. */
N#define TMRA_CNT_STAT_STOP                  (1U)                        /*!< Counter stop counting. */
N#define TMRA_CNT_STAT_MATCH_CMP             (2U)                        /*!< Counter value matches the compare value. */
N#define TMRA_CNT_STAT_MATCH_PERIOD          (3U)                        /*!< Counter value matches the period value. */
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_PWM_Polarity TMRA PWM Polarity
N * @{
N */
N#define TMRA_PWM_LOW                        (0x0U)                      /*!< PWM output low. */
N#define TMRA_PWM_HIGH                       (0x1U)                      /*!< PWM output high. */
N#define TMRA_PWM_HOLD                       (0x2U)                      /*!< PWM output holds the current polarity. */
N#define TMRA_PWM_INVT                       (0x3U)                      /*!< PWM output reverses the current polarity. */
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_PWM_Force_Polarity TMRA PWM Force Polarity
N * @{
N */
N#define TMRA_PWM_FORCE_INVD                 (0x0U)                      /*!< Force polarity is invalid. */
N#define TMRA_PWM_FORCE_LOW                  (TMRA_PCONR_FORC_1)         /*!< Force the PWM output low at the beginning of the next cycle.
N                                                                             The beginning of the next cycle: overflow position or underflow position
N                                                                             of sawtooth wave; valley position of triangle wave. */
N#define TMRA_PWM_FORCE_HIGH                 (TMRA_PCONR_FORC)           /*!< Force the PWM output high at the beginning of the next cycle.
N                                                                             The beginning of the next cycle: overflow position or underflow position
N                                                                             of sawtooth wave; valley position of triangle wave. */
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Hardware_Start_Condition TMRA Hardware Start Condition
N * @{
N */
N#define TMRA_START_COND_INVD                (0x0U)                      /*!< The condition of start is INVALID. */
N#define TMRA_START_COND_TRIG_RISING         (TMRA_HCONR_HSTA0)          /*!< 1. Sync start is invalid: The condition is that a rising edge is sampled on TRIG of the current TMRA unit.
N                                                                             2. Sync start is valid: The condition is that a rising edge is sampled on TRIG of the symmetric TMRA unit. */
N#define TMRA_START_COND_TRIG_FALLING        (TMRA_HCONR_HSTA1)          /*!< 1. Sync start is invalid: The condition is that a falling edge is sampled on TRIG of the current TMRA unit.
N                                                                             2. Sync start is valid: The condition is that a falling edge is sampled on TRIG of the symmetric TMRA unit. */
N#define TMRA_START_COND_EVT                 (TMRA_HCONR_HSTA2)          /*!< The condition is that the TMRA common trigger event has occurred. */
N#define TMRA_START_COND_ALL                 (TMRA_START_COND_TRIG_RISING | TMRA_START_COND_TRIG_FALLING | \
N                                             TMRA_START_COND_EVT)
X#define TMRA_START_COND_ALL                 (TMRA_START_COND_TRIG_RISING | TMRA_START_COND_TRIG_FALLING |                                              TMRA_START_COND_EVT)
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Hardware_Stop_Condition TMRA Hardware Stop Condition
N * @{
N */
N#define TMRA_STOP_COND_INVD                 (0x0U)                      /*!< The condition of stop is INVALID. */
N#define TMRA_STOP_COND_TRIG_RISING          (TMRA_HCONR_HSTP0)          /*!< The condition is that a rising edge is sampled on pin TRIG of the current TMRA unit. */
N#define TMRA_STOP_COND_TRIG_FALLING         (TMRA_HCONR_HSTP1)          /*!< The condition is that a falling edge is sampled on pin TRIG of the current TMRA unit. */
N#define TMRA_STOP_COND_EVT                  (TMRA_HCONR_HSTP2)          /*!< The condition is that the TMRA common trigger event has occurred. */
N#define TMRA_STOP_COND_ALL                  (TMRA_STOP_COND_TRIG_RISING | TMRA_STOP_COND_TRIG_FALLING | \
N                                             TMRA_STOP_COND_EVT)
X#define TMRA_STOP_COND_ALL                  (TMRA_STOP_COND_TRIG_RISING | TMRA_STOP_COND_TRIG_FALLING |                                              TMRA_STOP_COND_EVT)
N/**
N * @}
N */
N
N/**
N * @defgroup TMRA_Hardware_Clear_Condition TMRA Hardware Clear Condition
N * @note Symmetric units: unit 1 and 2; unit 3 and 4; ... ; unit 11 and 12.
N * @{
N */
N#define TMRA_CLR_COND_INVD                  (0x0U)                      /*!< The condition of clear is INVALID. */
N#define TMRA_CLR_COND_TRIG_RISING           (TMRA_HCONR_HCLE0)          /*!< The condition is that a rising edge is sampled on TRIG of the current TMRA unit. */
N#define TMRA_CLR_COND_TRIG_FALLING          (TMRA_HCONR_HCLE1)          /*!< The condition is that a falling edge is sampled on TRIG of the current TMRA unit. */
N#define TMRA_CLR_COND_EVT                   (TMRA_HCONR_HCLE2)          /*!< The condition is that the TMRA common trigger event has occurred. */
N#define TMRA_CLR_COND_SYM_TRIG_RISING       (TMRA_HCONR_HCLE3)          /*!< The condition is that a rising edge is sampled on TRIG of the symmetric unit. */
N#define TMRA_CLR_COND_SYM_TRIG_FALLING      (TMRA_HCONR_HCLE4)          /*!< The condition is that a falling edge is sampled on TRIG of the symmetric unit. */
N#define TMRA_CLR_COND_PWM3_RISING           (TMRA_HCONR_HCLE5)          /*!< The condition is that a rising edge is sampled on PWM3 of the current TMRA unit. */
N#define TMRA_CLR_COND_PWM3_FALLING          (TMRA_HCONR_HCLE6)          /*!< The condition is that a falling edge is sampled on PWM3 of the current TMRA unit. */
N#define TMRA_CLR_COND_ALL                   (TMRA_CLR_COND_TRIG_RISING | TMRA_CLR_COND_TRIG_FALLING | \
N                                             TMRA_CLR_COND_EVT| TMRA_CLR_COND_SYM_TRIG_RISING | \
N                                             TMRA_CLR_COND_SYM_TRIG_FALLING | TMRA_CLR_COND_PWM3_RISING| \
N                                             TMRA_CLR_COND_PWM3_FALLING)
X#define TMRA_CLR_COND_ALL                   (TMRA_CLR_COND_TRIG_RISING | TMRA_CLR_COND_TRIG_FALLING |                                              TMRA_CLR_COND_EVT| TMRA_CLR_COND_SYM_TRIG_RISING |                                              TMRA_CLR_COND_SYM_TRIG_FALLING | TMRA_CLR_COND_PWM3_RISING|                                              TMRA_CLR_COND_PWM3_FALLING)
N/**
N * @}
N */
N
N/**
N * @}
N */
N
N/*******************************************************************************
N * Global variable definitions ('extern')
N ******************************************************************************/
N
N/*******************************************************************************
N  Global function prototypes (definition in C source)
N ******************************************************************************/
N/**
N * @addtogroup TMRA_Global_Functions
N * @{
N */
N/* Base count(use software clock PCLK/HCLK) */
Nint32_t TMRA_Init(CM_TMRA_TypeDef *TMRAx, const stc_tmra_init_t *pstcTmraInit);
Nint32_t TMRA_StructInit(stc_tmra_init_t *pstcTmraInit);
Nvoid TMRA_SetCountMode(CM_TMRA_TypeDef *TMRAx, uint8_t u8Mode);
Nvoid TMRA_SetCountDir(CM_TMRA_TypeDef *TMRAx, uint8_t u8Dir);
Nvoid TMRA_SetClockDiv(CM_TMRA_TypeDef *TMRAx, uint8_t u8Div);
N
N/* Hardware count */
Nvoid TMRA_HWCountUpCondCmd(CM_TMRA_TypeDef *TMRAx, uint16_t u16Cond, en_functional_state_t enNewState);
Nvoid TMRA_HWCountDownCondCmd(CM_TMRA_TypeDef *TMRAx, uint16_t u16Cond, en_functional_state_t enNewState);
N/* Set function mode */
Nvoid TMRA_SetFunc(CM_TMRA_TypeDef *TMRAx, uint32_t u32Ch, uint16_t u16Func);
N
N/* Output compare */
Nint32_t TMRA_PWM_Init(CM_TMRA_TypeDef *TMRAx, uint32_t u32Ch, const stc_tmra_pwm_init_t *pstcPwmInit);
Nint32_t TMRA_PWM_StructInit(stc_tmra_pwm_init_t *pstcPwmInit);
Nvoid TMRA_PWM_OutputCmd(CM_TMRA_TypeDef *TMRAx, uint32_t u32Ch, en_functional_state_t enNewState);
Nvoid TMRA_PWM_SetPolarity(CM_TMRA_TypeDef *TMRAx, uint32_t u32Ch, uint8_t u8CountState, uint16_t u16Polarity);
Nvoid TMRA_PWM_SetForcePolarity(CM_TMRA_TypeDef *TMRAx, uint32_t u32Ch, uint16_t u16Polarity);
N/* Input capture */
Nvoid TMRA_HWCaptureCondCmd(CM_TMRA_TypeDef *TMRAx, uint32_t u32Ch, uint16_t u16Cond, en_functional_state_t enNewState);
N
N/* Trigger: hardware trigger to start/stop/clear the counter */
Nvoid TMRA_HWStartCondCmd(CM_TMRA_TypeDef *TMRAx, uint16_t u16Cond, en_functional_state_t enNewState);
Nvoid TMRA_HWStopCondCmd(CM_TMRA_TypeDef *TMRAx, uint16_t u16Cond, en_functional_state_t enNewState);
Nvoid TMRA_HWClearCondCmd(CM_TMRA_TypeDef *TMRAx, uint16_t u16Cond, en_functional_state_t enNewState);
N
N/* Filter */
Nvoid TMRA_SetFilterClockDiv(CM_TMRA_TypeDef *TMRAx, uint32_t u32Pin, uint16_t u16Div);
Nvoid TMRA_FilterCmd(CM_TMRA_TypeDef *TMRAx, uint32_t u32Pin, en_functional_state_t enNewState);
N
N/* Global */
Nint32_t TMRA_DeInit(CM_TMRA_TypeDef *TMRAx);
N/* Counting direction, period value, counter value, compare value */
Nuint8_t TMRA_GetCountDir(const CM_TMRA_TypeDef *TMRAx);
N
Nvoid TMRA_SetPeriodValue(CM_TMRA_TypeDef *TMRAx, uint32_t u32Value);
Nuint32_t TMRA_GetPeriodValue(const CM_TMRA_TypeDef *TMRAx);
Nvoid TMRA_SetCountValue(CM_TMRA_TypeDef *TMRAx, uint32_t u32Value);
Nuint32_t TMRA_GetCountValue(const CM_TMRA_TypeDef *TMRAx);
Nvoid TMRA_SetCompareValue(CM_TMRA_TypeDef *TMRAx, uint32_t u32Ch, uint32_t u32Value);
Nuint32_t TMRA_GetCompareValue(const CM_TMRA_TypeDef *TMRAx, uint32_t u32Ch);
N
N/* Sync start */
Nvoid TMRA_SyncStartCmd(CM_TMRA_TypeDef *TMRAx, en_functional_state_t enNewState);
N
Nvoid TMRA_SetCompareBufCond(CM_TMRA_TypeDef *TMRAx, uint32_t u32Ch, uint16_t u16Cond);
Nvoid TMRA_CompareBufCmd(CM_TMRA_TypeDef *TMRAx, uint32_t u32Ch, en_functional_state_t enNewState);
N
Nen_flag_status_t TMRA_GetStatus(const CM_TMRA_TypeDef *TMRAx, uint32_t u32Flag);
Nvoid TMRA_ClearStatus(CM_TMRA_TypeDef *TMRAx, uint32_t u32Flag);
Nvoid TMRA_IntCmd(CM_TMRA_TypeDef *TMRAx, uint32_t u32IntType, en_functional_state_t enNewState);
Nvoid TMRA_EventCmd(CM_TMRA_TypeDef *TMRAx, uint32_t u32EventType, en_functional_state_t enNewState);
Nvoid TMRA_Start(CM_TMRA_TypeDef *TMRAx);
Nvoid TMRA_Stop(CM_TMRA_TypeDef *TMRAx);
N
N/**
N * @}
N */
N
N#endif /* LL_TMRA_ENABLE */
N
N/**
N * @}
N */
N
N/**
N * @}
N */
N
N#ifdef __cplusplus
S}
N#endif
N
