Nint32_t I2S_Receive(const CM_I2S_TypeDef *I2Sx, void *pvRxBuf, uint32_t u32Len, uint32_t u32Timeout);
Nint32_t I2S_TransReceive(CM_I2S_TypeDef *I2Sx, const void *pvTxBuf,
N                         void *pvRxBuf, uint32_t u32Len, uint32_t u32Timeout);
N
N/* Interrupt and flag management functions */
Nvoid I2S_IntCmd(CM_I2S_TypeDef *I2Sx, uint32_t u32IntType, en_functional_state_t enNewState);
Nen_flag_status_t I2S_GetStatus(const CM_I2S_TypeDef *I2Sx, uint32_t u32Flag);
Nvoid I2S_ClearStatus(CM_I2S_TypeDef *I2Sx, uint32_t u32Flag);
