N */
N#define FCM_TARGET_CLK_XTAL         (0x00UL << FCM_MCCR_MCKS_POS)
N#define FCM_TARGET_CLK_XTAL32       (0x01UL << FCM_MCCR_MCKS_POS)
N#define FCM_TARGET_CLK_HRC          (0x02UL << FCM_MCCR_MCKS_POS)
N#define FCM_TARGET_CLK_LRC          (0x03UL << FCM_MCCR_MCKS_POS)
N#define FCM_TARGET_CLK_SWDTLRC      (0x04UL << FCM_MCCR_MCKS_POS)
N#define FCM_TARGET_CLK_PCLK1        (0x05UL << FCM_MCCR_MCKS_POS)
N#define FCM_TARGET_CLK_UPLLP        (0x06UL << FCM_MCCR_MCKS_POS)
N#define FCM_TARGET_CLK_MRC          (0x07UL << FCM_MCCR_MCKS_POS)
N#define FCM_TARGET_CLK_MPLLP        (0x08UL << FCM_MCCR_MCKS_POS)
N
N/**
N * @}
N */
N
