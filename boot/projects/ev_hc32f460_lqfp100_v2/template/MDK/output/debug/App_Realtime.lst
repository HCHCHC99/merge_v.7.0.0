N/**
N * @defgroup Extend_Macros Extend Macros
N * @{
N */
N/* Decimal to BCD */
N#define DEC2BCD(x)                      ((((x) / 10U) << 4U) + ((x) % 10U))
N
N/* BCD to decimal */
N#define BCD2DEC(x)                      ((((x) >> 4U) * 10U) + ((x) & 0x0FU))
N
N/* Returns the dimension of an array */
N#define ARRAY_SZ(x)                     ((sizeof(x)) / (sizeof((x)[0])))
N
N/* Returns the minimum value out of two values */
N#define LL_MIN(x, y)                    ((x) < (y) ? (x) : (y))
N
N/* Returns the maximum value out of two values */
N#define LL_MAX(x, y)                    ((x) > (y) ? (x) : (y))
N/**
N * @}
N */
N
N/**
N * @defgroup Check_Parameters_Validity Check Parameters Validity
N * @{
