N/**
N * @brief  Write data in direct communication mode.
N * @param  [in] u8Value                 Byte data.
N * @retval None
N */
N__STATIC_INLINE void QSPI_WriteDirectCommValue(uint8_t u8Value)
Xstatic __inline void QSPI_WriteDirectCommValue(uint8_t u8Value)
N{
N    WRITE_REG32(CM_QSPI->DCOM, u8Value);
X    ((((CM_QSPI_TypeDef *)(0x9C000000UL))->DCOM) = ((uint32_t)(u8Value)));
N}
N
N/**
N * @brief  Read data in direct communication mode.
N * @param  None
N * @retval uint8_t                      Byte data.
N */
N__STATIC_INLINE uint8_t QSPI_ReadDirectCommValue(void)
Xstatic __inline uint8_t QSPI_ReadDirectCommValue(void)
N{
N    return (uint8_t)CM_QSPI->DCOM;
X    return (uint8_t)((CM_QSPI_TypeDef *)(0x9C000000UL))->DCOM;
N}
N
