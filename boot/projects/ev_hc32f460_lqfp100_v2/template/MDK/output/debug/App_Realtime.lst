N ******************************************************************************/
N/**
N * @addtogroup CRC_Global_Functions
N * @{
N */
Nint32_t CRC_StructInit(stc_crc_init_t *pstcCrcInit);
Nint32_t CRC_Init(const stc_crc_init_t *pstcCrcInit);
Nint32_t CRC_DeInit(void);
N
Nuint32_t CRC_GetResult(void);
Nvoid CRC_SetInitValue(uint32_t u32Value);
N
Nen_flag_status_t CRC_GetResultStatus(void);
N
Nint32_t CRC_CRC16_AccumulateData(uint8_t u8DataWidth, const void *pvData, uint32_t u32Len, uint16_t *pu16Out);
Nint32_t CRC_CRC16_Calculate(uint16_t u16InitValue, uint8_t u8DataWidth, const void *pvData, uint32_t u32Len, uint16_t *pu16Out);
Nen_flag_status_t CRC_CRC16_CheckData(uint16_t u16InitValue, uint8_t u8DataWidth, const void *pvData, uint32_t u32Len, uint16_t u16ExpectValue);
Nen_flag_status_t CRC_CRC16_GetCheckResult(uint16_t u16ExpectValue);
N
Nint32_t CRC_CRC32_AccumulateData(uint8_t u8DataWidth, const void *pvData, uint32_t u32Len, uint32_t *pu32Out);
Nint32_t CRC_CRC32_Calculate(uint32_t u32InitValue, uint8_t u8DataWidth, const void *pvData, uint32_t u32Len, uint32_t *pu32Out);
Nen_flag_status_t CRC_CRC32_CheckData(uint32_t u32InitValue, uint8_t u8DataWidth, const void *pvData, uint32_t u32Len, uint32_t u32ExpectValue);
Nen_flag_status_t CRC_CRC32_GetCheckResult(uint32_t u32ExpectValue);
N
N/**
N * @}
N */
N
N#endif /* LL_CRC_ENABLE */
N
N/**
N * @}
N */
N
N/**
N * @}
N */
