N
N/**
N * @brief EMB monitor OSC failure configuration
N */
Ntypedef struct {
N    uint32_t u32OscState;           /*!< Enable or disable EMB detect OSC failure function
N                                         This parameter can be a value of @ref EMB_OSC_Selection */
N} stc_emb_monitor_osc_t;
N
N/**
N * @brief EMB monitor EMB port configuration
N */
Ntypedef struct {
N    uint32_t u32PortState;          /*!< Enable or disable EMB detect port in control function
N                                         This parameter can be a value of @ref EMB_Port_Selection */
N    uint32_t u32PortLevel;          /*!< EMB detect port level
N                                         This parameter can be a value of @ref EMB_Detect_Port_Level */
N    uint32_t u32PortFilterDiv;      /*!< EMB port filter division
N                                         This parameter can be a value of @ref EMB_Port_Filter_Clock_Division */
N    uint32_t u32PortFilterState;    /*!< Enable or disable EMB detect port filter in control function
N                                         This parameter can be a value of @ref EMB_Port_Filter_Selection */
N} stc_emb_monitor_port_config_t;
N
N/**
N * @brief EMB monitor PWM configuration
N */
Ntypedef struct {
N    uint32_t u32PwmState;   /*!< Enable or disable EMB detect timer same phase function
N                                 This parameter can be a value of @ref EMB_Detect_PWM state. */
N    uint32_t u32PwmLevel;   /*!< Detect timer polarity level
N                                 This parameter can be a value of @ref EMB_Detect_PWM level */
N} stc_emb_monitor_tmr_pwm_t;
N
N/**
N * @brief EMB monitor port in configuration
N */
Ntypedef struct {
N    stc_emb_monitor_port_config_t stcPort1; /*!< EMB detect EMB port in function
N                                                 This parameter details refer @ref stc_emb_monitor_port_config_t structure */
N} stc_emb_monitor_port_t;
N
N/**
N * @brief EMB monitor CMP configuration
N */
Ntypedef struct {
N    uint32_t u32Cmp1State;                  /*!< Enable or disable EMB detect CMP1 result function
N                                                 This parameter can be a value of @ref EMB_CMP_Selection */
N    uint32_t u32Cmp2State;                  /*!< Enable or disable EMB detect CMP2 result function
N                                                 This parameter can be a value of @ref EMB_CMP_Selection */
N    uint32_t u32Cmp3State;                  /*!< Enable or disable EMB detect CMP3 result function
N                                                 This parameter can be a value of @ref EMB_CMP_Selection */
N} stc_emb_monitor_cmp_t;
N
N/**
N * @brief EMB monitor TMR4 configuration
N */
Ntypedef struct {
N    stc_emb_monitor_tmr_pwm_t stcTmr4PwmU;  /*!< EMB detect TMR4 function
N                                                 This parameter details refer @ref stc_emb_monitor_tmr_pwm_t structure */
N    stc_emb_monitor_tmr_pwm_t stcTmr4PwmV;  /*!< EMB detect TMR4 function
N                                                 This parameter details refer @ref stc_emb_monitor_tmr_pwm_t structure */
